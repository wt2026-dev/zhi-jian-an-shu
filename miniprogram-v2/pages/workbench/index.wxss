/* pages/workbench/index.wxss */

.capsule-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.capsule-card {
  padding: 20rpx 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.chip-badge {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 700;
  display: inline-block;
}

.my-xs {
  margin-top: 8rpx;
  margin-bottom: 8rpx;
}

/* 严重紧急告警横幅 */
.urgent-banner {
  padding: 28rpx 24rpx;
  border: 1rpx solid rgba(239, 68, 68, 0.25);
  box-shadow: 0 8rpx 28rpx -4rpx rgba(239, 68, 68, 0.15);
}

.urgent-left-stripe {
  position: absolute;
  top: 0;
  left: 0;
  bottom: 0;
  width: 8rpx;
  background: linear-gradient(180deg, #ef4444 0%, #e8a33d 100%);
}

.urgent-header {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.urgent-icon-box {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: #ffdad6;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.urgent-icon-txt {
  font-size: 30rpx;
}

/* 核心模块卡片 */
.section-card {
  padding: 28rpx 24rpx;
}

.module-icon-box {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.bg-gold-subtle {
  background: rgba(232, 163, 61, 0.16);
}

.bg-cyan-subtle {
  background: rgba(41, 193, 223, 0.16);
}

.bg-emerald-subtle {
  background: rgba(16, 185, 129, 0.16);
}

.icon-sym {
  font-size: 32rpx;
}

.icon-sub {
  font-size: 28rpx;
}

/* 2x2 网格与微型统计 */
.grid-2x2 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.grid-2col {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.micro-stats-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.p-sm {
  padding: 16rpx;
}

.p-xs {
  padding: 10rpx;
}

.px-sm {
  padding-left: 16rpx;
  padding-right: 16rpx;
}

.py-xs {
  padding-top: 12rpx;
  padding-bottom: 12rpx;
}

.ml-xs {
  margin-left: 8rpx;
}

/* 快捷热词标签 */
.quick-tag {
  background: rgba(234, 237, 255, 0.8);
  border: 1rpx solid rgba(218, 226, 253, 0.9);
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  color: var(--on-surface-variant);
  transition: all 0.2s ease;
}

.quick-tag:active {
  background: var(--primary-fixed);
  color: var(--on-primary-fixed);
}

.fab-pulse-dot {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #29c1df;
  border: 3rpx solid #ffffff;
}
