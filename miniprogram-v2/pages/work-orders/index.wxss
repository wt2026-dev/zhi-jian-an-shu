/* pages/work-orders/index.wxss */

.search-card {
  padding: 12rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-icon {
  font-size: 32rpx;
}

.search-input {
  flex: 1;
  color: var(--on-surface);
}

.search-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.search-btn-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: var(--surface-container-low);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

/* 分类滚动 Tab */
.tab-scroll-container {
  width: 100%;
  white-space: nowrap;
}

.tab-scroll-content {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 0;
}

.triage-tab {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.triage-tab-idle {
  background: rgba(255, 255, 255, 0.85);
  color: var(--on-surface-variant);
  border: 1rpx solid rgba(218, 226, 253, 0.8);
}

.triage-tab-active-dark {
  background: #131b2e;
  color: #ffffff;
}

.triage-tab-active-gold {
  background: rgba(255, 255, 255, 0.95);
  color: var(--primary);
  border: 1rpx solid rgba(232, 163, 61, 0.5);
  box-shadow: 0 4rpx 14rpx rgba(232, 163, 61, 0.2);
}

.triage-tab-active-cyan {
  background: rgba(255, 255, 255, 0.95);
  color: var(--secondary);
  border: 1rpx solid rgba(14, 165, 233, 0.5);
  box-shadow: 0 4rpx 14rpx rgba(14, 165, 233, 0.15);
}

.tab-count {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(226, 231, 255, 0.8);
  color: var(--on-surface-variant);
}

.tab-count-active {
  background: rgba(255, 255, 255, 0.25);
  color: #ffffff;
}

.tab-count-urgent {
  background: rgba(255, 218, 214, 0.9);
  color: #ba1a1a;
}

/* 应急卡片 */
.spotlight-card {
  padding: 28rpx 24rpx;
}

.border-b-subtle {
  border-bottom: 1rpx solid rgba(232, 163, 61, 0.18);
}

.my-xs {
  margin-top: 10rpx;
  margin-bottom: 10rpx;
}

/* 工单列表单项卡片 */
.order-item-card {
  padding: 24rpx;
  transition: transform 0.15s ease;
}

.order-item-card:active {
  transform: scale(0.99);
}

.order-footer {
  border-top: 1rpx dashed rgba(214, 196, 176, 0.4);
  margin-top: 12rpx;
}

.chip-badge {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 700;
  display: inline-block;
}

.chip-blue {
  background: rgba(14, 165, 233, 0.12);
  color: #0284c7;
  border: 1rpx solid rgba(14, 165, 233, 0.3);
}

.chip-cyan {
  background: rgba(41, 193, 223, 0.14);
  color: #00768c;
  border: 1rpx solid rgba(41, 193, 223, 0.35);
}

.chip-gold {
  background: rgba(232, 163, 61, 0.15);
  color: #b45309;
  border: 1rpx solid rgba(232, 163, 61, 0.35);
}

.chip-critical {
  background: #ffdad6;
  color: #ba1a1a;
  border: 1rpx solid rgba(186, 26, 26, 0.3);
}

.chip-muted {
  background: rgba(226, 232, 240, 0.7);
  color: #64748b;
  border: 1rpx solid rgba(203, 213, 225, 0.8);
}

.p-md {
  padding: 24rpx;
}

.fab-create {
  position: fixed;
  right: 32rpx;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  width: 108rpx;
  height: 108rpx;
  border-radius: 54rpx;
  background: linear-gradient(135deg, #e8a33d 0%, #ffb956 55%, #29c1df 100%);
  box-shadow: 0 10rpx 28rpx rgba(232, 163, 61, 0.42), 0 0 16rpx rgba(41, 193, 223, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}

.fab-create:active {
  transform: scale(0.92);
}

.fab-create-icon {
  font-size: 52rpx;
  font-weight: 700;
  color: #131b2e;
  line-height: 1;
}
