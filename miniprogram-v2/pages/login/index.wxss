/* pages/login/index.wxss */
.login-scroll {
  position: relative;
  z-index: 2;
  height: 100vh;
}

.login-wrap {
  min-height: 100vh;
  padding-top: 90rpx;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

.login-brand {
  text-align: center;
  margin-bottom: 36rpx;
}

.brand-mark {
  width: 108rpx;
  height: 108rpx;
  margin: 0 auto 20rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #e8a33d 0%, #29c1df 100%);
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 40rpx rgba(232, 163, 61, 0.28);
}

.brand-title {
  font-size: 46rpx;
  font-weight: 800;
  color: var(--on-surface);
  letter-spacing: 4rpx;
}

.brand-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--on-surface-variant);
}

.login-card {
  padding: 36rpx 30rpx;
}

.login-field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.login-input {
  height: 84rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(218, 226, 253, 0.95);
  color: var(--on-surface);
}

.login-error {
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: rgba(239, 68, 68, 0.1);
  border: 1rpx solid rgba(239, 68, 68, 0.35);
  color: #ba1a1a;
}

.login-submit,
.login-wx {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-demo {
  padding: 26rpx 24rpx;
}

.demo-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.demo-chip {
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(218, 226, 253, 0.9);
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.demo-chip:active {
  background: var(--primary-fixed);
}

.demo-chip-label {
  font-size: 20rpx;
  line-height: 1.35;
}
