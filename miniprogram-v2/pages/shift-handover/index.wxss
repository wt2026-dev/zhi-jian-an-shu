/* pages/shift-handover/index.wxss */

.page-content {
  min-height: 100vh;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.p-md {
  padding: 24rpx;
}

.min-w-0 {
  min-width: 0;
}

.shrink-0 {
  flex-shrink: 0;
}

.border-b-gold {
  border-bottom: 1rpx solid rgba(232, 163, 61, 0.2);
}

.border-b-cyan {
  border-bottom: 1rpx solid rgba(41, 193, 223, 0.25);
}

.border-b-subtle {
  border-bottom: 1rpx dashed rgba(214, 196, 176, 0.4);
}

.grid-2col {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.w-full {
  width: 100%;
}

.chip-badge {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 700;
  display: inline-block;
}

.shift-state {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
}

.shift-metrics-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.shift-metric-card {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  align-items: flex-start;
}

.shift-metric-wide {
  grid-column: span 2;
}

.shift-note {
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(255, 248, 238, 0.9);
  border: 1rpx solid rgba(232, 163, 61, 0.24);
  font-size: 20rpx;
  line-height: 30rpx;
  color: var(--text-muted);
}

.shift-note-title {
  flex: 1;
  min-width: 0;
}

.shift-empty-note {
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: rgba(242, 243, 255, 0.65);
}

.shift-source-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.action-column {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.disabled-button {
  opacity: 0.55;
}

.disabled-hint {
  text-align: center;
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--text-muted);
}
