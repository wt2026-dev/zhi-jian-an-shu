/* pages/work-order-detail/index.wxss */

.p-md {
  padding: 24rpx;
}

.p-sm {
  padding: 16rpx;
}

.border-b-subtle {
  border-bottom: 1rpx solid rgba(232, 163, 61, 0.18);
}

.border-b-cyan {
  border-bottom: 1rpx solid rgba(41, 193, 223, 0.22);
}

.chip-badge {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 700;
  display: inline-block;
}

.chip {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.chip-gold {
  background: rgba(232, 163, 61, 0.15);
  color: #b45309;
  border: 1rpx solid rgba(232, 163, 61, 0.35);
}

.chip-cyan {
  background: rgba(41, 193, 223, 0.14);
  color: #00768c;
  border: 1rpx solid rgba(41, 193, 223, 0.35);
}

.chip-blue {
  background: rgba(14, 165, 233, 0.12);
  color: #0284c7;
  border: 1rpx solid rgba(14, 165, 233, 0.3);
}

.chip-critical {
  background: #ffdad6;
  color: #ba1a1a;
  border: 1rpx solid rgba(186, 26, 26, 0.3);
}

.chip-nominal {
  background: rgba(16, 185, 129, 0.12);
  color: #059669;
  border: 1rpx solid rgba(16, 185, 129, 0.3);
}

.chip-muted {
  background: rgba(226, 232, 240, 0.7);
  color: #64748b;
  border: 1rpx solid rgba(203, 213, 225, 0.8);
}

.pre-wrap {
  white-space: pre-wrap;
  word-break: break-all;
}

/* 主信息网格 */
.detail-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.detail-item {
  background: rgba(242, 243, 255, 0.72);
  border: 1rpx solid rgba(218, 226, 253, 0.6);
  border-radius: 16rpx;
  padding: 14rpx 16rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.detail-label {
  font-size: 20rpx;
  color: var(--text-muted);
}

.detail-value {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--on-surface);
  word-break: break-all;
}

.detail-value-primary {
  color: var(--primary);
}

/* 流转步骤 */
.step-track {
  display: flex;
  align-items: flex-start;
  padding-top: 6rpx;
}

.step-node {
  width: 108rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.step-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #dae2fd;
  border: 3rpx solid #ffffff;
  box-shadow: 0 0 0 2rpx rgba(218, 226, 253, 0.9);
}

.step-dot-done {
  background: #10b981;
  box-shadow: 0 0 0 2rpx rgba(16, 185, 129, 0.35);
}

.step-dot-active {
  background: #e8a33d;
  box-shadow: 0 0 0 2rpx rgba(232, 163, 61, 0.45), 0 0 12rpx rgba(232, 163, 61, 0.5);
}

.step-dot-cancelled {
  background: #ef4444;
  box-shadow: 0 0 0 2rpx rgba(239, 68, 68, 0.35);
}

.step-label {
  font-size: 20rpx;
  color: var(--text-muted);
  text-align: center;
}

.step-label-done {
  color: #059669;
  font-weight: 600;
}

.step-label-active {
  color: var(--primary);
  font-weight: 700;
}

.step-label-cancelled {
  color: var(--error);
  font-weight: 700;
}

.step-connector {
  flex: 1;
  height: 4rpx;
  margin-top: 11rpx;
  border-radius: 999rpx;
  background: rgba(218, 226, 253, 0.9);
}

.step-connector-done {
  background: rgba(16, 185, 129, 0.55);
}

/* 日志时间线 */
.log-item {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  padding-top: 12rpx;
}

.log-rail {
  width: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 8rpx;
}

.log-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #29c1df;
  box-shadow: 0 0 8rpx rgba(41, 193, 223, 0.6);
  flex-shrink: 0;
}

.log-line {
  width: 2rpx;
  flex: 1;
  margin-top: 6rpx;
  background: rgba(218, 226, 253, 0.9);
}

.log-body {
  padding-bottom: 18rpx;
  border-bottom: 1rpx dashed rgba(214, 196, 176, 0.35);
}

.log-item:last-child .log-body {
  border-bottom: none;
}

.detail-bottom-spacer {
  height: 200rpx;
}

/* 底部操作面板 */
.action-sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(19, 27, 46, 0.42);
  backdrop-filter: blur(6rpx);
  -webkit-backdrop-filter: blur(6rpx);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.action-sheet {
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 20rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -12rpx 40rpx rgba(19, 27, 46, 0.18);
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(147, 160, 184, 0.4);
  margin: 0 auto 22rpx;
}

.field-label {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--on-surface-variant);
  margin-top: 20rpx;
  margin-bottom: 10rpx;
}

.field-input,
.picker-value {
  width: 100%;
  min-height: 76rpx;
  background: rgba(242, 243, 255, 0.85);
  border: 1rpx solid rgba(218, 226, 253, 0.9);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: var(--on-surface);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-textarea {
  width: 100%;
  min-height: 120rpx;
  background: rgba(242, 243, 255, 0.85);
  border: 1rpx solid rgba(218, 226, 253, 0.9);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: var(--on-surface);
}

.picker-arrow {
  color: var(--text-muted);
  font-size: 22rpx;
}

.segment-row {
  display: flex;
  gap: 14rpx;
}

.segment-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 12rpx;
  border-radius: 16rpx;
  background: rgba(242, 243, 255, 0.85);
  border: 1rpx solid rgba(218, 226, 253, 0.9);
  font-size: 25rpx;
  font-weight: 600;
  color: var(--on-surface-variant);
}

.segment-item-active {
  background: rgba(16, 185, 129, 0.12);
  border-color: rgba(16, 185, 129, 0.45);
  color: #059669;
}

.segment-item-danger {
  background: rgba(239, 68, 68, 0.1);
  border-color: rgba(239, 68, 68, 0.45);
  color: var(--error);
}
