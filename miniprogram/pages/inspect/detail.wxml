<!-- 巡检打卡 · Solar-Punk Bright Game-HUD -->
<view class="fx-bg">
  <view class="fx-hex"></view>
  <view class="fx-particles"></view>
  <view class="fx-bloom"></view>
</view>

<view class="page-body">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="empty-state">
    <view class="loading-ring"></view>
    <text class="empty-text">巡检任务加载中...</text>
  </view>

  <block wx:if="{{task}}">
    <!-- 任务主 HUD 卡 -->
    <view class="hud-card task-main-card">
      <view class="hud-accent-top"></view>
      <view class="task-title">{{task.title}}</view>
      <view class="task-route">
        <text class="task-route-icon">🗺</text>
        <text>路线：{{task.route}}</text>
      </view>
      <view class="task-progress-row">
        <view class="progress-chip">
          <text class="progress-num mono">{{task.completedPoints}}/{{task.totalPoints}}</text>
          <text class="progress-unit">测点</text>
        </view>
        <view wx:if="{{task.abnormalCount > 0}}" class="abnormal-chip" style="{{aStyle}}">
          异常 {{task.abnormalCount}} 处
        </view>
      </view>
      <button class="btn btn-ghost scan-btn" bindtap="scanCode">📷 扫设备二维码核验</button>
      <view wx:if="{{scanResult}}" class="scan-ok">{{scanResult}}</view>
    </view>

    <!-- 测点卡 -->
    <view class="glass-card point-card {{item.abnormal ? 'point-card-abnormal' : ''}}"
          wx:for="{{items}}" wx:key="id">
      <view class="point-header">
        <view class="point-name">{{index + 1}}. {{item.checkPoint || item.checkItem}}</view>
        <view class="point-badge" style="{{item.badgeStyle}}">{{item.stateText}}</view>
      </view>
      <view class="point-standard">
        标准：{{item.standard}}<text wx:if="{{item.rangeText}}">　限值：{{item.rangeText}}</text>
      </view>
      <view class="point-input-row">
        <input class="input point-input" type="digit" placeholder="录入实测值"
               value="{{item.input}}" data-idx="{{index}}" bindinput="onValue" />
        <button class="btn btn-gold punch-btn" data-idx="{{index}}" bindtap="submitPoint">打卡</button>
      </view>
      <input class="input note-input" placeholder="备注（可选）" value="{{item.notes}}" data-idx="{{index}}" bindinput="onNotes" />
      <button wx:if="{{item.abnormal}}" class="btn btn-amber action-btn" data-idx="{{index}}" bindtap="toOrder">一键转报修单</button>
      <button wx:if="{{item.abnormal}}" class="btn btn-ghost action-btn" data-idx="{{index}}" bindtap="aiDraft">✨ AI 生成工单草稿</button>
    </view>

    <!-- AI 工单草稿（天青玻璃卡） -->
    <view wx:if="{{aiDraftOpen}}" class="glass-card ai-draft-card">
      <view class="ai-draft-head">
        <text class="ai-draft-icon">✨</text>
        <text>AI 工单草稿</text>
      </view>
      <view wx:if="{{aiLoading}}" class="ai-loading">AI 生成中，约 10~30 秒...</view>
      <block wx:else>
        <view class="kv-row">
          <text class="kv-key">标题</text>
          <text class="kv-val">{{aiDraft.title}}</text>
        </view>
        <view class="kv-row">
          <text class="kv-key">优先级</text>
          <text class="kv-val">{{aiDraft.priority}}（{{aiDraft.priorityReason}}）</text>
        </view>
        <view class="ai-sub-label">建议步骤</view>
        <view class="ai-step-line" wx:for="{{aiDraft.suggestedSteps}}" wx:key="*this">• {{item}}</view>
        <view class="ai-sub-label">备件</view>
        <view class="ai-step-line" wx:for="{{aiDraft.spareParts}}" wx:key="name">• {{item.name}} {{item.spec}} × {{item.qty}}</view>
        <button class="btn btn-gold action-btn" bindtap="confirmAiOrder">确认创建真实工单</button>
        <button class="btn btn-ghost action-btn" bindtap="closeAi">取消</button>
      </block>
    </view>

    <view class="safe-bottom"></view>
  </block>
</view>
