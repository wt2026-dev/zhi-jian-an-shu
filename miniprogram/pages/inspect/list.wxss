/* inspect/list.wxss - 巡检作业列表 · Solar-Punk */
@import '../../common.wxss';

page {
  background: linear-gradient(180deg, #F8FBFF 0%, #F1F7FE 55%, #F7F4FF 100%);
  background-color: #F2F7FD;
  min-height: 100vh;
}

.page-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.task-list {
  flex: 1;
  padding: 20rpx 0 0;
}

/* 加载 / 错误态 */
.loading-state, .error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 140rpx 48rpx;
}
.loading-ring {
  width: 56rpx; height: 56rpx;
  border: 6rpx solid rgba(232, 163, 61, 0.2);
  border-top-color: #E8A33D;
  border-radius: 50%;
  margin-bottom: 24rpx;
  animation: spin 0.9s linear infinite;
}
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.loading-text { font-size: 26rpx; color: #64748B; }
.error-icon { font-size: 64rpx; margin-bottom: 24rpx; }
.error-text { font-size: 26rpx; color: #FB7185; text-align: center; margin-bottom: 24rpx; }
.retry-btn {
  padding: 16rpx 48rpx;
  background: linear-gradient(135deg, #F6D08A 0%, #E8A33D 100%);
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx -6rpx rgba(232, 163, 61, 0.5);
}
.retry-btn:active { opacity: 0.85; }

/* 顶部操作栏：扫码巡检(金) + AI 报告(青) */
.top-action-bar {
  display: flex;
  gap: 16rpx;
  margin: 0 24rpx 20rpx;
}
.scan-inspect-btn {
  flex: 1.3;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #F6D08A 0%, #E8A33D 48%, #D98F2B 100%);
  border-radius: 18rpx;
  padding: 24rpx;
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 700;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6),
    0 8rpx 20rpx -8rpx rgba(232, 163, 61, 0.55);
}
.scan-inspect-btn:active { opacity: 0.88; transform: translateY(2rpx); }
.scan-icon { font-size: 28rpx; }

.ai-report-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #67E8F9 0%, #06B6D4 100%);
  border: 1rpx solid rgba(6, 182, 212, 0.4);
  border-radius: 18rpx;
  padding: 24rpx;
  font-size: 25rpx;
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx -8rpx rgba(6, 182, 212, 0.5);
}
.ai-report-btn:active { opacity: 0.88; }
.ai-report-icon { font-size: 28rpx; }

/* 任务卡 */
.task-card {
  margin: 0 24rpx 20rpx;
  padding: 24rpx 28rpx;
}
.task-card:active { transform: translateY(2rpx); opacity: 0.92; }
.task-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  gap: 16rpx;
}
.task-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #0F172A;
  flex: 1;
  line-height: 1.35;
}
.task-status {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}
.task-area {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 23rpx;
  color: #64748B;
  margin-bottom: 18rpx;
}
.task-area-icon { font-size: 21rpx; }

/* 进度条 */
.task-progress-section { margin-bottom: 16rpx; }
.task-progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}
.task-progress-label { font-size: 21rpx; color: #94A3B8; }
.task-progress-value {
  font-size: 22rpx;
  color: #B8761F;
  font-weight: 700;
  font-family: "DIN Alternate", monospace;
}
.task-progress-bar {
  height: 10rpx;
  background: rgba(220, 230, 242, 0.8);
  border-radius: 5rpx;
  overflow: hidden;
}
.task-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #E8A33D 0%, #06B6D4 100%);
  border-radius: 5rpx;
  box-shadow: 0 0 8rpx rgba(6, 182, 212, 0.4);
}

/* 底部信息 */
.task-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 14rpx;
  border-top: 1rpx dashed rgba(220, 230, 242, 0.8);
}
.task-time, .task-inspector {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 21rpx;
  color: #94A3B8;
}
.task-time-icon, .task-inspector-icon { font-size: 19rpx; }
.mono { font-family: "DIN Alternate", monospace; }

/* 空态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}
.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; opacity: 0.5; }
.empty-text { font-size: 26rpx; color: #94A3B8; }

.bottom-spacer { height: 40rpx; }

/* AI 报告弹层（玻璃拟态） */
.report-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(15, 23, 42, 0.6);
  backdrop-filter: blur(6rpx);
  -webkit-backdrop-filter: blur(6rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  z-index: 999;
}
.report-panel {
  width: 100%;
  max-height: 80vh;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(220, 230, 242, 0.9);
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 0 0 1rpx rgba(232, 163, 61, 0.2), 0 20rpx 50rpx -20rpx rgba(15, 23, 42, 0.4);
}
.report-head { padding: 26rpx 28rpx; border-bottom: 1rpx solid rgba(220, 230, 242, 0.8); }
.report-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}
.report-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0F172A;
}
.report-close {
  font-size: 28rpx;
  color: #94A3B8;
  padding: 0 8rpx;
}
.report-range {
  font-size: 22rpx;
  color: #94A3B8;
  font-family: "DIN Alternate", monospace;
}
.report-body {
  flex: 1;
  padding: 24rpx 28rpx;
  min-height: 300rpx;
}
.report-text {
  font-size: 24rpx;
  color: #334155;
  line-height: 1.8;
  white-space: pre-wrap;
}
.report-actions {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid rgba(220, 230, 242, 0.8);
}
.report-btn {
  flex: 1;
  font-size: 24rpx;
  padding: 16rpx 0;
  text-align: center;
  background: rgba(220, 230, 242, 0.5);
  color: #475569;
  border-radius: 12rpx;
  line-height: 1.4;
}
.report-btn::after { border: none; }
.report-btn-primary {
  background: linear-gradient(135deg, #F6D08A 0%, #E8A33D 100%);
  color: #FFFFFF;
  font-weight: 700;
}
