/* inspect/list.wxss - 巡检作业列表 */
@import '../../common.wxss';

page {
  background: #F5F7FA;
  min-height: 100vh;
}

.page-container {
  min-height: 100vh;
  background: #F5F7FA;
}

.task-list {
  padding: 16rpx 24rpx;
}

/* 顶部操作栏：扫码巡检 + AI 报告 */
.top-action-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.scan-inspect-btn {
  flex: 1.3;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  border-radius: 16rpx;
  padding: 22rpx;
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 700;
  box-shadow: 0 4rpx 14rpx rgba(37, 99, 235, 0.28);
}

.scan-inspect-btn:active { opacity: 0.85; }

.scan-icon { font-size: 28rpx; }

.top-action-bar .ai-report-btn {
  flex: 1;
  margin-bottom: 0;
  padding: 22rpx;
}

/* AI 巡检报告入口 */
.ai-report-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #0e7490, #0c4a6e);
  border: 1rpx solid rgba(34, 211, 238, 0.45);
  border-radius: 16rpx;
  padding: 22rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: #EFF6FF;
  font-weight: 600;
}

.ai-report-btn:active { opacity: 0.85; }

.ai-report-icon { font-size: 28rpx; }

/* AI 报告弹层 */
.report-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  z-index: 999;
}

.report-panel {
  width: 100%;
  max-height: 80vh;
  background: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.report-head {
  padding: 24rpx;
  border-bottom: 1rpx solid #E2E8F0;
}

.report-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3b82f6;
  display: block;
}

.report-range {
  font-size: 22rpx;
  color: #94A3B8;
  margin-top: 6rpx;
  display: block;
}

.report-body {
  flex: 1;
  padding: 24rpx;
  min-height: 300rpx;
}

.report-text {
  font-size: 24rpx;
  color: #E2E8F0;
  line-height: 1.8;
  white-space: pre-wrap;
}

.report-actions {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #E2E8F0;
}

.report-btn {
  flex: 1;
  font-size: 24rpx;
  padding: 16rpx 0;
  text-align: center;
  background: #E2E8F0;
  color: #E2E8F0;
  border-radius: 12rpx;
  line-height: 1.4;
}

.report-btn::after { border: none; }

.report-btn-primary {
  background: #3b82f6;
  color: #F5F7FA;
  font-weight: 700;
}

.task-card {
  background: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.task-card:active {
  background: #E2E8F0;
  border-color: #3b82f6;
}

/* 任务*/
.task-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.task-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E293B;
  flex: 1;
}

.task-status {
  font-size: 18rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

/* 任务区域 */
.task-area {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #64748B;
  margin-bottom: 16rpx;
}

.task-area-icon {
  font-size: 20rpx;
}

/* 进度*/
.task-progress-section {
  margin-bottom: 16rpx;
}

.task-progress-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.task-progress-label {
  font-size: 20rpx;
  color: #94A3B8;
}

.task-progress-value {
  font-size: 20rpx;
  color: #3b82f6;
  font-weight: 600;
  font-family: "DIN Alternate", monospace;
}

.task-progress-bar {
  height: 8rpx;
  background: #E2E8F0;
  border-radius: 4rpx;
  overflow: hidden;
}

.task-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #3b82f6, #3b82f6);
  border-radius: 4rpx;
}

/* 底部信息 */
.task-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(43, 50, 61, 0.5);
}

.task-time,
.task-inspector {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 20rpx;
  color: #94A3B8;
}

.task-time-icon,
.task-inspector-icon {
  font-size: 18rpx;
}

/* 空状*/
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #94A3B8;
}

.bottom-spacer {
  height: 40rpx;
}
