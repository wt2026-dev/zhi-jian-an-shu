<!-- 巡检作业列表 -->
<view class="page-container">
  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <text class="loading-icon">⏳</text>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 加载失败 -->
  <view class="error-state" wx:elif="{{loadError}}">
    <text class="error-icon">⚠️</text>
    <text class="error-text">{{loadError}}</text>
    <view class="retry-btn" bindtap="loadData">重试</view>
  </view>

  <!-- 正常列表 -->
  <scroll-view class="task-list" scroll-y wx:else>
    <!-- 顶部操作栏：扫码直达巡检 (主) + AI 总结报告 -->
    <view class="top-action-bar">
      <view class="scan-inspect-btn" bindtap="scanInspect">
        <text class="scan-icon">📷</text>
        <text class="scan-text">扫码直达巡检</text>
      </view>
      <view class="ai-report-btn" bindtap="genReport">
        <text class="ai-report-icon">✨</text>
        <text>{{reportLoading ? '生成中...' : 'AI 总结报告'}}</text>
      </view>
    </view>

    <view class="task-card" wx:for="{{tasks}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="task-header">
        <view class="task-name">{{item.name}}</view>
        <view class="task-status" style="{{item.statusStyle}}">{{item.status}}</view>
      </view>
      <view class="task-area">
        <text class="task-area-icon">📍</text>
        <text>{{item.area}}</text>
      </view>
      <view class="task-progress-section">
        <view class="task-progress-info">
          <text class="task-progress-label">巡检进度</text>
          <text class="task-progress-value">{{item.completed}}/{{item.points}} 点</text>
        </view>
        <view class="task-progress-bar">
          <view class="task-progress-fill" style="width: {{item.completed / item.points * 100}}%"></view>
        </view>
      </view>
      <view class="task-footer">
        <view class="task-time">
          <text class="task-time-icon">🕐</text>
          <text>{{item.time}}</text>
        </view>
        <view class="task-inspector">
          <text class="task-inspector-icon">👤</text>
          <text>{{item.inspector}}</text>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{tasks.length === 0}}">
      <text class="empty-icon">📝</text>
      <text class="empty-text">暂无巡检任务</text>
    </view>

    <view class="bottom-spacer"></view>
  </scroll-view>

  <!-- AI 巡检报告弹层 -->
  <view wx:if="{{reportMeta}}" class="report-mask" bindtap="closeReport">
    <view class="report-panel" catchtap="noop">
      <view class="report-head">
        <text class="report-title">AI 巡检总结报告</text>
        <text class="report-range">{{reportMeta.startDate}} ~ {{reportMeta.endDate}}</text>
      </view>
      <scroll-view class="report-body" scroll-y>
        <rich-text class="report-text" nodes="{{reportHtml || reportText}}" user-select />
      </scroll-view>
      <view class="report-actions">
        <view class="report-btn" bindtap="copyReport">复制全文</view>
        <button class="report-btn report-btn-primary" open-type="share">分享</button>
        <view class="report-btn" bindtap="closeReport">关闭</view>
      </view>
    </view>
  </view>
</view>
