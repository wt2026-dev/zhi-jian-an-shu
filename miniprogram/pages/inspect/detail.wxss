/* inspect/detail.wxss - 巡检打卡 · Solar-Punk */
@import '../../common.wxss';

page {
  background: linear-gradient(180deg, #F8FBFF 0%, #F1F7FE 55%, #F7F4FF 100%);
  background-color: #F2F7FD;
  min-height: 100vh;
}

.page-body { padding: 20rpx 0 24rpx; }

/* 加载态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
}
.loading-ring {
  width: 56rpx; height: 56rpx;
  border: 6rpx solid rgba(232, 163, 61, 0.2);
  border-top-color: #E8A33D;
  border-radius: 50%;
  margin-bottom: 24rpx;
  animation: spin 0.9s linear infinite;
}
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.empty-text { font-size: 26rpx; color: #64748B; }
.mono { font-family: "DIN Alternate", monospace; }

/* 任务主卡 */
.task-main-card {
  margin: 0 24rpx 20rpx;
  padding: 26rpx 28rpx;
}
.task-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0F172A;
  line-height: 1.35;
}
.task-route {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 23rpx;
  color: #64748B;
  margin: 10rpx 0 18rpx;
}
.task-route-icon { font-size: 21rpx; }
.task-progress-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 18rpx;
}
.progress-chip {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  background: rgba(6, 182, 212, 0.1);
  border: 1rpx solid rgba(6, 182, 212, 0.35);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}
.progress-num { font-size: 26rpx; font-weight: 700; color: #0B5E7A; }
.progress-unit { font-size: 20rpx; color: #0B5E7A; }
.abnormal-chip {
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 5rpx 16rpx;
}
.scan-btn { width: 100%; }
.scan-ok {
  color: #047857;
  font-size: 23rpx;
  margin-top: 14rpx;
  padding: 12rpx 16rpx;
  background: rgba(16, 185, 129, 0.1);
  border: 1rpx solid rgba(16, 185, 129, 0.35);
  border-radius: 12rpx;
  line-height: 1.5;
}

/* 测点卡 */
.point-card {
  margin: 0 24rpx 18rpx;
  padding: 24rpx 28rpx;
}
.point-card-abnormal {
  border: 1rpx solid rgba(239, 68, 68, 0.5);
  box-shadow: 0 0 0 1rpx rgba(239, 68, 68, 0.12), 0 8rpx 20rpx -10rpx rgba(239, 68, 68, 0.35);
}
.point-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}
.point-name {
  font-size: 27rpx;
  font-weight: 700;
  color: #0F172A;
  flex: 1;
  line-height: 1.4;
}
.point-badge {
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  flex-shrink: 0;
}
.point-standard {
  font-size: 22rpx;
  color: #94A3B8;
  margin-bottom: 16rpx;
  line-height: 1.5;
}
.point-input-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.point-input { flex: 1; }
.punch-btn { flex-shrink: 0; padding: 0 30rpx; height: 72rpx; line-height: 72rpx; font-size: 25rpx; }
.note-input { margin-top: 14rpx; }
.action-btn { width: 100%; margin-top: 14rpx; }

/* AI 草稿卡 */
.ai-draft-card {
  margin: 0 24rpx 20rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid rgba(6, 182, 212, 0.35);
}
.ai-draft-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #0B5E7A;
  font-weight: 700;
  font-size: 27rpx;
  margin-bottom: 14rpx;
}
.ai-loading {
  font-size: 24rpx;
  color: #94A3B8;
  padding: 20rpx 0;
  text-align: center;
}
.kv-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  padding: 10rpx 0;
  font-size: 24rpx;
}
.kv-key { color: #94A3B8; flex-shrink: 0; }
.kv-val { color: #1E293B; text-align: right; flex: 1; }
.ai-sub-label {
  font-size: 23rpx;
  font-weight: 600;
  color: #334155;
  margin: 14rpx 0 8rpx;
}
.ai-step-line {
  font-size: 23rpx;
  color: #475569;
  line-height: 1.7;
  padding: 3rpx 0;
}
