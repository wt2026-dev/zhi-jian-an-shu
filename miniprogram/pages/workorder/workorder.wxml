<!-- 作业票审批与气体联锁 · Solar-Punk Bright Game-HUD -->
<view class="fx-bg">
  <view class="fx-hex"></view>
  <view class="fx-particles"></view>
  <view class="fx-bloom"></view>
</view>

<view class="page-body wo-body">
  <!-- Header -->
  <view class="wo-header safe-top">
    <view class="wo-header-row">
      <view class="wo-header-left">
        <view class="back-btn" bindtap="onBack">
          <text class="back-arrow">‹</text>
        </view>
        <view class="wo-title-box">
          <view class="wo-title-row">
            <text class="wo-title">作业票审批与气体联锁</text>
            <view class="chip-gold wo-badge">GB 30871 联锁</view>
          </view>
          <text class="wo-ticket-no mono">安全票号 · {{ticket.safetyNo}}</text>
        </view>
      </view>
      <view class="online-chip">
        <view class="online-dot"></view>
        <text>无线网格通信</text>
      </view>
    </view>
  </view>

  <view class="wo-content">
    <!-- Section 1: 票据状态与核心元数据 -->
    <view class="hud-card wo-card">
      <view class="hud-accent-top"></view>
      <view class="meta-grid">
        <view class="meta-cell">
          <view class="meta-label"><text class="meta-icon">⚙</text>作业类型</view>
          <view class="meta-value">{{ticket.workType}}</view>
          <view class="meta-sub mono">{{ticket.workTypeSub}}</view>
        </view>
        <view class="meta-cell">
          <view class="meta-label"><text class="meta-icon">◎</text>作业区域</view>
          <view class="meta-value">{{ticket.area}}</view>
          <view class="meta-sub mono">{{ticket.areaSub}}</view>
        </view>
        <view class="meta-cell">
          <view class="meta-label"><text class="meta-icon text-warning">⏳</text>当前节点</view>
          <view class="meta-value text-warning">{{ticket.currentNode}}</view>
          <view class="meta-sub mono">{{ticket.nodeSub}}</view>
        </view>
        <view class="meta-cell">
          <view class="meta-label"><text class="meta-icon text-cyan">⏱</text>时效倒计时</view>
          <view class="meta-value meta-countdown mono">{{ticket.countdown}}</view>
          <view class="meta-sub mono">{{ticket.countdownSub}}</view>
        </view>
      </view>

      <!-- 安全联锁总控条 -->
      <view class="lock-bar">
        <view class="lock-left">
          <view class="lock-icon">🔒</view>
          <view class="lock-text">
            <view class="lock-title">安全隔离与气体联锁监测状态</view>
            <view class="lock-sub mono">硬件阀门联锁回路已挂载 · 闭锁防开逻辑生效</view>
          </view>
        </view>
        <view class="chip-cyan lock-chip">安全联锁生效</view>
      </view>
    </view>

    <!-- Section 2: 四类关键气体实时联锁读数 -->
    <view class="glass-card wo-card">
      <view class="section-title-row">
        <view class="section-title-dot"></view>
        <view class="section-title-text">四类关键气体实时联锁读数</view>
        <view class="online-chip gas-online"><view class="online-dot"></view><text>检测仪在线</text></view>
      </view>

      <view class="gas-grid">
        <view class="gas-card" wx:for="{{gases}}" wx:key="name">
          <view class="gas-head">
            <text class="gas-name mono">{{item.name}}</text>
            <view class="gas-ok">达标</view>
          </view>
          <view class="gas-value-row">
            <text class="gas-value">{{item.value}}</text>
            <text class="gas-unit">{{item.unit}}</text>
          </view>
          <view class="gas-progress"><view class="gas-progress-fill"></view></view>
          <view class="gas-foot">
            <text class="mono">{{item.range}}</text>
            <text class="mono">{{item.refresh}}</text>
          </view>
        </view>
      </view>

      <!-- 设备通讯说明条 -->
      <view class="comm-bar">
        <view class="comm-left">
          <text class="comm-icon">⬡</text>
          <text>7041B型 便携泵吸式气体检测仪实时上传</text>
        </view>
        <text class="comm-period mono">采样周期 10 秒</text>
      </view>
    </view>

    <!-- Section 3: 审批与安全核验节点流 -->
    <view class="glass-card wo-card">
      <view class="section-title-row">
        <view class="section-title-dot"></view>
        <view class="section-title-text">审批与安全核验节点流</view>
        <view class="section-title-sub">防篡改数字存证</view>
      </view>

      <view class="timeline">
        <view class="timeline-item" wx:for="{{timeline}}" wx:key="title">
          <view class="timeline-dot {{item.status === 'done' ? 'timeline-dot-done' : 'timeline-dot-active'}}">
            <text wx:if="{{item.status === 'done'}}">✓</text>
            <text wx:else>✎</text>
          </view>

          <!-- Done node -->
          <view wx:if="{{item.status === 'done'}}" class="tl-card">
            <view class="tl-head">
              <text class="tl-title">{{item.title}}</text>
              <text class="tl-time mono">{{item.time}}</text>
            </view>
            <text class="tl-desc">{{item.desc}}</text>
            <view wx:if="{{item.detailType === 'green'}}" class="tl-detail tl-detail-green">
              <text>✓</text><text>{{item.detail}}</text>
            </view>
            <view wx:elif="{{item.detailType === 'primary'}}" class="tl-detail tl-detail-cyan">
              <text>◉</text><text>{{item.detail}}</text>
            </view>
            <text wx:else class="tl-detail tl-detail-muted">{{item.detail}}</text>
          </view>

          <!-- Active node -->
          <view wx:if="{{item.status === 'active'}}" class="tl-card tl-active-card">
            <view class="tl-head">
              <text class="tl-active-title">{{item.title}}</text>
              <view class="chip-gold">待审批</view>
            </view>
            <view class="approver-row">
              <view class="approver-avatar">{{item.initial}}</view>
              <text class="approver-name">{{item.approver}} <text class="approver-role">{{item.approverRole}}</text></text>
              <view class="permit-chip">特级签发权限</view>
            </view>
            <text class="tl-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Section 4: 签名与批准操作区 -->
    <view class="glass-card wo-card">
      <view class="section-title-row">
        <view class="section-title-dot"></view>
        <view class="section-title-text">电子验签与合规签署</view>
        <view class="section-title-sub">GB 30871 规范合规</view>
      </view>
      <view class="sign-area" bindtap="onTouchSign">
        <view class="sign-icon">👆</view>
        <text class="sign-title">点击进行指纹 / 生物识别触控验签</text>
        <text class="sign-sub mono">国密CA数字证书防伪加密 · 自动附加时间戳与审批哈希</text>
      </view>
    </view>
  </view>

  <!-- Bottom Bar -->
  <view class="bottom-bar safe-bottom">
    <view class="bottom-row">
      <view class="btn-reject" bindtap="onReject">
        <text>↩</text>
        <text>退回修正</text>
      </view>
      <view class="btn-approve {{approveDisabled ? 'btn-disabled' : ''}}" bindtap="onApprove">
        <text>✓</text>
        <text>{{approveText}}</text>
      </view>
    </view>
  </view>

  <!-- Sign Modal -->
  <view class="modal-mask {{showModal ? '' : 'hidden'}}" catchtouchmove="preventMove">
    <view class="modal-content">
      <view class="modal-head">
        <view class="modal-head-left">
          <view class="modal-lock">🔐</view>
          <view>
            <text class="modal-title">数字证书与签名核验</text>
            <text class="modal-sub mono">GB 30871 危险化学品企业特殊作业规范</text>
          </view>
        </view>
        <view class="modal-close" bindtap="onCloseModal">✕</view>
      </view>

      <view class="modal-info">
        <view class="modal-info-row">
          <text class="mi-key mono">作业票号</text>
          <text class="mi-val mono">{{ticket.ticketNo}}</text>
        </view>
        <view class="modal-info-row">
          <text class="mi-key">审批权限</text>
          <text class="mi-val text-cyan">安环部 安全总监（终审签发）</text>
        </view>
        <view class="modal-info-row">
          <text class="mi-key">联锁状态</text>
          <text class="mi-val text-success">4通道气体全部达标 · 联锁生效</text>
        </view>
      </view>

      <view class="sign-preview">
        <text class="sign-preview-icon">⬡</text>
        <text class="mono">{{signInfo.signUser}} · CA数字指纹已锁定</text>
        <text class="sign-hash mono">{{signInfo.shaHash}}</text>
      </view>

      <view class="modal-actions">
        <view class="modal-cancel" bindtap="onCancelSign">取消</view>
        <view class="modal-confirm" bindtap="onConfirmSign">
          <text>✓</text>
          <text>确认核发特级动火令</text>
        </view>
      </view>
    </view>
  </view>
</view>
