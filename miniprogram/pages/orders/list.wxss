/* orders/list.wxss - 检修工单列*/
@import '../../common.wxss';

page {
  background: #F5F7FA;
  min-height: 100vh;
}

.page-container {
  min-height: 100vh;
  background: #F5F7FA;
  display: flex;
  flex-direction: column;
}

/* 标签*/
.tabs-bar {
  background: #F5F7FA;
  border-bottom: 1rpx solid #E2E8F0;
  white-space: nowrap;
  padding: 0 16rpx;
}

.tab-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: #94A3B8;
  position: relative;
}

.tab-active {
  color: #3b82f6;
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #3b82f6;
  border-radius: 2rpx;
}

/* 工单列表 */
.order-list {
  flex: 1;
  padding: 16rpx 24rpx;
}

.order-card {
  background: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.order-card:active {
  background: #E2E8F0;
  border-color: #3b82f6;
}

/* 工单*/
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.order-no-box {
  background: rgba(34, 211, 238, 0.1);
  border: 1rpx solid rgba(34, 211, 238, 0.3);
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
}

.order-no {
  font-size: 20rpx;
  color: #3b82f6;
  font-family: "DIN Alternate", monospace;
  font-weight: 600;
}

.order-badges {
  display: flex;
  gap: 8rpx;
}

.priority-badge,
.status-badge {
  font-size: 18rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

/* 工单标题 */
.order-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

/* 设备信息 */
.order-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #64748B;
  margin-bottom: 12rpx;
}

.order-info-icon {
  font-size: 20rpx;
}

/* 底部信息 */
.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(43, 50, 61, 0.5);
}

.order-footer-left {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.order-time-icon,
.order-assignee-icon {
  font-size: 18rpx;
}

.order-time {
  font-size: 20rpx;
  color: #94A3B8;
  font-family: "DIN Alternate", monospace;
}

.order-assignee {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 20rpx;
  color: #64748B;
}

/* 空状*/
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #94A3B8;
}

/* 浮动按钮 */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 200rpx;
  background: linear-gradient(135deg, #3b82f6 0%, #0ea5e9 100%);
  border-radius: 50%;
  width: 120rpx;
  height: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(56, 189, 248, 0.4);
}

.fab-btn:active {
  transform: scale(0.95);
}

.fab-icon {
  font-size: 40rpx;
  color: #F1F5F9;
  font-weight: 700;
  line-height: 1;
}

.fab-text {
  font-size: 18rpx;
  color: #F1F5F9;
  font-weight: 600;
}

.bottom-spacer {
  height: 120rpx;
}
