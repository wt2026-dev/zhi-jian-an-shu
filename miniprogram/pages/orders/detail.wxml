<view wx:if="{{loading}}" class="empty">加载中...</view>
<block wx:if="{{order}}">
  <view class="card">
    <view class="row">
      <view class="mono muted">{{order.orderNo}}</view>
      <view class="sp"></view>
      <view class="badge" style="{{pStyle}}">{{pText}}</view>
      <view class="badge" style="{{sStyle}};margin-left:8rpx">{{sText}}</view>
    </view>
    <view class="h1" style="margin:16rpx 0 8rpx">{{order.title}}</view>
    <view class="muted">{{order.equipmentName}} ({{order.equipmentCode}}) · {{order.workshop}}</view>
  </view>

  <view class="card" wx:if="{{stageIdx >= 0}}">
    <view class="stages">
      <block wx:for="{{stages}}" wx:key="i">
        <view class="stage">
          <view class="s-dot {{index <= stageIdx ? 's-on' : ''}}">{{index + 1}}</view>
          <view class="s-t {{index <= stageIdx ? 's-on-t' : ''}}">{{item}}</view>
        </view>
        <view class="s-line {{index < stageIdx ? 's-l-on' : ''}}" wx:if="{{index < 4}}"></view>
      </block>
    </view>
  </view>
  <view class="card" wx:if="{{order.status === 'cancelled'}}">
    <text style="color:#FB7185">该工单已取消</text>
  </view>

  <view class="card">
    <view class="kv"><text class="muted">提单人</text><text>{{order.creator}}</text></view>
    <view class="kv"><text class="muted">派单人</text><text>{{order.dispatcher || "—"}}</text></view>
    <view class="kv"><text class="muted">主修技师</text><text>{{order.assignee || "待分配"}}</text></view>
    <view class="kv"><text class="muted">创建时间</text><text class="mono">{{order.createdAt}}</text></view>
    <view class="kv" wx:if="{{order.completedAt}}"><text class="muted">完成时间</text><text class="mono">{{order.completedAt}}</text></view>
  </view>

  <view class="card">
    <view class="title">故障描述</view>
    <view class="desc">{{order.description}}</view>
    <view class="title" style="margin-top:20rpx">安全要求</view>
    <view class="desc" wx:for="{{order.safetyRequirements}}" wx:key="*this">• {{item}}</view>
  </view>

  <view class="card" wx:if="{{order.repairLog}}">
    <view class="title">维修上报</view>
    <view class="kv"><text class="muted">原因分析</text><text>{{order.repairLog.causeAnalysis}}</text></view>
    <view class="kv"><text class="muted">处理步骤</text><text>{{order.repairLog.resolutionSteps}}</text></view>
    <view class="kv"><text class="muted">工时</text><text class="mono">{{order.repairLog.workHours}}h</text></view>
  </view>

  <view class="card" wx:if="{{order.acceptance}}">
    <view class="title">验收结论</view>
    <view class="kv"><text class="muted">质检人</text><text>{{order.acceptance.inspectorName}}</text></view>
    <view class="kv"><text class="muted">评分</text><text class="mono">{{order.acceptance.score}} 星</text></view>
    <view class="kv"><text class="muted">意见</text><text>{{order.acceptance.comment}}</text></view>
  </view>

  <block wx:if="{{showDispatch}}">
    <view class="card">
      <view class="title">主管派发工单</view>
      <button class="btn btn-ghost" bindtap="aiRecommend" disabled="{{recLoading}}">
        {{recLoading ? "AI 分析中..." : "AI 推荐派单（技能/负载/经验）"}}
      </button>
      <view wx:if="{{rec}}" class="ai-rec">
        <view style="color:#22D3EE;font-weight:700">AI 推荐：{{rec.recommended.name}} · 预估 {{rec.estimatedHours}}h</view>
        <view class="muted" style="margin:8rpx 0">{{rec.recommended.reason}}</view>
        <view class="muted">备选：{{altText}}</view>
        <button class="btn btn-primary" bindtap="applyRec">采纳推荐</button>
      </view>
      <view class="label">指派技师</view>
      <picker range="{{techNames}}" bindchange="onTechPick">
        <view class="input">{{techNames[techIdx] || "点击选择"}}</view>
      </picker>
      <view class="label">预估工时（小时）</view>
      <input class="input" type="digit" value="{{estHours}}" bindinput="onHours" />
      <button class="btn btn-amber" bindtap="doDispatch">确认派发</button>
    </view>
  </block>

  <block wx:if="{{showClaim}}">
    <view class="card">
      <button class="btn btn-primary" bindtap="doClaim">确认接单（进入检修中）</button>
    </view>
  </block>

  <block wx:if="{{showComplete}}">
    <view class="card">
      <view class="title">检修完工上报</view>
      <view class="label">原因分析 *</view>
      <textarea class="textarea" value="{{cause}}" bindinput="onCause" maxlength="300"></textarea>
      <view class="label">处理步骤 *</view>
      <textarea class="textarea" value="{{steps}}" bindinput="onSteps" maxlength="300"></textarea>
      <view class="label">工时（小时）</view>
      <input class="input" type="digit" value="{{workHours}}" bindinput="onHours" />
      <view class="label">备件（每行：名称 数量）</view>
      <textarea class="textarea" value="{{parts}}" bindinput="onParts"></textarea>
      <view class="label">完工照片（{{photos.length}} 张）</view>
      <button class="btn btn-ghost" bindtap="addPhoto">＋ 拍照 / 从相册选择</button>
      <button class="btn btn-primary" bindtap="doComplete">提交完工上报</button>
    </view>
  </block>

  <block wx:if="{{showAccept}}">
    <view class="card">
      <view class="title">质检验收</view>
      <view class="label">评分：{{score}} 星</view>
      <slider min="1" max="5" step="1" value="{{score}}" activeColor="#22D3EE" bindchange="onScore" />
      <view class="label">验收意见</view>
      <textarea class="textarea" value="{{comment}}" bindinput="onComment"></textarea>
      <button class="btn btn-green" bindtap="doAccept" data-pass="true">验收通过（归档闭环）</button>
      <button class="btn btn-rose" bindtap="doAccept" data-pass="false">驳回返修</button>
    </view>
  </block>
  <view class="safe-bottom"></view>
</block>