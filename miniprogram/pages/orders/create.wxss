/* 创建检修工单 (明亮玻璃科技风) */
.page-container {
  padding: 24rpx;
}
.label {
  font-size: 26rpx;
  font-weight: 600;
  color: #334155;
  margin: 20rpx 0 10rpx;
}
.input {
  background: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  border-radius: 16rpx;
  padding: 22rpx 20rpx;
  font-size: 28rpx;
  color: #0F172A;
}
.textarea {
  background: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #0F172A;
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
}
