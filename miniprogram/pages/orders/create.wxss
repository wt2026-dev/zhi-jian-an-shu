/* orders/create.wxss - 创建报修工单 · Solar-Punk */
@import '../../common.wxss';

page {
  background: linear-gradient(180deg, #F8FBFF 0%, #F1F7FE 55%, #F7F4FF 100%);
  background-color: #F2F7FD;
  min-height: 100vh;
}

.create-body {
  padding: 24rpx 0 24rpx;
}

/* 危险告警条 */
.danger-banner {
  margin: 0 24rpx 20rpx;
  background: linear-gradient(135deg, #EF4444 0%, #DC2626 100%);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  box-shadow:
    0 0 0 1rpx rgba(239, 68, 68, 0.35),
    0 8rpx 22rpx -8rpx rgba(239, 68, 68, 0.45),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.25);
}
.danger-icon {
  width: 48rpx; height: 48rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  font-size: 28rpx; font-weight: 700;
  text-align: center; line-height: 48rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.danger-body { flex: 1; min-width: 0; }
.danger-title { font-size: 26rpx; font-weight: 700; color: #FFFFFF; }
.danger-sub { font-size: 21rpx; color: rgba(255, 255, 255, 0.88); margin-top: 4rpx; line-height: 1.4; }
.force-btn { flex-shrink: 0; margin-left: 16rpx; font-size: 20rpx; line-height: 1.4; padding: 10rpx 18rpx; }

/* 表单卡 */
.form-card {
  margin: 0 24rpx 20rpx;
  padding: 26rpx 28rpx;
}
.label {
  font-size: 25rpx;
  font-weight: 600;
  color: #334155;
  margin: 22rpx 0 10rpx;
}
.input {
  background: rgba(255, 255, 255, 0.75);
  border: 1rpx solid #DCE6F2;
  border-radius: 16rpx;
  padding: 22rpx 20rpx;
  font-size: 27rpx;
  color: #0F172A;
  box-sizing: border-box;
}
.textarea {
  background: rgba(255, 255, 255, 0.75);
  border: 1rpx solid #DCE6F2;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #0F172A;
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
}
.picker-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.picker-value { color: #0F172A; font-weight: 500; }
.picker-placeholder { color: #94A3B8; }
.picker-arrow { color: #B8761F; font-size: 22rpx; }
.pri-chip { padding: 4rpx 16rpx; font-size: 20rpx; }

/* AI 诊断按钮 */
.ai-btn { margin-top: 20rpx; }

/* AI 诊断结论（天青玻璃） */
.ai-draft {
  background: rgba(6, 182, 212, 0.08);
  border: 1rpx solid rgba(6, 182, 212, 0.35);
  border-radius: 18rpx;
  padding: 22rpx;
  margin-top: 20rpx;
}
.ai-draft-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #0B5E7A;
  font-weight: 700;
  font-size: 26rpx;
  margin-bottom: 14rpx;
}
.ai-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
  font-size: 24rpx;
}
.ai-key { color: #64748B; }
.ai-val { color: #1E293B; font-weight: 600; }
.ai-pri { color: #B8761F; font-weight: 700; }
.ai-reason { color: #94A3B8; font-weight: 400; font-size: 22rpx; }
.ai-sub-label {
  font-size: 23rpx;
  font-weight: 600;
  color: #334155;
  margin: 16rpx 0 8rpx;
}
.ai-step {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  font-size: 23rpx;
  color: #475569;
  line-height: 1.6;
  padding: 4rpx 0;
}
.ai-step-no {
  width: 30rpx; height: 30rpx;
  border-radius: 50%;
  background: rgba(6, 182, 212, 0.15);
  color: #0B5E7A;
  font-size: 18rpx; font-weight: 700;
  text-align: center; line-height: 30rpx;
  flex-shrink: 0;
}
.ai-part {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 23rpx;
  color: #475569;
  padding: 4rpx 0;
}
.part-name { font-weight: 600; color: #1E293B; }
.part-spec { color: #94A3B8; font-size: 21rpx; }
.part-qty { color: #0B5E7A; font-weight: 600; margin-left: auto; }

/* 提交按钮 */
.submit-btn {
  width: 100%;
  margin-top: 28rpx;
}
.mono { font-family: "DIN Alternate", monospace; }
