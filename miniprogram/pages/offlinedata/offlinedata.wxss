/* offlinedata.wxss - 离线数据与缓存管理 · Solar-Punk */

.od-page {
  padding: 8rpx 0 40rpx;
}

/* ===== 顶部导航 ===== */
.od-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 12rpx 24rpx 0;
}
.od-nav-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 18rpx;
}
.od-nav-arrow {
  font-size: 30rpx;
  line-height: 1;
}
.od-nav-node {
  font-size: 20rpx;
  font-weight: 700;
}
.od-nav-back-text {
  font-size: 18rpx;
  color: #94A3B8;
}
.od-nav-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid #DCE6F2;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
}
.od-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #10B981;
  box-shadow: 0 0 0 3rpx rgba(16, 185, 129, 0.2);
}
.od-nav-status-text {
  font-size: 18rpx;
  color: #10B981;
}

/* ===== 页面标题 ===== */
.od-title-block {
  padding: 20rpx 24rpx 8rpx;
}
.od-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.od-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #0F172A;
}
.od-node-tag {
  font-size: 18rpx;
  padding: 4rpx 12rpx;
}
.od-subtitle {
  display: block;
  font-size: 20rpx;
  color: #94A3B8;
  margin-top: 8rpx;
}

/* ===== 安全协议条 ===== */
.od-security {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 16rpx 24rpx;
  padding: 24rpx 28rpx;
}
.od-security-icon {
  font-size: 38rpx;
}
.od-security-info {
  flex: 1;
  min-width: 0;
}
.od-security-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #0F172A;
}
.od-security-desc {
  display: block;
  font-size: 20rpx;
  color: #94A3B8;
  margin-top: 4rpx;
}

/* ===== 存储池监控 ===== */
.od-storage {
  margin: 0 24rpx 20rpx;
  padding: 26rpx 28rpx;
}
.od-storage-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.od-storage-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.od-storage-icon-box {
  width: 48rpx;
  height: 48rpx;
  background: rgba(232, 163, 61, 0.14);
  color: #B8761F;
}
.od-storage-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #0F172A;
}
.od-storage-usage {
  font-size: 30rpx;
  font-weight: 800;
  color: #B8761F;
  font-family: "DIN Alternate", monospace;
}
.od-storage-value-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-bottom: 20rpx;
}
.od-storage-value {
  font-size: 52rpx;
  font-weight: 800;
  color: #0F172A;
  font-family: "DIN Alternate", monospace;
  line-height: 1;
}
.od-storage-unit {
  font-size: 20rpx;
  color: #94A3B8;
}
.od-storage-divider {
  font-size: 24rpx;
  color: #CBD5E1;
  margin: 0 6rpx;
}
.od-storage-total {
  font-size: 34rpx;
  color: #64748B;
  font-family: "DIN Alternate", monospace;
}
.od-queue-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(232, 163, 61, 0.1);
  border: 1rpx solid rgba(232, 163, 61, 0.3);
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
  margin-left: auto;
}
.od-queue-tag text {
  font-size: 18rpx;
  color: #B8761F;
}
.od-queue-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #E8A33D;
}

/* 分段仪表 */
.od-gauge {
  display: flex;
  height: 14rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #E8EEF6;
  margin-bottom: 16rpx;
}
.od-gauge-seg {
  height: 100%;
}
.od-gauge-used {
  background: linear-gradient(90deg, #F6D08A, #E8A33D);
}
.od-gauge-queue {
  background: linear-gradient(90deg, #67E8F9, #06B6D4);
}
.od-gauge-free {
  flex: 1;
  background: #E8EEF6;
}

/* 图例 */
.od-legend {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.od-legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.od-legend-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 4rpx;
}
.od-legend-used { background: #E8A33D; }
.od-legend-queue { background: #06B6D4; }
.od-legend-free { background: #CBD5E1; }
.od-legend-text {
  font-size: 18rpx;
  color: #64748B;
}
.od-estimate-note {
  display: block;
  text-align: center;
  font-size: 18rpx;
  color: #94A3B8;
}

/* ===== 待同步清单头部 ===== */
.od-queue-head {
  margin: 12rpx 24rpx 16rpx;
}
.od-queue-count {
  font-size: 18rpx;
  padding: 4rpx 12rpx;
}
.od-select-all {
  margin-left: auto;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid #DCE6F2;
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  font-size: 20rpx;
  color: #475569;
}

/* ===== 队列列表 ===== */
.od-queue-list {
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.od-item {
  padding: 24rpx;
}
.od-item-main {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.od-item-check {
  padding-top: 4rpx;
  flex-shrink: 0;
}
.od-item-content {
  flex: 1;
  min-width: 0;
}
.od-item-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}
.od-item-id {
  font-size: 18rpx;
  color: #94A3B8;
  font-family: "DIN Alternate", monospace;
}
.od-status-pending {
  font-size: 18rpx;
  padding: 4rpx 12rpx;
}
.od-item-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #0F172A;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.od-item-desc {
  display: block;
  font-size: 20rpx;
  color: #64748B;
  line-height: 1.6;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 证据缩略图 */
.od-evidence {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 16rpx 0 0 60rpx;
}
.od-evidence-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(248, 251, 255, 0.8);
  border: 1rpx solid #DCE6F2;
  border-radius: 12rpx;
  padding: 10rpx;
  flex: 1 1 200rpx;
  min-width: 0;
}
.od-evidence-img {
  width: 64rpx;
  height: 64rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.od-evidence-name {
  display: block;
  font-size: 18rpx;
  color: #0F172A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.od-evidence-status {
  display: block;
  font-size: 16rpx;
  color: #94A3B8;
  margin-top: 2rpx;
}

/* 操作行 */
.od-item-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 0 0 60rpx;
}
.od-item-cachetime {
  font-size: 18rpx;
  color: #94A3B8;
}
.od-pin-btn {
  font-size: 18rpx;
  padding: 6rpx 16rpx;
}

/* ===== 开关行 ===== */
.od-section-head {
  margin: 20rpx 24rpx 16rpx;
}
.od-toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 0 24rpx 16rpx;
  padding: 22rpx 26rpx;
}
.od-toggle-info {
  flex: 1;
  min-width: 0;
}
.od-toggle-title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #0F172A;
}
.od-toggle-desc {
  display: block;
  font-size: 19rpx;
  color: #94A3B8;
  line-height: 1.5;
  margin-top: 6rpx;
}

/* ===== 归档清理 ===== */
.od-archive {
  margin: 0 24rpx 20rpx;
  padding: 26rpx 28rpx;
}
.od-archive-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.od-archive-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #0F172A;
}
.od-archive-size {
  font-size: 18rpx;
  color: #94A3B8;
  font-family: "DIN Alternate", monospace;
}
.od-archive-btns {
  display: flex;
  gap: 16rpx;
}
.od-btn {
  flex: 1;
  border-radius: 12rpx;
  padding: 16rpx 0;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
}
.od-btn::after {
  border: none;
}
.od-btn-clean {
  background: rgba(6, 182, 212, 0.1);
  color: #0B5E7A;
  border: 1rpx solid rgba(6, 182, 212, 0.35);
}
.od-btn-ghost {
  background: rgba(248, 251, 255, 0.8);
  color: #64748B;
  border: 1rpx solid #DCE6F2;
}

/* ===== 底部操作 ===== */
.od-bottom-actions {
  display: flex;
  gap: 16rpx;
  margin: 8rpx 24rpx 0;
}
.od-cache-clean {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
}
.od-cache-clean-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #0F172A;
}
.od-cache-clean-sub {
  font-size: 18rpx;
  color: #94A3B8;
  margin-top: 4rpx;
}
.od-sync-btn {
  flex: 1.6;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  border-radius: 16rpx;
  padding: 22rpx 20rpx;
  background: linear-gradient(135deg, #F6D08A 0%, #E8A33D 48%, #D98F2B 100%);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6),
    0 10rpx 26rpx -8rpx rgba(232, 163, 61, 0.55);
  color: #FFFFFF;
}
.od-sync-icon {
  font-size: 36rpx;
}
.od-sync-info {
  display: flex;
  flex-direction: column;
}
.od-sync-title {
  font-size: 26rpx;
  font-weight: 800;
}
.od-sync-sub {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 2rpx;
}
.od-sync-arrow {
  font-size: 28rpx;
}

/* 空态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx;
}
.empty-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}
.empty-text {
  font-size: 24rpx;
  color: #94A3B8;
  text-align: center;
}
