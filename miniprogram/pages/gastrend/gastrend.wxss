/* gastrend.wxss - 气体历史采样复测趋势 · Solar-Punk */

.page-container {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 顶部导航 */
.gt-header {
  padding: 16rpx 24rpx 8rpx;
}
.gt-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid #DCE6F2;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.gt-back-icon {
  font-size: 38rpx;
  color: #B8761F;
  line-height: 1;
}
.gt-kicker {
  font-size: 18rpx;
  color: #94A3B8;
  letter-spacing: 1rpx;
}
.gt-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #0F172A;
}
.gt-sync {
  padding: 6rpx 14rpx;
  font-size: 20rpx;
}
.gt-auto-refresh {
  font-size: 18rpx;
  color: #94A3B8;
  margin-top: 4rpx;
}

.dot-green {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #10B981;
}
.dot-green-sm {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #10B981;
}
.dot-green-xs {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #10B981;
}
.order-trend-dot {
  width: 10rpx;
  height: 24rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #E8A33D, #0EA5E9);
}
.dot-green-xs {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #10B981;
}

/* 作业上下文卡 */
.gt-op-card {
  margin-top: 16rpx;
  padding: 18rpx 22rpx;
}
.gt-op-place {
  margin-top: 8rpx;
}
.gt-op-text {
  font-size: 22rpx;
  color: #475569;
}
.gt-muted {
  font-size: 20rpx;
  color: #94A3B8;
}
.gt-mono {
  font-family: "DIN Alternate", monospace;
}

/* 倒计时横幅 */
.gt-countdown {
  margin: 16rpx 24rpx 0;
  padding: 24rpx 28rpx;
}
.gt-round-badge {
  padding: 6rpx 16rpx;
  font-size: 20rpx;
}
.gt-countdown-sub {
  font-size: 22rpx;
  color: #475569;
  margin-top: 8rpx;
}
.gt-timer {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(232, 163, 61, 0.1);
  border: 1rpx solid rgba(232, 163, 61, 0.3);
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  margin-top: 8rpx;
}
.gt-timer-num {
  font-size: 30rpx;
  font-weight: 800;
  color: #B8761F;
  font-family: "DIN Alternate", monospace;
}
.gt-countdown-label {
  font-size: 18rpx;
  color: #F59E0B;
  margin-top: 6rpx;
}

/* 气体标签 */
.gt-gas-tabs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin: 16rpx 24rpx 0;
  padding: 12rpx;
}
.gt-gas-tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 6rpx;
  border-radius: 16rpx;
  border: 1rpx solid transparent;
}
.gt-gas-tab-active {
  background: rgba(232, 163, 61, 0.1);
  border-color: rgba(232, 163, 61, 0.4);
  box-shadow: 0 4rpx 12rpx -4rpx rgba(232, 163, 61, 0.4);
}
.gt-gas-name {
  font-size: 19rpx;
  font-weight: 700;
  color: #64748B;
}
.gt-gas-value {
  font-size: 24rpx;
  font-weight: 800;
  color: #0F172A;
  font-family: "DIN Alternate", monospace;
  margin: 6rpx 0;
}
.gt-gas-status {
  margin-top: 2rpx;
}
.gt-status-ok {
  font-size: 18rpx;
  color: #10B981;
}

/* 趋势图卡 */
.gt-chart-card {
  margin: 16rpx 24rpx 0;
  padding: 26rpx 28rpx;
  display: flex;
  flex-direction: column;
}
.gt-chart-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #0F172A;
  margin-top: 6rpx;
}
.gt-latest-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #0F172A;
  font-family: "DIN Alternate", monospace;
  line-height: 1;
}
.gt-variance {
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  margin-top: 8rpx;
}
.gt-legend {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0 12rpx;
  font-size: 19rpx;
  color: #94A3B8;
}
.gt-legend-bar-safe {
  width: 24rpx;
  height: 8rpx;
  background: #10B981;
  opacity: 0.4;
  border-radius: 4rpx;
}
.gt-chart-area {
  width: 100%;
  height: 440rpx;
  background: rgba(248, 251, 255, 0.8);
  border: 1rpx solid #DCE6F2;
  border-radius: 16rpx;
  padding: 16rpx;
  position: relative;
}
.trend-canvas {
  width: 100%;
  height: 100%;
}
.gt-chart-footnote {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 4rpx 0;
  font-size: 18rpx;
  color: #94A3B8;
}

/* 台账 */
.gt-record-card {
  margin: 16rpx 24rpx 0;
  padding: 26rpx 28rpx;
}
.gt-record-list {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.gt-record-item {
  padding: 20rpx 22rpx;
}
.gt-round-tag {
  padding: 4rpx 14rpx;
  font-size: 19rpx;
}
.gt-time {
  font-size: 20rpx;
  color: #94A3B8;
}
.gt-pass-badge {
  padding: 4rpx 14rpx;
  font-size: 19rpx;
}
.gt-record-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 16rpx;
}
.gt-record-val {
  font-size: 22rpx;
  font-weight: 600;
  color: #0F172A;
  margin-top: 4rpx;
}

/* 底部操作 */
.gt-actions {
  display: flex;
  gap: 16rpx;
  margin: 20rpx 24rpx 0;
}
.gt-action-export {
  flex: 5;
  height: 92rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: #475569;
}
.gt-action-text {
  font-size: 26rpx;
  font-weight: 600;
}
.gt-action-next {
  flex: 7;
  height: 92rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
}
.gt-action-arrow {
  font-size: 30rpx;
}

.hidden-export-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
}

/* 空态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 48rpx;
}
.loading-ring {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid rgba(232, 163, 61, 0.2);
  border-top-color: #E8A33D;
  border-radius: 50%;
  margin-bottom: 24rpx;
  animation: spin 0.9s linear infinite;
}
.empty-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}
.empty-text {
  font-size: 24rpx;
  color: #94A3B8;
  text-align: center;
}
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
