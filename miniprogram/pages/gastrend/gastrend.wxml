<!-- 气体历史采样复测趋势 · Solar-Punk 明亮游戏化 HUD（自定义导航） -->
<view class="fx-bg">
  <view class="fx-hex"></view>
  <view class="fx-particles"></view>
  <view class="fx-bloom"></view>
</view>

<view class="page-container">
  <!-- 顶部状态条与导航 -->
  <view class="gt-header">
    <view class="flex items-center justify-between">
      <view class="flex items-center gap-2 min-w-0">
        <view class="gt-back" bindtap="goBack">
          <text class="gt-back-icon">‹</text>
        </view>
        <view class="flex flex-col min-w-0">
          <view class="flex items-center gap-2">
            <text class="gt-kicker">数据分析 // 多轮复测台账</text>
            <view class="dot-green"></view>
          </view>
          <text class="gt-title">气体历史采样复测趋势</text>
        </view>
      </view>
      <view class="flex flex-col items-end">
        <view class="chip-cyan gt-sync">
          <text>🔄 遥测直传</text>
        </view>
        <text class="gt-auto-refresh">自动刷新: 30s</text>
      </view>
    </view>

    <!-- 作业上下文 -->
    <view class="glass-card gt-op-card">
      <view class="flex items-center justify-between">
        <text class="gt-muted">安全票号</text>
        <text class="text-gold-deep font-bold gt-mono">作业票: 20241018-0089</text>
      </view>
      <view class="flex items-start gap-2 gt-op-place">
        <text>📍</text>
        <text class="gt-op-text">热轧二车间 · 1号高炉除尘布袋箱内部 (分区: 02B)</text>
      </view>
    </view>
  </view>

  <!-- 加载/失败 -->
  <view wx:if="{{loading}}" class="empty-state">
    <view class="loading-ring"></view>
    <text class="empty-text">加载中...</text>
  </view>
  <view wx:elif="{{loadError}}" class="empty-state">
    <text class="empty-icon">⚠️</text>
    <text class="empty-text">{{loadError}}</text>
  </view>

  <block wx:else>
    <!-- 倒计时横幅 -->
    <view class="hud-card gt-countdown">
      <view class="flex items-center justify-between">
        <view class="flex flex-col min-w-0 flex-1">
          <view class="flex items-center gap-2">
            <view class="chip-gold gt-round-badge">第 {{currentRound}} 轮 / 现场复测中</view>
            <text class="gt-muted">GB 30871 强制规程</text>
          </view>
          <text class="gt-countdown-sub">受限空间常规作业 · 每2小时强制复测</text>
        </view>
        <view class="flex flex-col items-end">
          <text class="gt-muted">本轮有效倒计时</text>
          <view class="gt-timer">
            <text>⏱</text>
            <text class="gt-timer-num">{{countdown}}</text>
          </view>
          <text wx:if="{{countdownLabel}}" class="gt-countdown-label">{{countdownLabel}}</text>
        </view>
      </view>
    </view>

    <!-- 气体选择标签 -->
    <view class="glass-card gt-gas-tabs">
      <view class="gt-gas-tab {{activeGas === 'O2' ? 'gt-gas-tab-active' : ''}}" bindtap="switchGas" data-gas="O2">
        <text class="gt-gas-name">氧气 O₂</text>
        <text class="gt-gas-value">{{gasData.O2.value}}{{gasData.O2.unit}}</text>
        <view class="flex items-center gap-1 gt-gas-status">
          <view class="dot-green-sm"></view>
          <text class="gt-status-ok">{{gasData.O2.status}}</text>
        </view>
      </view>
      <view class="gt-gas-tab {{activeGas === 'LEL' ? 'gt-gas-tab-active' : ''}}" bindtap="switchGas" data-gas="LEL">
        <text class="gt-gas-name">可燃气</text>
        <text class="gt-gas-value">{{gasData.LEL.value}}{{gasData.LEL.unit}}</text>
        <view class="flex items-center gap-1 gt-gas-status">
          <view class="dot-green-sm"></view>
          <text class="gt-status-ok">{{gasData.LEL.status}}</text>
        </view>
      </view>
      <view class="gt-gas-tab {{activeGas === 'CO' ? 'gt-gas-tab-active' : ''}}" bindtap="switchGas" data-gas="CO">
        <text class="gt-gas-name">一氧化碳</text>
        <text class="gt-gas-value">{{gasData.CO.value}}{{gasData.CO.unit}}</text>
        <view class="flex items-center gap-1 gt-gas-status">
          <view class="dot-green-sm"></view>
          <text class="gt-status-ok">{{gasData.CO.status}}</text>
        </view>
      </view>
      <view class="gt-gas-tab {{activeGas === 'H2S' ? 'gt-gas-tab-active' : ''}}" bindtap="switchGas" data-gas="H2S">
        <text class="gt-gas-name">硫化氢</text>
        <text class="gt-gas-value">{{gasData.H2S.value}}{{gasData.H2S.unit}}</text>
        <view class="flex items-center gap-1 gt-gas-status">
          <view class="dot-green-sm"></view>
          <text class="gt-status-ok">{{gasData.H2S.status}}</text>
        </view>
      </view>
    </view>

    <!-- 趋势图卡 -->
    <view class="hud-card gt-chart-card">
      <view class="flex items-start justify-between">
        <view>
          <text class="gt-muted">历史演变趋势 // 8小时</text>
          <text class="gt-chart-title">近8小时多轮次浓度演变</text>
        </view>
        <view class="flex flex-col items-end">
          <view class="flex items-baseline gap-1">
            <text class="gt-muted">最新实测</text>
            <text class="gt-latest-num">{{gasData.O2.value}}</text>
            <text class="text-sky">%VOL</text>
          </view>
          <view class="chip-titanium gt-variance">方差指数: 0.02 平稳</view>
        </view>
      </view>

      <!-- 图例 -->
      <view class="gt-legend">
        <view class="flex items-center gap-1">
          <view class="gt-legend-bar-safe"></view>
          <text>安全区 (19.5%-23.5%)</text>
        </view>
        <text class="gt-mono gt-legend-note">采样周期: 2小时</text>
      </view>

      <!-- 趋势画布 -->
      <view class="gt-chart-area">
        <canvas canvas-id="trendChart" class="trend-canvas" bindtouchstart="onChartTouch"></canvas>
      </view>

      <view class="gt-chart-footnote">
        <text>泵吸式电化学 (分辨率 0.01%)</text>
        <text class="gt-status-ok">符合 GBZ 2.1-2019</text>
      </view>
    </view>

    <!-- 历史复测台账 -->
    <view class="hud-card gt-record-card">
      <view class="flex items-center justify-between">
        <view class="flex items-center gap-2">
          <view class="order-trend-dot"></view>
          <text class="gt-chart-title">历史批次复测台账</text>
        </view>
        <text class="gt-muted gt-mono">已记录 {{records.length}} 次复测</text>
      </view>

      <view class="gt-record-list" wx:if="{{records.length > 0}}">
        <view class="glass-card gt-record-item" wx:for="{{records}}" wx:key="round">
          <view class="flex items-center justify-between">
            <view class="flex items-center gap-2">
              <view class="{{item.isCurrent ? 'chip-gold' : 'chip-titanium'}} gt-round-tag">{{item.label}}</view>
              <text class="gt-mono gt-time">{{item.time}}</text>
            </view>
            <view class="chip-cyan gt-pass-badge">
              <view class="dot-green-xs"></view>
              <text>{{item.status}}</text>
            </view>
          </view>
          <view class="gt-record-grid">
            <view class="flex flex-col">
              <text class="gt-muted">化验人员</text>
              <text class="gt-record-val">{{item.personnel}}</text>
            </view>
            <view class="flex flex-col">
              <text class="gt-muted">采样空间点</text>
              <text class="gt-record-val">{{item.samplingPoint}}</text>
            </view>
            <view class="flex flex-col items-end">
              <text class="gt-muted">仪器编号</text>
              <text class="text-sky gt-mono">{{item.instrument}}</text>
            </view>
          </view>
        </view>
      </view>
      <view wx:else class="empty-state">
        <text class="empty-icon">📈</text>
        <text class="empty-text">暂无复测记录</text>
      </view>
    </view>

    <!-- 底部操作 -->
    <view class="gt-actions">
      <view class="glass-card gt-action-export" bindtap="exportLedger">
        <text>💾</text>
        <text class="gt-action-text">导出台账</text>
      </view>
      <view class="btn-gold gt-action-next" bindtap="startNextRound">
        <text>发起第 {{currentRound + 1}} 轮现场复测</text>
        <text class="gt-action-arrow">→</text>
      </view>
    </view>

    <view class="safe-bottom"></view>
  </block>

  <!-- 隐藏 canvas 用于导出 -->
  <canvas canvas-id="exportCanvas" class="hidden-export-canvas" style="width:750px;height:500px;"></canvas>
</view>
