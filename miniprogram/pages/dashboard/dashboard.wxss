/* ========================================================
   明亮玻璃科技风 - 智检安枢小程序工作台
   配色：主色 #3B82F6、点缀青 #06B6D4、成功 #10B981、警告 #F59E0B、危险 #EF4444
   卡片：白底圆角 16rpx、轻阴影 (0 4rpx 12rpx rgba(15,23,42,0.06))、细边框 #E2E8F0
======================================================== */

/* 一、用户信息卡（顶部） */
.role-banner {
  position: relative;
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 1rpx solid #E2E8F0;
  padding: 24rpx;
  margin: 20rpx 24rpx 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.06);
  overflow: hidden;
}
.banner-top-accent {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #3B82F6 0%, #06B6D4 100%);
}
.role-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.role-avatar-box {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.role-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 2rpx solid #E2E8F0;
  background: #F8FAFC;
  display: block;
}
.role-online-dot {
  position: absolute;
  bottom: 2rpx;
  right: 2rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #10B981;
  border: 3rpx solid #FFFFFF;
}
.role-user-info {
  flex: 1;
  min-width: 0;
}
.role-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}
.role-user-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #0F172A;
  line-height: 1.2;
}
.role-badge {
  background: rgba(59, 130, 246, 0.08);
  color: #2563EB;
  border: 1rpx solid rgba(59, 130, 246, 0.25);
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  white-space: nowrap;
}
.role-meta-row {
  font-size: 22rpx;
  color: #64748B;
  margin-bottom: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.role-dot-sep {
  margin: 0 6rpx;
  color: #CBD5E1;
}
.role-tip-text {
  font-size: 20rpx;
  color: #94A3B8;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.role-action-btn {
  background: rgba(6, 182, 212, 0.06);
  color: #0891B2;
  border: 1rpx solid rgba(6, 182, 212, 0.35);
  border-radius: 32rpx;
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 18rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin: 0;
  line-height: 1.4;
  flex-shrink: 0;
}
.role-action-btn::after {
  border: none;
}
.role-action-arrow {
  font-size: 26rpx;
  line-height: 1;
}

/* 二、三个功能模块（待审核 / 态势感知 / 安全合规）: 等宽三列卡片 */
.role-cards-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #E2E8F0;
}
.role-card-item {
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  border-radius: 14rpx;
  padding: 16rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.role-card-icon-base {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}
.role-card-icon {
  line-height: 1;
}
.role-card-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #1E293B;
  margin-bottom: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
}
.role-card-count {
  font-size: 28rpx;
  font-weight: 800;
  font-family: "DIN Alternate", -apple-system, sans-serif;
  margin-bottom: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
}
.role-card-desc-line {
  font-size: 20rpx;
  color: #64748B;
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
}

/* 三、紧急告警条 */
.urgent-banner {
  margin: 0 24rpx 20rpx;
  background: linear-gradient(135deg, #EF4444 0%, #DC2626 100%);
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(239, 68, 68, 0.2);
}
.urgent-icon {
  font-size: 30rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}
.urgent-body {
  flex: 1;
  min-width: 0;
}
.urgent-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.3;
}
.urgent-sub {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.3;
}
.urgent-arrow {
  color: rgba(255, 255, 255, 0.9);
  font-size: 32rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
  line-height: 1;
}

/* 四、四个数据统计卡（设备总数/在办检修工单/在控特种票/今日点检）: 2×2 网格 */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin: 0 24rpx 20rpx;
}
.kpi-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 1rpx solid #E2E8F0;
  padding: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.06);
  display: flex;
  flex-direction: column;
}
.kpi-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.kpi-glass-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  flex-shrink: 0;
}
.kpi-label {
  font-size: 20rpx;
  color: #64748B;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.kpi-label-tight {
  font-size: 19rpx;
}
.kpi-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #0F172A;
  font-family: "DIN Alternate", -apple-system, sans-serif;
  line-height: 1.15;
  margin-bottom: 8rpx;
}
.kpi-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: #64748B;
  margin-left: 6rpx;
}
.kpi-status-row {
  font-size: 20rpx;
  color: #64748B;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.text-blue { color: #3B82F6; }
.text-emerald { color: #10B981; }
.text-amber { color: #F59E0B; }
.text-rose { color: #EF4444; }
.text-cyan { color: #06B6D4; }
.font-bold { font-weight: 700; }

/* 五、系统通知中心 */
.notif-card {
  margin: 0 24rpx 20rpx !important;
  padding: 20rpx 24rpx !important;
  border-radius: 16rpx !important;
}
.notif-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #F1F5F9;
}
.notif-header-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.notif-unread-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #EF4444;
}
.notif-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #0F172A;
}
.notif-header-right {
  font-size: 22rpx;
  color: #94A3B8;
}
.notif-list {
  margin-top: 8rpx;
}
.notif-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
}
.notif-item:last-child {
  border-bottom: none;
  padding-bottom: 4rpx;
}
.notif-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  flex-shrink: 0;
}
.notif-content {
  flex: 1;
  min-width: 0;
}
.notif-item-title {
  font-size: 24rpx;
  color: #1E293B;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.35;
}
.notif-item-time {
  font-size: 20rpx;
  color: #94A3B8;
  margin-top: 4rpx;
}
.notif-badge {
  font-size: 18rpx;
  color: #2563EB;
  background: rgba(59, 130, 246, 0.08);
  border: 1rpx solid rgba(59, 130, 246, 0.25);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* 全厂实时检修工单态势 */
.order-trend-card {
  margin: 0 24rpx 20rpx !important;
  padding: 20rpx 24rpx !important;
  border-radius: 16rpx !important;
}
.order-trend-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #F1F5F9;
}
.order-trend-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.order-trend-dot {
  width: 6rpx;
  height: 24rpx;
  border-radius: 3rpx;
  background: #3B82F6;
}
.order-trend-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #0F172A;
}
.order-trend-more {
  font-size: 22rpx;
  color: #3B82F6;
  font-weight: 500;
}
.order-trend-list {
  margin-top: 6rpx;
}
.order-row-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
}
.order-row-item:last-child {
  border-bottom: none;
  padding-bottom: 4rpx;
}
.order-info-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}
.order-code {
  font-size: 22rpx;
  color: #2563EB;
  font-family: "DIN Alternate", monospace;
  font-weight: 700;
  flex-shrink: 0;
}
.order-desc {
  font-size: 24rpx;
  color: #1E293B;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
}
.order-status-capsule {
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
  flex-shrink: 0;
  line-height: 1.3;
}
.order-empty {
  text-align: center;
  padding: 40rpx 20rpx;
  font-size: 24rpx;
  color: #94A3B8;
}

/* 栏目标题 */
.section-title-row {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  margin-bottom: 16rpx;
}
.section-title-dot {
  width: 6rpx;
  height: 24rpx;
  border-radius: 3rpx;
  background: #06B6D4;
  margin-right: 10rpx;
}
.section-title-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #0F172A;
}

/* 快捷功能九宫格矩阵 */
.grid-menu {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  padding: 0 24rpx;
}
.menu-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 1rpx solid #E2E8F0;
  padding: 20rpx 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.06);
  display: flex;
  align-items: center;
}
.menu-glass-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}
.menu-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #1E293B;
}

.retry {
  margin: 20rpx auto;
  width: 240rpx;
}
