/* ========================================================
   工作台 · Bright Game-HUD / Solar-Punk（与 Web 端 src/index.css 同步）
   金 #E8A33D / 天青 #0EA5E9 / 钛晶 #DCE6F2 / 玻璃磨砂 + 金青细描边
   ======================================================== */

/* 一、用户信息卡（顶部） */
.role-banner {
  position: relative;
  padding: 28rpx;
  margin: 20rpx 24rpx;
}
.role-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.role-avatar-box {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.role-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 3rpx solid #F6D08A;
  box-shadow: 0 0 0 4rpx rgba(232, 163, 61, 0.18), 0 4rpx 12rpx -4rpx rgba(232, 163, 61, 0.35);
  background: #F8FAFC;
  display: block;
}
.role-online-dot {
  position: absolute;
  bottom: 2rpx;
  right: 2rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #10B981;
  border: 3rpx solid #FFFFFF;
}
.role-user-info {
  flex: 1;
  min-width: 0;
}
.role-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}
.role-user-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #0F172A;
  line-height: 1.2;
}
.role-badge {
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  flex-shrink: 0;
}
.role-meta-row {
  font-size: 22rpx;
  color: #64748B;
  margin-bottom: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.role-dot-sep {
  margin: 0 6rpx;
  color: #CBD5E1;
}
.role-tip-text {
  font-size: 20rpx;
  color: #94A3B8;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.role-action-btn {
  padding: 10rpx 22rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}
.role-action-arrow {
  font-size: 26rpx;
  line-height: 1;
}

/* 二、三个功能模块：等宽三列玻璃卡 */
.role-cards-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  padding-top: 22rpx;
  border-top: 1rpx dashed rgba(220, 230, 242, 0.9);
}
.role-card-item {
  padding: 18rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.role-card-icon-base {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  margin-bottom: 10rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}
.role-card-icon {
  line-height: 1;
}
.role-card-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #1E293B;
  margin-bottom: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
}
.role-card-count {
  font-size: 28rpx;
  font-weight: 800;
  font-family: "DIN Alternate", -apple-system, sans-serif;
  margin-bottom: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
}
.role-card-desc-line {
  font-size: 20rpx;
  color: #64748B;
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
}

/* 三、紧急告警条（危险红渐变 + 描边光晕） */
.urgent-banner {
  margin: 0 24rpx 20rpx;
  background: linear-gradient(135deg, #EF4444 0%, #DC2626 100%);
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
  display: flex;
  align-items: center;
  box-shadow:
    0 0 0 1rpx rgba(239, 68, 68, 0.35),
    0 8rpx 22rpx -8rpx rgba(239, 68, 68, 0.45),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.25);
}
.urgent-icon {
  font-size: 30rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}
.urgent-body {
  flex: 1;
  min-width: 0;
}
.urgent-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.3;
}
.urgent-sub {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.3;
}
.urgent-arrow {
  color: rgba(255, 255, 255, 0.9);
  font-size: 32rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
  line-height: 1;
}

/* 四、四个数据统计卡：2×2 HUD 网格 */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin: 0 24rpx 20rpx;
}
.kpi-card {
  padding: 22rpx;
  display: flex;
  flex-direction: column;
}
.kpi-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.kpi-label-tight {
  font-size: 19rpx;
}
.kpi-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #0F172A;
  font-family: "DIN Alternate", -apple-system, sans-serif;
  line-height: 1.15;
  margin-bottom: 8rpx;
}
.kpi-status-row {
  font-size: 20rpx;
  color: #64748B;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.font-bold { font-weight: 700; }

/* 五、系统通知中心 */
.notif-card {
  margin: 0 24rpx 20rpx;
  padding: 24rpx 28rpx;
}
.notif-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid rgba(220, 230, 242, 0.8);
}
.notif-header-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.notif-unread-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #E8A33D;
  box-shadow: 0 0 0 4rpx rgba(232, 163, 61, 0.2);
}
.notif-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #0F172A;
}
.notif-header-right {
  font-size: 22rpx;
  color: #94A3B8;
}
.notif-list {
  margin-top: 8rpx;
}
.notif-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(220, 230, 242, 0.6);
}
.notif-item:last-child {
  border-bottom: none;
  padding-bottom: 4rpx;
}
.notif-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  flex-shrink: 0;
}
.notif-content {
  flex: 1;
  min-width: 0;
}
.notif-item-title {
  font-size: 24rpx;
  color: #1E293B;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.35;
}
.notif-item-time {
  font-size: 20rpx;
  color: #94A3B8;
  margin-top: 4rpx;
}
.notif-badge {
  font-size: 18rpx;
  color: #B8761F;
  background: rgba(232, 163, 61, 0.12);
  border: 1rpx solid rgba(232, 163, 61, 0.38);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* 全厂实时检修工单态势 */
.order-trend-card {
  margin: 0 24rpx 20rpx;
  padding: 24rpx 28rpx;
}
.order-trend-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid rgba(220, 230, 242, 0.8);
}
.order-trend-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}
.order-trend-dot {
  width: 6rpx;
  height: 24rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, #E8A33D 0%, #0EA5E9 100%);
  flex-shrink: 0;
}
.order-trend-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #0F172A;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.order-trend-more {
  font-size: 22rpx;
  color: #0EA5E9;
  font-weight: 500;
  flex-shrink: 0;
}
.order-trend-list {
  margin-top: 6rpx;
}
.order-row-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(220, 230, 242, 0.6);
}
.order-row-item:last-child {
  border-bottom: none;
  padding-bottom: 4rpx;
}
.order-info-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}
.order-code {
  font-size: 22rpx;
  color: #B8761F;
  font-family: "DIN Alternate", monospace;
  font-weight: 700;
  flex-shrink: 0;
  background: rgba(232, 163, 61, 0.1);
  border: 1rpx solid rgba(232, 163, 61, 0.3);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}
.order-desc {
  font-size: 24rpx;
  color: #1E293B;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
}
.order-status-capsule {
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
  flex-shrink: 0;
  line-height: 1.3;
}
.order-empty {
  text-align: center;
  padding: 40rpx 20rpx;
  font-size: 24rpx;
  color: #94A3B8;
}

/* 快捷功能九宫格矩阵 */
.grid-menu {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  padding: 0 24rpx;
}
.menu-item {
  padding: 22rpx 18rpx;
  display: flex;
  align-items: center;
}
.menu-glass-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}
.menu-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #1E293B;
}

.retry {
  margin: 20rpx auto;
  width: 240rpx;
}

/* 加载动画 */
.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid rgba(232, 163, 61, 0.2);
  border-top-color: #E8A33D;
  border-radius: 50%;
  margin: 0 auto;
  animation: spin 0.9s linear infinite;
}
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
