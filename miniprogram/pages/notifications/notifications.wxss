/* notifications.wxss - 通知中心 · Solar-Punk */

.notif-summary {
  margin: 20rpx 24rpx;
  padding: 22rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.notif-summary-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.notif-unread-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #E8A33D;
  box-shadow: 0 0 0 5rpx rgba(232, 163, 61, 0.2);
}
.notif-summary-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0F172A;
}
.notif-summary-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.notif-count {
  font-size: 22rpx;
  color: #94A3B8;
}
.notif-unread-num {
  font-family: "DIN Alternate", monospace;
}
.markall {
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}

.notif-item {
  margin: 0 24rpx 16rpx;
  padding: 24rpx 28rpx;
  position: relative;
}
.notif-read {
  opacity: 0.6;
}
.notif-item-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.notif-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.notif-item-title {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: #0F172A;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.notif-item-time {
  font-size: 20rpx;
  color: #94A3B8;
  font-family: "DIN Alternate", monospace;
  flex-shrink: 0;
}
.notif-item-content {
  display: block;
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #64748B;
  line-height: 1.6;
}
.notif-item-badge {
  position: absolute;
  top: 22rpx;
  right: 24rpx;
  font-size: 18rpx;
  color: #B8761F;
  background: rgba(232, 163, 61, 0.12);
  border: 1rpx solid rgba(232, 163, 61, 0.38);
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}

/* 空态/加载 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
}
.loading-ring {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid rgba(232, 163, 61, 0.2);
  border-top-color: #E8A33D;
  border-radius: 50%;
  margin-bottom: 24rpx;
  animation: spin 0.9s linear infinite;
}
.empty-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}
.empty-text {
  font-size: 26rpx;
  color: #94A3B8;
}
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
