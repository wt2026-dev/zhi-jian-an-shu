/* graph.wxss - 知识图谱 · Solar-Punk */

/* 顶部 HUD 卡 */
.graph-hero {
  margin: 20rpx 24rpx 0;
  padding: 26rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.hero-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.hero-dot {
  width: 12rpx;
  height: 32rpx;
  border-radius: 6rpx;
  background: linear-gradient(180deg, #E8A33D 0%, #0EA5E9 100%);
}
.hero-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #0F172A;
}
.graph-count {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #64748B;
  font-family: "DIN Alternate", monospace;
}
.count-sep { color: #CBD5E1; }

/* 操作栏 */
.action-bar {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin: 20rpx 24rpx 0;
}
.extract-btn {
  padding: 14rpx 28rpx;
  background: linear-gradient(135deg, #F6D08A 0%, #E8A33D 48%, #D98F2B 100%);
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx -6rpx rgba(232, 163, 61, 0.55);
}
.extract-btn.disabled {
  opacity: 0.5;
}
.extract-msg {
  margin: 16rpx 24rpx 0;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  color: #0B5E7A;
  text-align: center;
}

/* 分组 HUD 卡 */
.type-section {
  margin: 20rpx 24rpx 0;
  padding: 24rpx 28rpx;
}
.type-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid rgba(220, 230, 242, 0.8);
}
.type-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
  box-shadow: 0 0 8rpx rgba(15, 23, 42, 0.2);
}
.type-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #0F172A;
}
.type-count {
  margin-left: auto;
  font-size: 22rpx;
  color: #94A3B8;
  font-family: "DIN Alternate", monospace;
}

.node-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.node-card {
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(220, 230, 242, 0.85);
  border-radius: 14rpx;
  padding: 20rpx;
}
.node-card:active {
  opacity: 0.92;
}
.node-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 4rpx;
}
.node-desc {
  font-size: 22rpx;
  color: #64748B;
  line-height: 1.4;
}
.node-tags {
  display: flex;
  gap: 8rpx;
  margin-top: 8rpx;
}
.node-tag {
  padding: 2rpx 12rpx;
  background: rgba(14, 165, 233, 0.1);
  border: 1rpx solid rgba(14, 165, 233, 0.28);
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #0B5E7A;
}

/* 加载 / 空态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
}
.loading-ring {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid rgba(232, 163, 61, 0.2);
  border-top-color: #E8A33D;
  border-radius: 50%;
  margin-bottom: 24rpx;
  animation: spin 0.9s linear infinite;
}
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.empty-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}
.retry-btn {
  margin-top: 24rpx;
  padding: 14rpx 44rpx;
  background: linear-gradient(135deg, #F6D08A 0%, #E8A33D 48%, #D98F2B 100%);
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
}

/* 抽屉 */
.drawer-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  backdrop-filter: blur(4rpx);
  z-index: 100;
}
.drawer {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: linear-gradient(180deg, #FFFFFF 0%, #F8FBFF 100%);
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom, 20rpx));
  box-shadow: 0 -8rpx 30rpx -10rpx rgba(15, 23, 42, 0.25);
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s;
  max-height: 70vh;
  overflow-y: auto;
}
.drawer-show {
  transform: translateY(0);
}
.drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.drawer-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0F172A;
}
.drawer-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #94A3B8;
  background: rgba(220, 230, 242, 0.5);
  border-radius: 50%;
}

.detail-row {
  margin-bottom: 16rpx;
}
.detail-label {
  font-size: 22rpx;
  color: #94A3B8;
  display: block;
  margin-bottom: 4rpx;
}
.detail-value {
  font-size: 26rpx;
  color: #1E293B;
  line-height: 1.5;
}

.related-section {
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(220, 230, 242, 0.8);
}
.related-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.related-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  background: rgba(242, 247, 253, 0.8);
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #1E293B;
}
.edge-label {
  font-size: 20rpx;
  color: #0EA5E9;
  flex-shrink: 0;
}
