.graph-page {
  padding: 24rpx;
  padding-bottom: 120rpx;
}
.page-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1E293B;
  margin-bottom: 24rpx;
}

.action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.extract-btn {
  padding: 10rpx 24rpx;
  background: #3b82f6;
  color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.extract-btn.disabled {
  opacity: 0.5;
}
.extract-msg {
  background: #EFF6FF;
  color: #3b82f6;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  margin-bottom: 16rpx;
  text-align: center;
}

.type-section {
  margin-bottom: 24rpx;
}
.type-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.type-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
}
.type-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
}
.type-count {
  font-size: 22rpx;
  color: #94A3B8;
}

.node-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.node-card {
  background: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  border-radius: 14rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.node-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 4rpx;
}
.node-desc {
  font-size: 22rpx;
  line-height: 1.4;
}
.node-tags {
  display: flex;
  gap: 8rpx;
  margin-top: 8rpx;
}
.node-tag {
  padding: 2rpx 12rpx;
  background: #F1F5F9;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #64748B;
}

/* 抽屉 */
.drawer-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
}
.drawer {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom, 20rpx));
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s;
  max-height: 70vh;
  overflow-y: auto;
}
.drawer-show {
  transform: translateY(0);
}
.drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.drawer-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E293B;
}
.drawer-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #94A3B8;
  background: #F1F5F9;
  border-radius: 50%;
}

.detail-row {
  margin-bottom: 16rpx;
}
.detail-label {
  font-size: 22rpx;
  color: #94A3B8;
  display: block;
  margin-bottom: 4rpx;
}
.detail-value {
  font-size: 26rpx;
  color: #1E293B;
  line-height: 1.5;
}

.related-section {
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F1F5F9;
}
.related-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.related-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx;
  background: #F8FAFC;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #1E293B;
}
.edge-label {
  font-size: 20rpx;
}
