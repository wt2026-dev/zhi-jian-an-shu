<!-- 知识库 RAG 检索 · Solar-Punk（玻璃搜索条 + glass-card 结果） -->
<view class="fx-bg">
  <view class="fx-hex"></view>
  <view class="fx-particles"></view>
  <view class="fx-bloom"></view>
</view>

<view class="page-body">
  <!-- 搜索条 -->
  <view class="searchbar glass-card">
    <view class="search-icon">🔍</view>
    <input class="search-input" placeholder="语义检索检修规程 / 故障案例" placeholder-class="search-ph" value="{{kw}}" bindinput="onKw" confirm-type="search" bindconfirm="doSearch" />
    <view class="btn-gold search-btn" bindtap="doSearch">检索</view>
  </view>

  <view wx:if="{{loading}}" class="empty-state">
    <view class="loading-ring"></view>
    <text class="empty-text">知识向量检索中...</text>
  </view>
  <view wx:elif="{{results.length === 0}}" class="empty-state">
    <text class="empty-icon">📚</text>
    <text class="empty-text">暂无结果，换个关键词试试</text>
  </view>

  <view class="glass-card result-card" wx:for="{{results}}" wx:key="id" bindtap="toggle" data-idx="{{index}}">
    <view class="result-head">
      <view class="result-title">{{item.title}}</view>
      <view class="chip-cyan result-cat">{{item.category}}</view>
    </view>
    <view class="result-summary">{{item.summary}}</view>
    <rich-text wx:if="{{item.expanded}}" class="result-content" nodes="{{item.html || item.content}}" user-select />
    <view class="result-toggle">{{item.expanded ? "收起 ▲" : "展开全文 ▼"}}</view>
  </view>
  <view class="safe-bottom"></view>
</view>
