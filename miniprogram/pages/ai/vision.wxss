/* vision.wxss - AI 视觉识别 · Solar-Punk */

.vision-card {
  margin: 20rpx 24rpx 0;
  padding: 28rpx;
}
.vision-sub {
  font-size: 22rpx;
  color: #64748B;
  margin: 4rpx 0 24rpx;
}
.vision-btn {
  margin-bottom: 24rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
}
.preview-img {
  width: 100%;
  border-radius: 20rpx;
  border: 1rpx solid rgba(220, 230, 242, 0.9);
  margin-bottom: 24rpx;
}

/* 加载 */
.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}
.loading-ring {
  width: 48rpx;
  height: 48rpx;
  border: 6rpx solid rgba(232, 163, 61, 0.2);
  border-top-color: #E8A33D;
  border-radius: 50%;
  margin-bottom: 16rpx;
  animation: spin 0.9s linear infinite;
}
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.loading-text {
  font-size: 22rpx;
  color: #0EA5E9;
  text-align: center;
}

/* 结果头 */
.result-header {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}
.sev-badge {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  font-weight: 700;
  border-radius: 999rpx;
}
.conf-text {
  font-size: 22rpx;
  color: #64748B;
}
.conf-num {
  font-family: "DIN Alternate", monospace;
  font-weight: 700;
  color: #B8761F;
}

.defect-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #0F172A;
  margin-bottom: 10rpx;
}
.defect-summary {
  font-size: 26rpx;
  color: #334155;
  line-height: 1.5;
  margin-bottom: 16rpx;
}
.kv-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 18rpx;
  background: rgba(242, 247, 253, 0.8);
  border: 1rpx solid rgba(220, 230, 242, 0.7);
  border-radius: 12rpx;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}
.kv-label { color: #64748B; }
.kv-val { color: #0F172A; font-weight: 600; }

.detail-section {
  margin-top: 16rpx;
}
.section-sub-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1E293B;
  margin-bottom: 8rpx;
}
.desc-item {
  font-size: 24rpx;
  color: #475569;
  line-height: 1.6;
  margin-bottom: 6rpx;
}

.warn-box {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(251, 191, 36, 0.14) 0%, rgba(232, 163, 61, 0.12) 100%);
  border: 1rpx solid rgba(232, 163, 61, 0.4);
}
.warn-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #8A5410;
  margin-bottom: 6rpx;
}
.warn-content {
  font-size: 22rpx;
  color: #92400E;
  line-height: 1.5;
}

.action-btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.half-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 0;
  font-size: 26rpx;
}
.half-btn-danger {
  background: linear-gradient(135deg, #EF4444 0%, #DC2626 100%);
  color: #FFFFFF;
  border-radius: 999rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx -6rpx rgba(239, 68, 68, 0.5);
}

/* 相似案例区 */
.similar-section {
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed rgba(220, 230, 242, 0.9);
}
.similar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.similar-badge {
  font-size: 26rpx;
  font-weight: 700;
  color: #8A5410;
}
.similar-count {
  font-size: 20rpx;
  color: #64748B;
  font-family: "DIN Alternate", monospace;
}
.empty-cases {
  font-size: 22rpx;
  color: #94A3B8;
  padding: 20rpx 0;
  text-align: center;
}
.case-card {
  padding: 16rpx;
  margin-bottom: 12rpx;
}
.case-card:active {
  opacity: 0.92;
}
.case-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #0F172A;
  margin-bottom: 6rpx;
}
.case-summary {
  font-size: 22rpx;
  color: #64748B;
  line-height: 1.4;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.case-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 20rpx;
}
.case-category {
  color: #0B5E7A;
  background: rgba(14, 165, 233, 0.1);
  border: 1rpx solid rgba(14, 165, 233, 0.32);
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
}
.case-link {
  color: #0EA5E9;
  font-weight: 600;
}

.error-box {
  margin-top: 20rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: rgba(239, 68, 68, 0.08);
  border: 1rpx solid rgba(239, 68, 68, 0.3);
  color: #EF4444;
  font-size: 24rpx;
}
