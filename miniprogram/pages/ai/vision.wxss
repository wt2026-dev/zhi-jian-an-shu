.vision-card {
  margin: 24rpx !important;
  padding: 28rpx !important;
  background: #FFFFFF !important;
  border-radius: 24rpx !important;
  border: 1rpx solid #E2E8F0 !important;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04) !important;
}
.vision-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #0F172A;
  margin-bottom: 6rpx;
}
.vision-sub {
  font-size: 22rpx;
  color: #64748B;
  margin-bottom: 24rpx;
}
.vision-btn {
  margin-bottom: 24rpx;
}
.preview-img {
  width: 100%;
  border-radius: 20rpx;
  border: 1rpx solid #E2E8F0;
  margin-bottom: 24rpx;
}
.result-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.sev-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  font-weight: 700;
}
.conf-text {
  font-size: 22rpx;
  color: #64748B;
  font-family: "DIN Alternate", monospace;
}
.defect-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #0F172A;
  margin-bottom: 10rpx;
}
.defect-summary {
  font-size: 26rpx;
  color: #334155;
  line-height: 1.5;
  margin-bottom: 16rpx;
}
.kv-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 16rpx;
  background: #F8FAFC;
  border-radius: 12rpx;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}
.kv-label { color: #64748B; }
.kv-val { color: #0F172A; font-weight: 600; }

.detail-section {
  margin-top: 16rpx;
}
.section-sub-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1E293B;
  margin-bottom: 8rpx;
}
.desc-item {
  font-size: 24rpx;
  color: #475569;
  line-height: 1.6;
  margin-bottom: 6rpx;
}
.warn-box {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #FEF3C7;
  border: 1rpx solid #FDE68A;
}
.warn-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #B45309;
  margin-bottom: 6rpx;
}
.warn-content {
  font-size: 22rpx;
  color: #92400E;
  line-height: 1.5;
}

.action-btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.half-btn {
  flex: 1;
  margin: 0 !important;
  font-size: 26rpx !important;
  padding: 18rpx 0 !important;
}

/* 相似案例区 */
.similar-section {
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #E2E8F0;
}
.similar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.similar-badge {
  font-size: 26rpx;
  font-weight: 700;
  color: #2563EB;
}
.similar-count {
  font-size: 20rpx;
  color: #64748B;
}
.empty-cases {
  font-size: 22rpx;
  color: #94A3B8;
  padding: 20rpx 0;
  text-align: center;
}
.case-card {
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}
.case-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #0F172A;
  margin-bottom: 6rpx;
}
.case-summary {
  font-size: 22rpx;
  color: #64748B;
  line-height: 1.4;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.case-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 20rpx;
}
.case-category {
  color: #3B82F6;
  background: #EFF6FF;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.case-link {
  color: #3B82F6;
  font-weight: 600;
}
