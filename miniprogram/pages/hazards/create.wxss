/* pages/hazards/create.wxss · Solar-Punk Bright Game-HUD */
page {
  background: linear-gradient(180deg, #F8FBFF 0%, #F1F7FE 55%, #F7F4FF 100%);
  background-color: #F2F7FD;
  min-height: 100vh;
}

.page-body { padding: 20rpx 24rpx 40rpx; }

.form-card { padding: 30rpx; }
.form-title { font-size: 32rpx; font-weight: 800; color: #0F172A; }
.form-sub { font-size: 21rpx; color: #64748B; margin-top: 8rpx; margin-bottom: 24rpx; }

.form-item { margin-bottom: 24rpx; }
.label { font-size: 24rpx; color: #1E293B; margin-bottom: 12rpx; font-weight: 600; }
.required { color: #EF4444; }

/* 玻璃输入 */
.glass-input {
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid #DCE6F2;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  font-size: 25rpx;
  color: #0F172A;
}
.input-placeholder { color: #94A3B8; font-size: 24rpx; }
.glass-textarea {
  width: 100%;
  height: 180rpx;
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid #DCE6F2;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  font-size: 24rpx;
  color: #0F172A;
  box-sizing: border-box;
}
.picker-line { display: flex; align-items: center; justify-content: space-between; }
.picker-val { color: #0F172A; font-weight: 600; }
.picker-arrow { color: #94A3B8; font-size: 22rpx; }

/* 拍照 */
.photo-box {
  width: 100%;
  height: 220rpx;
  background: rgba(241, 247, 254, 0.8);
  border: 2rpx dashed #B6C6DC;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.photo-preview { width: 100%; height: 100%; }
.photo-placeholder { display: flex; flex-direction: column; align-items: center; }
.camera-icon { font-size: 56rpx; margin-bottom: 10rpx; }
.photo-hint { font-size: 22rpx; color: #94A3B8; }

.btn-submit {
  width: 100%;
  height: 92rpx;
  border-radius: 16rpx;
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx -8rpx rgba(232, 163, 61, 0.6);
}
.btn-submit::after { border: none; }
.btn-submit[disabled] { opacity: 0.6; }
