.container {
  padding: 24rpx;
  background-color: #F5F7FA;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #FFFFFF;
  border: 1px solid #E2E8F0;
  border-radius: 20rpx;
  padding: 30rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.label {
  font-size: 24rpx;
  color: #1E293B;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.required {
  color: #f43f5e;
}

.input, .picker-val {
  background: #F8FAFC;
  border: 1px solid #E2E8F0;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #1E293B;
}

.textarea {
  width: 100%;
  height: 160rpx;
  background: #F8FAFC;
  border: 1px solid #E2E8F0;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #1E293B;
  box-sizing: border-box;
}

.photo-box {
  width: 100%;
  height: 200rpx;
  background: #F8FAFC;
  border: 2rpx dashed #CBD5E1;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.photo-preview {
  width: 100%;
  height: 100%;
}

.photo-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.camera-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.photo-hint {
  font-size: 22rpx;
  color: #94A3B8;
}

.btn-submit {
  background: linear-gradient(135deg, #f43f5e 0%, #e11d48 100%);
  color: #1E293B;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 14rpx;
  margin-top: 30rpx;
  padding: 20rpx 0;
  border: none;
}
