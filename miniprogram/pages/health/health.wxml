<!-- 健康监测 · Solar-Punk（与 Web 端设备健康视图同步） -->
<view class="fx-bg">
  <view class="fx-hex"></view>
  <view class="fx-particles"></view>
  <view class="fx-bloom"></view>
</view>

<view class="page-body">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-state">
    <view class="loading-ring"></view>
    <text class="loading-text">加载设备健康监测中...</text>
  </view>

  <!-- 加载失败 -->
  <view wx:elif="{{loadError}}" class="error-state">
    <text class="error-icon">⚠️</text>
    <text class="error-text">{{loadError}}</text>
    <view class="retry-btn" bindtap="loadEquipments">重试</view>
  </view>

  <block wx:else>
    <!-- 页面标题 -->
    <view class="section-title-row page-head">
      <view class="section-title-dot"></view>
      <view class="section-title-text">健康监测</view>
      <view class="section-title-sub">设备劣化预警</view>
    </view>

    <!-- 设备横滑选择条（玻璃 chip） -->
    <scroll-view scroll-x class="eq-scroll">
      <view class="eq-chip {{selectedEq && selectedEq.id === item.id ? 'eq-chip-active' : ''}}"
        wx:for="{{equipments}}" wx:key="id" bindtap="selectEquipment" data-id="{{item.id}}">
        <view class="eq-chip-dot" style="background:{{item.statusColor}}"></view>
        <text>{{item.name || item.code}}</text>
      </view>
    </scroll-view>

    <!-- 设备健康概览（HUD 主卡） -->
    <view class="hud-card health-hero" wx:if="{{selectedEq}}">
      <view class="hud-accent-top"></view>
      <view class="eq-header">
        <view class="eq-header-left">
          <view class="eq-name">{{selectedEq.name || selectedEq.code}}</view>
          <view class="eq-workshop">{{selectedEq.workshop || "未知车间"}}</view>
        </view>
        <view class="eq-score" style="color:{{selectedEq.statusColor}}">{{selectedEq.scoreText}}</view>
      </view>
      <view class="score-bar">
        <view class="score-fill" style="width:{{selectedEq.isScored ? selectedEq.healthScore : 0}}%;background:{{selectedEq.statusColor}}"></view>
      </view>
      <view wx:if="{{!selectedEq.isScored}}" class="score-unscored-tip">未评估（暂无健康分数据）</view>
      <view class="eq-meta">
        <view class="meta-item">
          <text class="meta-label">状态</text>
          <text class="meta-value" style="color:{{selectedEq.statusColor}}">{{selectedEq.statusText}}</text>
        </view>
        <view class="meta-item">
          <text class="meta-label">类型</text>
          <text class="meta-value">{{selectedEq.type || "—"}}</text>
        </view>
        <view class="meta-item">
          <text class="meta-label">位置</text>
          <text class="meta-value">{{selectedEq.location || "—"}}</text>
        </view>
      </view>
    </view>

    <!-- 遥测数据（玻璃卡） -->
    <view class="section-title-row">
      <view class="section-title-dot"></view>
      <view class="section-title-text">遥测数据</view>
      <view class="section-title-sub">近 20 条采样</view>
    </view>
    <view class="glass-card tele-card">
      <view wx:if="{{loadingTelemetry}}" class="tele-soft">加载中...</view>
      <view wx:elif="{{telemetry.length === 0}}" class="tele-soft">暂无遥测数据</view>
      <block wx:else>
        <view class="telemetry-item" wx:for="{{telemetry}}" wx:key="time">
          <view class="telemetry-time">{{item.time || item.timestamp || "—"}}</view>
          <view class="telemetry-values">
            <text wx:if="{{item.temperature}}">🌡️ {{item.temperature}}°C</text>
            <text wx:if="{{item.vibration}}">📳 {{item.vibration}}mm/s</text>
            <text wx:if="{{item.current}}">⚡ {{item.current}}A</text>
            <text wx:if="{{item.voltage}}">🔌 {{item.voltage}}V</text>
            <text wx:if="{{item.loadRate}}">📊 {{item.loadRate}}%</text>
          </view>
        </view>
      </block>
    </view>
    <view class="safe-bottom"></view>
  </block>
</view>
