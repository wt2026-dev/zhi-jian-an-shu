<view wx:if="{{loading}}" class="empty">加载中...</view>
<view wx:elif="{{loadError}}" class="empty">
  <view>{{loadError}}</view>
  <button class="btn btn-ghost" style="margin:30rpx auto;width:300rpx" bindtap="loadEquipments">重试</button>
</view>
<block wx:else>
  <view class="health-page">
    <view class="page-title">健康监测</view>

    <!-- 设备列表 -->
    <scroll-view scroll-x class="eq-scroll">
      <view class="eq-chip {{selectedEq && selectedEq.id === item.id ? 'eq-chip-active' : ''}}"
        wx:for="{{equipments}}" wx:key="id" bindtap="selectEquipment" data-id="{{item.id}}">
        <view class="eq-chip-dot" style="background:{{item.statusColor}}"></view>
        <text>{{item.name || item.code}}</text>
      </view>
    </scroll-view>

    <!-- 设备健康概览 -->
    <view class="section-card" wx:if="{{selectedEq}}">
      <view class="eq-header">
        <view>
          <view class="eq-name">{{selectedEq.name || selectedEq.code}}</view>
          <view class="muted">{{selectedEq.workshop || "未知车间"}}</view>
        </view>
        <view class="eq-score" style="color:{{selectedEq.statusColor}}">{{selectedEq.scoreText}}</view>
      </view>
      <view class="score-bar">
        <view class="score-fill" style="width:{{selectedEq.healthScore || 0}}%;background:{{selectedEq.statusColor}}"></view>
      </view>
      <view class="eq-meta">
        <view class="meta-item">
          <text class="meta-label">状态</text>
          <text class="meta-value" style="color:{{selectedEq.statusColor}}">{{selectedEq.statusText}}</text>
        </view>
        <view class="meta-item">
          <text class="meta-label">类型</text>
          <text class="meta-value">{{selectedEq.type || "—"}}</text>
        </view>
        <view class="meta-item">
          <text class="meta-label">位置</text>
          <text class="meta-value">{{selectedEq.location || "—"}}</text>
        </view>
      </view>
    </view>

    <!-- 遥测数据 -->
    <view class="section-card">
      <view class="section-title" style="margin:0 0 16rpx">遥测数据</view>
      <view wx:if="{{loadingTelemetry}}" class="empty" style="padding:40rpx">加载中...</view>
      <view wx:elif="{{telemetry.length === 0}}" class="empty" style="padding:40rpx">暂无遥测数据</view>
      <block wx:else>
        <view class="telemetry-grid">
          <view class="telemetry-item" wx:for="{{telemetry}}" wx:key="time">
            <view class="telemetry-time">{{item.time || item.timestamp || "—"}}</view>
            <view class="telemetry-values">
              <text wx:if="{{item.temperature}}">🌡️ {{item.temperature}}°C</text>
              <text wx:if="{{item.vibration}}">📳 {{item.vibration}}mm/s</text>
              <text wx:if="{{item.current}}">⚡ {{item.current}}A</text>
              <text wx:if="{{item.voltage}}">🔌 {{item.voltage}}V</text>
              <text wx:if="{{item.loadRate}}">📊 {{item.loadRate}}%</text>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>
  <view class="safe-bottom"></view>
</block>
