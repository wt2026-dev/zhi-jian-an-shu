.health-page {
  padding: 24rpx;
  padding-bottom: 120rpx;
}
.page-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1E293B;
  margin-bottom: 24rpx;
}

.eq-scroll {
  white-space: nowrap;
  margin-bottom: 24rpx;
}
.eq-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #64748B;
  margin-right: 12rpx;
  transition: all 0.2s;
}
.eq-chip-active {
  background: #EFF6FF;
  border-color: #3b82f6;
  color: #3b82f6;
  font-weight: 600;
}
.eq-chip-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.section-card {
  background: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.eq-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.eq-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1E293B;
}
.eq-score {
  font-size: 40rpx;
  font-weight: 800;
  font-family: "DIN Alternate", monospace;
}

.score-bar {
  height: 12rpx;
  background: #F1F5F9;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}
.score-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.5s;
}

.eq-meta {
  display: flex;
  gap: 24rpx;
}
.meta-item {
  flex: 1;
}
.meta-label {
  font-size: 20rpx;
  color: #94A3B8;
  display: block;
}
.meta-value {
  font-size: 24rpx;
  color: #1E293B;
  font-weight: 500;
}

.telemetry-grid {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.telemetry-item {
  padding: 16rpx;
  background: #F8FAFC;
  border-radius: 12rpx;
}
.telemetry-time {
  font-size: 20rpx;
  color: #94A3B8;
  margin-bottom: 8rpx;
}
.telemetry-values {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  font-size: 24rpx;
  color: #475569;
  font-weight: 500;
}
