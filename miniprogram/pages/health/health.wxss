/* health/health.wxss - 健康监测 · Solar-Punk */
@import '../../common.wxss';

page {
  background: linear-gradient(180deg, #F8FBFF 0%, #F1F7FE 55%, #F7F4FF 100%);
  background-color: #F2F7FD;
  min-height: 100vh;
}

/* 加载中 / 失败 */
.loading-state, .error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 140rpx 48rpx;
}
.loading-ring {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid rgba(232, 163, 61, 0.2);
  border-top-color: #E8A33D;
  border-radius: 50%;
  margin-bottom: 24rpx;
  animation: spin 0.9s linear infinite;
}
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.loading-text, .error-text {
  font-size: 26rpx;
  color: #94A3B8;
  text-align: center;
}
.error-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}
.retry-btn {
  margin-top: 24rpx;
  padding: 14rpx 44rpx;
  background: linear-gradient(135deg, #F6D08A 0%, #E8A33D 48%, #D98F2B 100%);
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.6), 0 8rpx 20rpx -8rpx rgba(232, 163, 61, 0.55);
}

/* 页面标题 */
.page-head { margin-top: 24rpx; }
.page-body > .section-title-row {
  margin: 24rpx 24rpx 14rpx;
}

/* 设备横滑选择条 */
.eq-scroll {
  white-space: nowrap;
  margin: 0 0 20rpx;
  padding: 0 24rpx;
}
.eq-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(220, 230, 242, 0.9);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #64748B;
  margin-right: 14rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}
.eq-chip-active {
  background: linear-gradient(135deg, #FDF3E0 0%, #FCE9C8 100%);
  border-color: rgba(232, 163, 61, 0.55);
  color: #B8761F;
  font-weight: 700;
  box-shadow: 0 4rpx 14rpx -6rpx rgba(232, 163, 61, 0.5);
}
.eq-chip-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

/* 健康概览主卡 */
.health-hero {
  position: relative;
  margin: 0 24rpx 8rpx;
  padding: 28rpx;
}
.eq-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.eq-header-left { flex: 1; min-width: 0; }
.eq-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #0F172A;
  line-height: 1.3;
}
.eq-workshop {
  font-size: 22rpx;
  color: #64748B;
  margin-top: 6rpx;
}
.eq-score {
  font-size: 48rpx;
  font-weight: 800;
  font-family: "DIN Alternate", monospace;
  line-height: 1;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.score-bar {
  height: 14rpx;
  background: #EEF3F9;
  border-radius: 7rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
  box-shadow: inset 0 1rpx 2rpx rgba(15, 23, 42, 0.06);
}
.score-fill {
  height: 100%;
  border-radius: 7rpx;
  transition: width 0.5s;
}
.score-unscored-tip {
  font-size: 22rpx;
  color: #94A3B8;
  margin-bottom: 20rpx;
}
.eq-meta {
  display: flex;
  gap: 24rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed rgba(220, 230, 242, 0.9);
}
.meta-item { flex: 1; }
.meta-label {
  font-size: 20rpx;
  color: #94A3B8;
  display: block;
  margin-bottom: 6rpx;
}
.meta-value {
  font-size: 24rpx;
  color: #1E293B;
  font-weight: 600;
}

/* 遥测玻璃卡 */
.tele-card {
  margin: 0 24rpx;
  padding: 16rpx 24rpx;
}
.tele-soft {
  padding: 36rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #94A3B8;
}
.telemetry-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(220, 230, 242, 0.6);
}
.telemetry-item:last-child { border-bottom: none; }
.telemetry-time {
  font-size: 20rpx;
  color: #94A3B8;
  font-family: "DIN Alternate", monospace;
  margin-bottom: 8rpx;
}
.telemetry-values {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 20rpx;
  font-size: 24rpx;
  color: #475569;
  font-weight: 600;
}
