<!-- 扫码极速报修 · Solar-Punk Bright Game-HUD -->
<view class="fx-bg">
  <view class="fx-hex"></view>
  <view class="fx-particles"></view>
  <view class="fx-bloom"></view>
</view>

<view class="page-body repair-body">
  <!-- 顶部导航条 -->
  <view class="nav-bar">
    <view class="btn-back" bindtap="onTapBack">
      <text class="back-arrow">‹</text>
      <text class="back-text">返回</text>
    </view>
    <view class="nav-title truncate">
      扫码报修 · {{equipment ? equipment.name : '设备报修'}}
    </view>
  </view>

  <!-- 网络加载中 -->
  <view wx:if="{{loading}}" class="state-loading glass-card">
    <view class="loading-ring"></view>
    <text class="loading-text">正在查询设备台账与报修档案...</text>
  </view>

  <!-- 网络异常 / 失败重试状态 -->
  <view wx:elif="{{networkError}}" class="state-error glass-card">
    <view class="error-icon">!</view>
    <view class="error-title">网络异常或连接超时</view>
    <view class="error-msg">{{networkErrorMsg || '无法连接到检修系统后端服务'}}</view>
    <button class="btn-gold retry-btn" bindtap="retryLoad">点击重新尝试加载</button>
  </view>

  <!-- 成功结果页 -->
  <view wx:elif="{{isSuccess}}">
    <view class="hud-card success-box">
      <view class="hud-accent-top"></view>
      <view class="success-icon">✓</view>
      <view class="success-title">故障报修工单申报成功</view>
      <view class="success-desc">报修单已生成并提交至调度中心，已通知机电保全部待调度处理</view>

      <view class="order-no-box">
        <text class="order-no-label">报修工单号</text>
        <text class="order-no mono">{{createdOrderNo}}</text>
        <button class="btn-copy" bindtap="copyOrderNo">复制单号</button>
      </view>

      <view class="summary-info">
        <view class="sum-row"><text class="sum-lbl">报修设备</text><text class="sum-val">{{equipment.name}}（{{equipment.code}}）</text></view>
        <view class="sum-row"><text class="sum-lbl">安装位置</text><text class="sum-val">{{equipment.workshop}} · {{equipment.location}}</text></view>
        <view class="sum-row"><text class="sum-lbl">故障类别</text><text class="sum-val">{{faultType}}</text></view>
        <view class="sum-row"><text class="sum-lbl">响应级别</text><text class="sum-val text-danger">{{priority}}</text></view>
        <view class="sum-row" wx:if="{{photos.length > 0}}"><text class="sum-lbl">现场照片</text><text class="sum-val">已附带 {{photos.length}} 张凭证照片</text></view>
      </view>

      <button class="btn-gold go-home-btn" bindtap="goBackOrHome">返回工作台</button>
    </view>
  </view>

  <!-- 报修表单 -->
  <view wx:else>
    <!-- 顶部设备信息横幅（HUD 金卡） -->
    <view class="hud-card equip-banner">
      <view class="hud-accent-top"></view>
      <view class="banner-badge">扫码直达设备台账</view>
      <block wx:if="{{equipment}}">
        <view class="equip-name">{{equipment.name}}</view>
        <view class="equip-code mono">设备编码 · {{equipment.code}}</view>
        <view class="equip-meta">所属车间：{{equipment.workshop || '未指定车间'}}</view>
        <view class="equip-meta">安装机位：{{equipment.location || '现场机位'}}</view>
        <view class="equip-meta">型号规格：{{equipment.model || '标准工业型号'}}</view>
        <view class="equip-status-tag {{equipment.status === 'fault' ? 'tag-fault' : (equipment.status === 'warning' ? 'tag-warn' : 'tag-run')}}">
          {{equipment.status === 'fault' ? '● 故障中' : (equipment.status === 'warning' ? '● 预警关注' : '● 在线运行')}}
        </view>
      </block>
      <block wx:elif="{{showManualSelect}}">
        <view class="equip-name equip-name-muted">未匹配到指定设备</view>
        <view class="equip-meta">支持手动选择当前车间及生产机组进行申报：</view>
        <picker bindchange="onSelectEquipment" range="{{equipmentList}}" range-key="name">
          <view class="picker-btn">请点击在此选择设备 ▾</view>
        </picker>
      </block>
    </view>

    <!-- 报修表单卡片 -->
    <view class="glass-card form-card">
      <view class="section-title-row">
        <view class="section-title-dot"></view>
        <view class="section-title-text">故障现场信息申报</view>
      </view>

      <!-- 故障类型分类 -->
      <view class="form-group">
        <text class="field-label">故障现象分类</text>
        <picker bindchange="onFaultTypeChange" range="{{faultTypes}}">
          <view class="form-picker">
            <text class="picker-value">{{faultType}}</text>
            <text class="arrow">▾</text>
          </view>
        </picker>
      </view>

      <!-- 紧急程度选择 -->
      <view class="form-group">
        <text class="field-label">紧急程度选择</text>
        <view class="priority-radio-group">
          <block wx:for="{{priorityOptions}}" wx:key="value">
            <view
              class="priority-radio-item {{priorityValue === item.value ? 'radio-active priority-' + item.value : ''}}"
              data-val="{{item.value}}"
              data-label="{{item.label}}"
              bindtap="onSelectPriorityRadio"
            >
              <view class="radio-indicator"></view>
              <view class="radio-content">
                <text class="radio-title">{{item.label}}</text>
                <text class="radio-desc">{{item.desc}}</text>
              </view>
            </view>
          </block>
        </view>
      </view>

      <!-- 故障现场描述 -->
      <view class="form-group">
        <view class="field-header">
          <text class="field-label">故障现象详细描述 <text class="text-danger">*</text></text>
          <text class="field-tip {{faultDescription.length >= 500 ? 'text-danger' : ''}}">{{faultDescription.length}}/500</text>
        </view>
        <textarea
          class="form-textarea"
          placeholder="请详细描述设备声光报警、轴承异常温升、振动异响、气压失灵或漏油漏水部位（≤500字）..."
          maxlength="500"
          value="{{faultDescription}}"
          bindinput="onInputDescription"
        />
      </view>

      <!-- 现场照片凭证 -->
      <view class="form-group">
        <view class="field-header">
          <text class="field-label">现场照片凭据（最多3张）</text>
          <text class="field-tip">{{photos.length}}/3</text>
        </view>
        <view class="photo-grid">
          <block wx:for="{{photos}}" wx:key="*this">
            <view class="photo-item">
              <image src="{{item}}" mode="aspectFill" class="photo-img" data-src="{{item}}" bindtap="previewPhoto" />
              <view class="photo-del" data-index="{{index}}" bindtap="removePhoto">✕</view>
            </view>
          </block>
          <view wx:if="{{photos.length < 3}}" class="photo-add" bindtap="chooseImage">
            <text class="add-icon">+</text>
            <text class="add-text">拍照 / 相册</text>
          </view>
        </view>
      </view>

      <!-- 联系人与电话 -->
      <view class="form-row">
        <view class="form-col">
          <text class="field-label">申报人员姓名</text>
          <input class="form-input" placeholder="现场操作员/巡检员" value="{{reporterName}}" bindinput="onInputReporter" />
        </view>
        <view class="form-col">
          <text class="field-label">联系电话</text>
          <input class="form-input" type="number" placeholder="手机号便于紧急联络" value="{{reporterPhone}}" bindinput="onInputPhone" />
        </view>
      </view>

      <!-- 提交按钮 -->
      <button
        class="btn-gold btn-submit {{submitting ? 'btn-disabled' : ''}}"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bindtap="handleSubmit"
      >
        {{submitting ? '工单提报加密传输中...' : '立即提交报修 · 通知机电保全部'}}
      </button>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
