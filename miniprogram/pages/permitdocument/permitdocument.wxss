/* permitdocument.wxss - 电子作业票文档 · Solar-Punk */

.page-body {
  padding-bottom: 160rpx;
}

/* 顶部导航条 */
.perm-topbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx 8rpx;
}
.perm-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid #DCE6F2;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.perm-back-arrow {
  color: #B8761F;
  font-size: 34rpx;
  line-height: 1;
}
.perm-topbar-info {
  flex: 1;
  min-width: 0;
}
.perm-topbar-label {
  font-size: 18rpx;
  color: #94A3B8;
  letter-spacing: 1rpx;
}
.perm-topbar-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #0F172A;
}
.perm-share {
  padding: 12rpx 18rpx;
  font-size: 26rpx;
  flex-shrink: 0;
}

/* 票据选择 */
.select-section {
  padding: 12rpx 24rpx 0;
}
.select-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 28rpx;
}
.select-label {
  font-size: 22rpx;
  color: #94A3B8;
}
.select-value {
  flex: 1;
  text-align: right;
  margin: 0 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #B8761F;
  font-family: "DIN Alternate", monospace;
}
.select-arrow {
  color: #94A3B8;
  font-size: 24rpx;
}

/* 文档卡 */
.doc-card {
  margin: 20rpx 24rpx 0;
  padding: 24rpx 28rpx;
}
.doc-header {
  padding: 8rpx 0 16rpx;
  text-align: center;
}
.doc-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0F172A;
  letter-spacing: 8rpx;
}
.doc-body {
  border-top: 1rpx solid rgba(220, 230, 242, 0.8);
  padding-top: 16rpx;
}
.doc-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  font-size: 24rpx;
}
.doc-mono {
  color: #B8761F;
  font-family: "DIN Alternate", monospace;
  font-size: 22rpx;
  font-weight: 700;
}
.doc-status-chip {
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  flex-shrink: 0;
}
.doc-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1E293B;
  line-height: 1.5;
}
.doc-label {
  color: #94A3B8;
  flex-shrink: 0;
}
.doc-val {
  color: #1E293B;
  text-align: right;
  max-width: 62%;
}

/* 气体迷你读数 */
.gas-mini-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin: 8rpx 0 16rpx;
}
.gas-mini-cell {
  background: rgba(255, 255, 255, 0.6);
  border: 1rpx solid #DCE6F2;
  border-radius: 16rpx;
  padding: 16rpx 12rpx;
  text-align: center;
}
.gas-mini-label {
  display: block;
  font-size: 20rpx;
  color: #94A3B8;
  margin-bottom: 6rpx;
}
.gas-mini-value {
  font-size: 34rpx;
  font-weight: 800;
  font-family: "DIN Alternate", monospace;
}
.gas-mini-unit {
  font-size: 18rpx;
  color: #94A3B8;
  margin-left: 2rpx;
}

/* 清单 */
.check-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 10rpx 0;
}
.check-icon {
  color: #10B981;
  font-size: 26rpx;
  font-weight: 700;
  min-width: 32rpx;
}
.icon-green { color: #10B981; }
.icon-red { color: #EF4444; }
.check-text {
  color: #475569;
  font-size: 24rpx;
  line-height: 1.6;
}

/* 签章 */
.sign-section {
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(220, 230, 242, 0.6);
}
.sign-section:last-child {
  border-bottom: none;
}
.sign-label {
  display: block;
  font-size: 22rpx;
  color: #94A3B8;
  margin-bottom: 10rpx;
}
.sign-box {
  border-radius: 12rpx;
  padding: 18rpx;
}
.sign-signed {
  background: rgba(16, 185, 129, 0.08);
  border-left: 6rpx solid #10B981;
}
.sign-pending {
  border: 1rpx dashed #CBD5E1;
  text-align: center;
}
.sign-name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #0F172A;
}
.sign-time {
  display: block;
  font-size: 20rpx;
  color: #94A3B8;
  margin-top: 4rpx;
  font-family: "DIN Alternate", monospace;
}
.sign-comment {
  display: block;
  font-size: 22rpx;
  color: #64748B;
  margin-top: 8rpx;
  line-height: 1.5;
}
.sign-dash {
  color: #94A3B8;
  font-size: 24rpx;
}

.hidden-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
}

/* 底部操作 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx;
  background: rgba(248, 251, 255, 0.92);
  backdrop-filter: blur(12rpx);
  border-top: 1rpx solid #DCE6F2;
}
.action-btn-save {
  text-align: center;
  padding: 22rpx;
  font-size: 28rpx;
}

/* 空态/加载 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
}
.loading-ring {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid rgba(232, 163, 61, 0.2);
  border-top-color: #E8A33D;
  border-radius: 50%;
  margin-bottom: 24rpx;
  animation: spin 0.9s linear infinite;
}
.empty-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}
.empty-text {
  font-size: 26rpx;
  color: #94A3B8;
  margin-bottom: 24rpx;
  text-align: center;
}
.retry-btn {
  padding: 16rpx 48rpx;
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
}
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
