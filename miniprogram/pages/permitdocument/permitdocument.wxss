page { background: #F5F7FA; min-height: 100vh; }
.page { padding: 24rpx; padding-bottom: 120rpx; }
.header { display: flex; align-items: center; gap: 16rpx; margin-bottom: 24rpx; }
.back-btn { width: 64rpx; height: 64rpx; background: #F8FAFC; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; }
.back-btn text { color: #1E293B; font-size: 32rpx; }
.header-info { flex: 1; }
.header-label { font-size: 20rpx; color: #94A3B8; }
.header-title { font-size: 32rpx; color: #1E293B; font-weight: 700; }
.share-btn { width: 64rpx; height: 64rpx; background: #F8FAFC; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; }
.share-btn text { font-size: 28rpx; }
.loading-box { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 120rpx 0; }
.loading-text { color: #94A3B8; font-size: 26rpx; margin-top: 16rpx; }
.error-box { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.error-text { color: #ef4444; font-size: 26rpx; margin-bottom: 24rpx; }
.retry-btn { background: #3b82f6; color: #F5F7FA; padding: 16rpx 48rpx; border-radius: 12rpx; font-size: 26rpx; font-weight: 600; }
.select-section { margin-bottom: 24rpx; }
.select-box { display: flex; align-items: center; justify-content: space-between; background: #FFFFFF; border: 1rpx solid #E2E8F0; border-radius: 12rpx; padding: 20rpx 24rpx; }
.select-label { font-size: 22rpx; color: #94A3B8; }
.select-value { font-size: 24rpx; color: #1E293B; font-family: monospace; flex: 1; text-align: right; margin: 0 16rpx; }
.select-arrow { color: #94A3B8; font-size: 24rpx; }
.doc-card { background: #FFFFFF; border: 1rpx solid #E2E8F0; border-radius: 16rpx; margin-bottom: 20rpx; overflow: hidden; }
.doc-header { background: #dc2626; padding: 20rpx 24rpx; }
.doc-title { color: #1E293B; font-size: 32rpx; font-weight: 800; text-align: center; display: block; letter-spacing: 8rpx; }
.doc-body { padding: 20rpx 24rpx; }
.doc-row { display: flex; justify-content: space-between; align-items: center; padding: 8rpx 0; font-size: 24rpx; }
.doc-mono { color: #3b82f6; font-family: monospace; font-size: 22rpx; }
.doc-desc { font-size: 26rpx; color: #1E293B; font-weight: 600; line-height: 1.5; display: block; margin-top: 12rpx; }
.doc-label { color: #94A3B8; font-size: 24rpx; }
.doc-val { color: #1E293B; font-size: 24rpx; text-align: right; max-width: 60%; }
.badge { font-size: 18rpx; padding: 4rpx 12rpx; border-radius: 6rpx; font-weight: 600; }
.badge-green { color: #10b981; background: rgba(34, 197, 94, 0.15); }
.badge-gray { color: #94A3B8; background: rgba(115, 115, 115, 0.15); }
.badge-amber { color: #fbbf24; background: rgba(251, 191, 36, 0.15); }
.section-title { display: flex; align-items: center; gap: 12rpx; padding: 20rpx 24rpx; border-bottom: 1rpx solid #E2E8F0; font-size: 28rpx; color: #1E293B; font-weight: 600; }
.title-bar { width: 6rpx; height: 28rpx; background: #3b82f6; border-radius: 3rpx; }
.bar-amber { background: #fbbf24; }
.bar-green { background: #10b981; }
.bar-blue { background: #60a5fa; }
.check-item { display: flex; align-items: flex-start; gap: 12rpx; padding: 10rpx 24rpx; }
.check-icon { color: #10b981; font-size: 24rpx; font-weight: 700; min-width: 32rpx; }
.icon-green { color: #10b981; }
.icon-red { color: #ef4444; }
.check-text { color: #64748B; font-size: 24rpx; line-height: 1.6; }
.sign-section { padding: 16rpx 24rpx; border-bottom: 1rpx solid #F8FAFC; }
.sign-label { font-size: 22rpx; color: #94A3B8; margin-bottom: 8rpx; display: block; }
.sign-box { background: #F8FAFC; border-radius: 8rpx; padding: 16rpx; }
.sign-signed { border-left: 4rpx solid #10b981; }
.sign-pending { border: 1rpx dashed #64748B; text-align: center; }
.sign-name { font-size: 26rpx; color: #1E293B; font-weight: 600; display: block; }
.sign-time { font-size: 20rpx; color: #94A3B8; display: block; margin-top: 4rpx; }
.sign-comment { font-size: 22rpx; color: #64748B; display: block; margin-top: 8rpx; line-height: 1.5; }
.sign-dash { color: #64748B; font-size: 24rpx; }
.hidden-canvas { position: fixed; left: -9999px; top: -9999px; }
.action-bar { position: fixed; bottom: 0; left: 0; right: 0; padding: 16rpx 24rpx; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); background: #F5F7FA; border-top: 1rpx solid #E2E8F0; }
.action-btn-save { background: #3b82f6; color: #F5F7FA; text-align: center; padding: 22rpx; border-radius: 12rpx; font-size: 28rpx; font-weight: 700; }
.action-btn-save:active { opacity: 0.8; }
