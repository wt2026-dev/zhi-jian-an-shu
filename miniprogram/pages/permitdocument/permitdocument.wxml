<!-- 电子作业票文档 · Solar-Punk 明亮游戏化 HUD -->
<view class="fx-bg">
  <view class="fx-hex"></view>
  <view class="fx-particles"></view>
  <view class="fx-bloom"></view>
</view>

<view class="page-body">
  <!-- 顶部导航条 -->
  <view class="perm-topbar">
    <view class="perm-back" bindtap="goBack">
      <text class="perm-back-arrow">←</text>
    </view>
    <view class="perm-topbar-info">
      <text class="perm-topbar-label">电子票证 // 实时渲染</text>
      <text class="perm-topbar-title">电子作业票文档</text>
    </view>
    <view class="chip-cyan perm-share" bindtap="onShareAppMessage">📤</view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="empty-state">
    <view class="loading-ring"></view>
    <text class="empty-text">加载中...</text>
  </view>

  <!-- 加载失败 -->
  <view wx:elif="{{loadError}}" class="empty-state">
    <text class="empty-icon">⚠️</text>
    <text class="empty-text">{{loadError}}</text>
    <view class="retry-btn" bindtap="retry">重试</view>
  </view>

  <block wx:else>
    <!-- 票据选择 -->
    <view class="select-section">
      <picker mode="selector" range="{{permits}}" range-key="permitNo" bindchange="onPermitChange">
        <view class="hud-card select-box">
          <text class="select-label">选择作业票</text>
          <text class="select-value">{{permit.permitNo || '请选择'}}</text>
          <text class="select-arrow">▾</text>
        </view>
      </picker>
    </view>

    <block wx:if="{{permit}}">
      <!-- 票头 -->
      <view class="hud-card doc-card">
        <view class="hud-accent-top"></view>
        <view class="doc-header">
          <text class="doc-title">安全作业票</text>
        </view>
        <view class="doc-body">
          <view class="doc-row">
            <text class="doc-mono">{{permit.permitNo}}</text>
            <view class="{{permit.status === 'active' ? 'chip-gold' : permit.status === 'closed' ? 'chip-titanium' : 'chip-cyan'}} doc-status-chip">
              {{permit.status === 'active' ? '作业中' : permit.status === 'closed' ? '已闭环' : permit.status === 'approved' ? '已批准' : permit.status === 'rejected' ? '已驳回' : '待审批'}}
            </view>
          </view>
          <text class="doc-desc">{{permit.title}}</text>
        </view>
      </view>

      <!-- 作业信息 -->
      <view class="hud-card doc-card">
        <view class="section-title-row">
          <view class="section-title-dot"></view>
          <view class="section-title-text">作业信息</view>
        </view>
        <view class="doc-row"><text class="doc-label">作业区域</text><text class="doc-val">{{permit.workshop}} {{permit.location}}</text></view>
        <view class="doc-row"><text class="doc-label">作业时间</text><text class="doc-val">{{permit.appliedAt}} ~ {{permit.validUntil}}</text></view>
        <view class="doc-row"><text class="doc-label">作业类型</text><text class="doc-val">{{permit.permitType}}</text></view>
        <view class="doc-row"><text class="doc-label">申请人</text><text class="doc-val">{{permit.applicant}}</text></view>
        <view class="doc-row"><text class="doc-label">风险等级</text><text class="doc-val">{{permit.riskLevel}}</text></view>
        <view class="doc-row" wx:if="{{permit.lotoNumber}}"><text class="doc-label">LOTO锁号</text><text class="doc-mono">{{permit.lotoNumber}}</text></view>
      </view>

      <!-- 气体检测 -->
      <view class="hud-card doc-card" wx:if="{{permit.gasTestResults}}">
        <view class="section-title-row">
          <view class="section-title-dot"></view>
          <view class="section-title-text">气体检测</view>
        </view>
        <view class="gas-mini-grid">
          <view class="gas-mini-cell">
            <text class="gas-mini-label">氧气 O₂</text>
            <text class="gas-mini-value text-sky">{{permit.gasTestResults.oxygen}}<text class="gas-mini-unit">%</text></text>
          </view>
          <view class="gas-mini-cell">
            <text class="gas-mini-label">可燃气</text>
            <text class="gas-mini-value text-gold-deep">{{permit.gasTestResults.combustible_gas}}<text class="gas-mini-unit">%</text></text>
          </view>
          <view class="gas-mini-cell">
            <text class="gas-mini-label">有毒气</text>
            <text class="gas-mini-value text-danger">{{permit.gasTestResults.toxic_gas}}<text class="gas-mini-unit">ppm</text></text>
          </view>
        </view>
        <view class="doc-row"><text class="doc-label">检测人</text><text class="doc-val">{{permit.gasTestResults.tester}}</text></view>
        <view class="doc-row"><text class="doc-label">检测时间</text><text class="doc-val">{{permit.gasTestResults.test_time}}</text></view>
      </view>

      <!-- 安全措施 -->
      <view class="hud-card doc-card" wx:if="{{precautions.length > 0}}">
        <view class="section-title-row">
          <view class="section-title-dot"></view>
          <view class="section-title-text">安全措施</view>
        </view>
        <view class="check-item" wx:for="{{precautions}}" wx:key="*this">
          <text class="check-icon">✓</text>
          <text class="check-text">{{item}}</text>
        </view>
      </view>

      <!-- 安全检查清单 -->
      <view class="hud-card doc-card" wx:if="{{checklist.length > 0}}">
        <view class="section-title-row">
          <view class="section-title-dot"></view>
          <view class="section-title-text">安全检查清单</view>
        </view>
        <view class="check-item" wx:for="{{checklist}}" wx:key="id">
          <text class="check-icon {{item.checked ? 'icon-green' : 'icon-red'}}">{{item.checked ? '✓' : '✗'}}</text>
          <text class="check-text">{{item.item}}</text>
        </view>
      </view>

      <!-- 审批与签章 -->
      <view class="hud-card doc-card">
        <view class="section-title-row">
          <view class="section-title-dot"></view>
          <view class="section-title-text">审批与签章</view>
        </view>

        <view class="sign-section">
          <text class="sign-label">现场监护初审</text>
          <view wx:if="{{permit.guardianApproval && permit.guardianApproval.signed}}" class="sign-box sign-signed">
            <text class="sign-name">✅ {{permit.guardianApproval.name}}</text>
            <text class="sign-time">{{permit.guardianApproval.signedAt}}</text>
            <text class="sign-comment" wx:if="{{permit.guardianApproval.comment}}">{{permit.guardianApproval.comment}}</text>
          </view>
          <view wx:else class="sign-box sign-pending">
            <text class="sign-dash">待签署</text>
          </view>
        </view>

        <view class="sign-section">
          <text class="sign-label">主管终审</text>
          <view wx:if="{{permit.supervisorApproval && permit.supervisorApproval.signed}}" class="sign-box sign-signed">
            <text class="sign-name">✅ {{permit.supervisorApproval.name}}</text>
            <text class="sign-time">{{permit.supervisorApproval.signedAt}}</text>
            <text class="sign-comment" wx:if="{{permit.supervisorApproval.comment}}">{{permit.supervisorApproval.comment}}</text>
          </view>
          <view wx:else class="sign-box sign-pending">
            <text class="sign-dash">待签署</text>
          </view>
        </view>

        <view class="sign-section" wx:if="{{permit.closedAt}}">
          <text class="sign-label">作业闭环</text>
          <view class="sign-box sign-signed">
            <text class="sign-name">✅ {{permit.closedBy}}</text>
            <text class="sign-time">{{permit.closedAt}}</text>
            <text class="sign-comment" wx:if="{{permit.closeRemark}}">{{permit.closeRemark}}</text>
          </view>
        </view>
      </view>

      <!-- 隐藏 canvas 用于导出 -->
      <canvas canvas-id="permitCanvas" class="hidden-canvas" style="width:750px;height:1200px;"></canvas>

      <!-- 底部操作 -->
      <view class="action-bar safe-bottom">
        <view class="btn-gold action-btn-save" bindtap="saveToAlbum">💾 保存到相册</view>
      </view>
    </block>
  </block>
</view>
