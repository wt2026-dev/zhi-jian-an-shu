/* pages/procedures/index.wxss · Solar-Punk Bright Game-HUD */
page {
  background: linear-gradient(180deg, #F8FBFF 0%, #F1F7FE 55%, #F7F4FF 100%);
  background-color: #F2F7FD;
  min-height: 100vh;
}

.page-body { padding: 0 0 40rpx; }

/* 顶部标题卡 */
.header-card { margin: 20rpx 24rpx; padding: 28rpx; }
.header-title { font-size: 32rpx; font-weight: 800; color: #0F172A; }
.header-desc { font-size: 22rpx; color: #64748B; margin-top: 10rpx; line-height: 1.5; }

/* 筛选栏 */
.filter-bar { display: flex; gap: 16rpx; padding: 0 24rpx; margin-bottom: 8rpx; }
.filter-picker { flex: 1; }
.picker-btn {
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid #DCE6F2;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  font-size: 22rpx;
}
.picker-label { color: #94A3B8; margin-right: 8rpx; }
.picker-val { color: #B8761F; font-weight: 700; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.picker-arrow { color: #94A3B8; font-size: 20rpx; margin-left: 8rpx; }

/* 加载 / 空态 */
.loading-state { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.loading-ring {
  width: 56rpx; height: 56rpx;
  border: 6rpx solid rgba(232, 163, 61, 0.2);
  border-top-color: #E8A33D;
  border-radius: 50%; margin-bottom: 24rpx;
  animation: spin 0.9s linear infinite;
}
.loading-text { font-size: 26rpx; color: #737373; }
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 120rpx 40rpx; }
.empty-icon { font-size: 72rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 24rpx; color: #94A3B8; }

/* 规程卡 */
.proc-card { margin: 20rpx 24rpx; padding: 26rpx 28rpx; }
.proc-badges { display: flex; align-items: center; }
.sp { flex: 1; }
.chip-sm { font-size: 19rpx; padding: 4rpx 14rpx; }
.proc-title { font-size: 29rpx; font-weight: 800; color: #0F172A; margin: 16rpx 0 8rpx; line-height: 1.35; }
.proc-desc { font-size: 22rpx; color: #64748B; line-height: 1.5; margin-bottom: 16rpx; }

/* 步骤区 */
.steps-section {
  background: rgba(241, 247, 254, 0.8);
  border: 1rpx solid #DCE6F2;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.steps-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 14rpx; padding-bottom: 12rpx;
  border-bottom: 1rpx dashed #DCE6F2;
}
.steps-title { font-size: 22rpx; font-weight: 700; color: #475569; }
.steps-tip { font-size: 18rpx; color: #94A3B8; }

.step-row {
  display: flex;
  padding: 14rpx 12rpx;
  border-radius: 12rpx;
  margin-bottom: 10rpx;
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid transparent;
}
.step-row:last-child { margin-bottom: 0; }
.step-checked {
  background: rgba(16, 185, 129, 0.08);
  border-color: rgba(16, 185, 129, 0.35);
}
.step-check-box {
  width: 40rpx; height: 40rpx;
  border-radius: 50%;
  background: #EDF2F9;
  color: #94A3B8;
  font-size: 20rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  margin-right: 16rpx; flex-shrink: 0;
  border: 1rpx solid #CBD5E1;
}
.box-checked { background: #10B981; color: #fff; border-color: #10B981; }
.step-text { flex: 1; }
.step-name { font-size: 24rpx; color: #1E293B; line-height: 1.35; }
.name-checked { color: #047857; text-decoration: line-through; }
.step-note { font-size: 20rpx; color: #B45309; margin-top: 6rpx; line-height: 1.4; }
.step-tool { font-size: 20rpx; color: #64748B; margin-top: 4rpx; }

/* 底部操作 */
.proc-footer {
  display: flex; align-items: center;
  font-size: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #DCE6F2;
}
.proc-adapt { color: #94A3B8; }
.video-btn {
  background: linear-gradient(135deg, #A78BFA, #8B5CF6);
  color: #fff; font-size: 21rpx; font-weight: 700;
  padding: 10rpx 20rpx; border-radius: 999rpx;
  margin-right: 12rpx;
}
.finish-btn {
  background: linear-gradient(135deg, #F6D08A, #E8A33D);
  color: #fff; font-size: 21rpx; font-weight: 700;
  padding: 10rpx 20rpx; border-radius: 999rpx;
  box-shadow: 0 4rpx 12rpx -4rpx rgba(232, 163, 61, 0.5);
}

@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
