.container {
  padding: 24rpx;
  background-color: #F5F7FA;
  min-height: 100vh;
  box-sizing: border-box;
}

.header-card {
  padding: 30rpx;
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(241, 245, 249, 0.9) 100%);
  border: 1px solid rgba(59, 130, 246, 0.2);
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1E293B;
}

.header-desc {
  font-size: 22rpx;
  color: #64748B;
  margin-top: 8rpx;
  line-height: 1.4;
}

/* 筛选工具条 */
.filter-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.filter-picker {
  flex: 1;
}

.picker-btn {
  background: #FFFFFF;
  border: 1px solid #E2E8F0;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  font-size: 22rpx;
}

.picker-label {
  color: #64748B;
}

.picker-val {
  color: #3b82f6;
  font-weight: 500;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-arrow {
  color: #64748b;
  font-size: 20rpx;
  margin-left: 8rpx;
}

.card {
  background: #FFFFFF;
  border: 1px solid #E2E8F0;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.row {
  display: flex;
  align-items: center;
}

.sp {
  flex: 1;
}

.badge {
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.badge-cyan {
  background: rgba(59, 130, 246, 0.1);
  color: #3b82f6;
  border: 1px solid rgba(59, 130, 246, 0.2);
}

.badge-amber {
  background: rgba(245, 158, 11, 0.1);
  color: #F59E0B;
  border: 1px solid rgba(245, 158, 11, 0.2);
}

.proc-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1E293B;
  margin: 16rpx 0 8rpx;
}

.proc-desc {
  font-size: 22rpx;
  color: #64748B;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.steps-section {
  background: #F8FAFC;
  border: 1px solid #E2E8F0;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.steps-header {
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1px dashed #27272a;
}

.steps-title {
  font-size: 22rpx;
  font-weight: bold;
  color: #475569;
}

.steps-tip {
  font-size: 18rpx;
  color: #94A3B8;
}

.step-row {
  display: flex;
  padding: 14rpx 12rpx;
  border-radius: 10rpx;
  margin-bottom: 10rpx;
  background: rgba(241,245,249,0.8);
  border: 1px solid transparent;
  transition: all 0.2s;
}

.step-row:last-child {
  margin-bottom: 0;
}

.step-checked {
  background: rgba(16, 185, 129, 0.08);
  border-color: rgba(16, 185, 129, 0.3);
}

.step-check-box {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #E2E8F0;
  color: #64748B;
  font-size: 20rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
  border: 1px solid #CBD5E1;
}

.box-checked {
  background: #10b981;
  color: #ffffff;
  border-color: #10b981;
}

.step-text {
  flex: 1;
}

.step-name {
  font-size: 24rpx;
  color: #1E293B;
  line-height: 1.3;
}

.name-checked {
  color: #10b981;
  text-decoration: line-through;
}

.step-note {
  font-size: 20rpx;
  color: #D97706;
  margin-top: 6rpx;
  line-height: 1.3;
}

.step-tool {
  font-size: 20rpx;
  color: #64748B;
  margin-top: 4rpx;
}

.proc-footer {
  font-size: 20rpx;
  padding-top: 16rpx;
  border-top: 1px solid #E2E8F0;
}

.finish-btn {
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: bold;
  padding: 10rpx 20rpx;
  border-radius: 10rpx;
}

.empty {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #94A3B8;
  font-size: 24rpx;
}

.video-btn {
  background: linear-gradient(135deg, #8B5CF6, #6D28D9);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: bold;
  padding: 10rpx 20rpx;
  border-radius: 10rpx;
  margin-right: 16rpx;
}
