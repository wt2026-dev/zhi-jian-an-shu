@import "../../common.wxss";

page {
  background-color: #F5F7FA;
  color: #1E293B;
  font-family: 'Inter', 'PingFang SC', sans-serif;
}

.status-bar {
  position: sticky;
  top: 0;
  z-index: 50;
  background-color: rgba(7, 10, 14, 0.95);
  border-bottom: 1rpx solid #E2E8F0;
}

.status-bar-inner {
  padding: 16rpx 28rpx 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 18rpx;
  letter-spacing: -0.02em;
}

.status-left, .status-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.status-indicator {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.status-dot-blue {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #3b82f6;
  animation: pulse 2s infinite;
}

.status-text-blue {
  color: #3b82f6;
  font-weight: 600;
}

.status-sep {
  color: #E2E8F0;
}

.status-text-muted {
  color: #94A3B8;
}

.status-text-green {
  color: #10b981;
  font-weight: 600;
}

.signal-info {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.signal-icon {
  font-size: 24rpx;
  color: #10b981;
}

.status-text-time {
  color: rgba(226, 232, 240, 0.8);
  font-weight: 500;
  letter-spacing: 0.05em;
}

.nav-bar {
  padding: 16rpx 28rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.nav-back-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 8rpx;
  border: 1rpx solid #E2E8F0;
  background-color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-btn:active {
  background-color: #FFFFFF;
}

.nav-back-btn .material-icons {
  font-size: 36rpx;
  color: #1E293B;
}

.nav-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.nav-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.nav-tag {
  font-size: 16rpx;
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background-color: #F8FAFC;
  color: #3b82f6;
  border: 1rpx solid rgba(56, 189, 248, 0.3);
}

.nav-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1E293B;
}

.nav-subtitle {
  font-size: 18rpx;
  color: #94A3B8;
  letter-spacing: -0.02em;
}

.nav-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.nav-version-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.version-tag {
  font-size: 16rpx;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  background-color: rgba(36, 45, 56, 0.6);
  color: #94A3B8;
  font-weight: 700;
}

.nav-voice-icon {
  font-size: 28rpx;
  color: #10b981;
}

.work-order-id {
  font-size: 20rpx;
  font-weight: 700;
  color: #1E293B;
  letter-spacing: 0.05em;
}

.main-content {
  height: calc(100vh - 300rpx);
  padding: 24rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  background-image:
    linear-gradient(to right, rgba(255, 255, 255, 0.025) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
  background-size: 16px 16px;
}

.card {
  border-radius: 8rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #E2E8F0;
}

/* 状态与优先级面*/
.status-card {
  padding: 24rpx;
  position: relative;
  overflow: hidden;
}

.card-bg-highlight {
  position: absolute;
  top: 0;
  right: 0;
  width: 128rpx;
  height: 128rpx;
  background-color: rgba(251, 191, 36, 0.05);
  border-bottom-left-radius: 50%;
  pointer-events: none;
}

.status-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.status-left-col {
  flex: 1;
}

.status-label-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 18rpx;
  color: #94A3B8;
  margin-bottom: 8rpx;
}

.dot-gray {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background-color: #64748B;
}

.status-label-amber {
  color: #fbbf24;
  font-weight: 600;
  letter-spacing: 0.05em;
}

.status-main-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.amber-pulse {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.amber-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background-color: #fbbf24;
}

.amber-ring {
  position: absolute;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background-color: rgba(251, 191, 36, 0.4);
  animation: ping 1.5s infinite;
}

.status-main-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
}

.status-badge-amber {
  font-size: 22rpx;
  font-weight: 400;
  color: #fbbf24;
}

.status-right-col {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.emergency-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
  background-color: rgba(244, 63, 94, 0.15);
  border: 1rpx solid rgba(244, 63, 94, 0.4);
  color: #EF4444;
  font-size: 18rpx;
  font-weight: 700;
}

.red-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #EF4444;
}

.elapsed-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 18rpx;
  color: #94A3B8;
}

.timer-icon {
  font-size: 24rpx;
}

.elapsed-value {
  font-weight: 600;
  color: #1E293B;
}

.status-divider {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(36, 45, 56, 0.7);
}

.status-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 20rpx;
}

.bottom-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.bottom-label {
  color: #94A3B8;
}

.bottom-value-blue {
  color: #3b82f6;
  font-weight: 600;
}

.bottom-value-amber {
  color: #fbbf24;
  font-weight: 600;
}

/* 设备档案卡片 */
.card-header {
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: rgba(23, 30, 39, 0.5);
}

.card-header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.header-icon {
  font-size: 34rpx;
  color: #3b82f6;
}

.header-icon.amber {
  color: #fbbf24;
}

.header-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #1E293B;
  letter-spacing: 0.03em;
}

.iso-tag {
  font-size: 18rpx;
  color: #3b82f6;
  background-color: rgba(56, 189, 248, 0.12);
  border: 1rpx solid rgba(56, 189, 248, 0.3);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.device-params {
  padding: 24rpx;
}

.param-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}

.param-label {
  flex: 0 0 33%;
  font-size: 20rpx;
  color: #94A3B8;
}

.param-value {
  flex: 1;
  text-align: right;
  font-weight: 600;
  color: #1E293B;
  font-size: 22rpx;
}

.param-tag {
  flex: 1;
  text-align: right;
  font-weight: 700;
  color: #3b82f6;
  font-size: 20rpx;
  background-color: #F5F7FA;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  border: 1rpx solid #E2E8F0;
  display: inline-block;
}

.param-text-muted {
  flex: 1;
  text-align: right;
  color: #64748B;
  font-size: 20rpx;
}

.pressure-section {
  margin-top: 20rpx;
  padding: 16rpx;
  border-radius: 6rpx;
  background-color: #F5F7FA;
  border: 1rpx solid #E2E8F0;
}

.pressure-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 18rpx;
  color: #94A3B8;
  margin-bottom: 12rpx;
}

.pressure-bar {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.pressure-labels {
  display: flex;
  justify-content: space-between;
  font-size: 18rpx;
  color: #94A3B8;
}

.pressure-crit {
  color: #EF4444;
  font-weight: 700;
}

.pressure-green {
  color: #10b981;
  font-weight: 700;
}

.progress-bar {
  height: 12rpx;
  display: flex;
  border-radius: 8rpx;
  overflow: hidden;
  background-color: #F8FAFC;
}

.progress-fill-red {
  height: 100%;
  background-color: #EF4444;
}

.progress-fill-gray {
  height: 100%;
  background-color: rgba(54, 67, 83, 0.4);
}

.fault-section {
  margin-top: 16rpx;
}

.fault-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  border-radius: 6rpx;
  background-color: rgba(11, 15, 20, 0.8);
  border: 1rpx solid #E2E8F0;
  font-size: 18rpx;
  color: #94A3B8;
}

.fault-toggle {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.fault-toggle-text {
  font-size: 18rpx;
}

.fault-toggle-icon {
  font-size: 28rpx;
  color: #94A3B8;
}

.fault-content {
  padding: 16rpx 20rpx;
  border: 1rpx solid #E2E8F0;
  border-top: none;
  border-radius: 0 0 6rpx 6rpx;
}

.fault-desc {
  font-size: 20rpx;
  line-height: 1.6;
  color: #1E293B;
}

.temp-highlight {
  color: #f97316;
  font-weight: 500;
}

.photo-section {
  margin-top: 16rpx;
}

.photo-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 18rpx;
  color: #94A3B8;
  margin-bottom: 12rpx;
}

.photo-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.photo-item {
  position: relative;
  border-radius: 6rpx;
  overflow: hidden;
  border: 1rpx solid #E2E8F0;
  background-color: #F5F7FA;
  aspect-ratio: 4/3;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-crosshair {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.crosshair-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 3rpx dashed rgba(244, 63, 94, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: pulse 2s infinite;
}

.crosshair-dot {
  width: 10rpx;
  height: 10rpx;
  background-color: #EF4444;
  border-radius: 50%;
}

.photo-label-top {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  background-color: rgba(0, 0, 0, 0.75);
  font-size: 14rpx;
  color: #1E293B;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.photo-label-bottom {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  background-color: rgba(0, 0, 0, 0.8);
  font-size: 16rpx;
  color: #3b82f6;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  border: 1rpx solid #E2E8F0;
}

/* 时间*/
.timeline-card {
  padding: 24rpx;
}

.timeline-header {
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #E2E8F0;
}

.verified-tag {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 16rpx;
  color: #10b981;
  background-color: rgba(34, 197, 94, 0.15);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  border: 1rpx solid rgba(34, 197, 94, 0.3);
}

.verified-icon {
  font-size: 22rpx;
}

.timeline {
  position: relative;
  padding-left: 48rpx;
  padding-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.timeline-line {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  bottom: 24rpx;
  width: 1rpx;
  background-color: rgba(54, 67, 83, 0.6);
}

.timeline-node {
  position: relative;
  display: flex;
  flex-direction: column;
}

.node-dot {
  position: absolute;
  left: -44rpx;
  top: 8rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 3rpx solid #FFFFFF;
  box-sizing: border-box;
}

.node-dot.green {
  background-color: #10b981;
  box-shadow: 0 0 0 1rpx #10b981;
}

.node-dot.blue {
  background-color: #3b82f6;
  box-shadow: 0 0 0 1rpx #3b82f6;
}

.node-dot.gray {
  background-color: #64748B;
}

.node-dot-amber {
  position: absolute;
  left: -50rpx;
  top: 24rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background-color: #fbbf24;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 0 8rpx rgba(251, 191, 36, 0.2);
  animation: pulse 2s infinite;
}

.node-dot-inner {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #F5F7FA;
}

.node-content {
  display: flex;
  flex-direction: column;
}

.node-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.node-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.node-title {
  font-size: 22rpx;
  font-weight: 600;
  color: #1E293B;
}

.node-title.dim {
  color: #64748B;
  font-weight: 500;
}

.node-badge-green {
  font-size: 16rpx;
  font-weight: 400;
  color: #10b981;
  background-color: rgba(34, 197, 94, 0.1);
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.node-sub-badge {
  font-size: 16rpx;
  color: #94A3B8;
}

.node-time {
  font-size: 18rpx;
  color: #94A3B8;
}

.node-desc {
  font-size: 20rpx;
  color: #64748B;
  margin-top: 4rpx;
  line-height: 1.5;
}

.node-desc.dim {
  color: #64748B;
}

.node-detail-row {
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 20rpx;
  color: #64748B;
  flex-wrap: wrap;
}

.loto-tag {
  font-size: 18rpx;
  color: #3b82f6;
  background-color: rgba(56, 189, 248, 0.12);
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  border: 1rpx solid rgba(56, 189, 248, 0.3);
}

.node-sub-text {
  font-size: 18rpx;
  color: #94A3B8;
}

/* 当前节点 */
.timeline-node.current {
  padding-left: 0;
}

.current-card {
  padding: 20rpx;
  border-radius: 6rpx;
  background-color: #FFFFFF;
  border: 2rpx solid rgba(56, 189, 248, 0.8);
  box-shadow: 0 0 24rpx rgba(56, 189, 248, 0.15);
}

.current-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.current-label-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.current-badge {
  font-size: 16rpx;
  font-weight: 700;
  background-color: #fbbf24;
  color: #000000;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.current-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #1E293B;
}

.current-time {
  font-size: 20rpx;
  color: #3b82f6;
  font-weight: 600;
}

.current-desc {
  font-size: 20rpx;
  line-height: 1.6;
  color: #1E293B;
}

.current-footer {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #E2E8F0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 18rpx;
  color: #94A3B8;
}

.current-footer-amber {
  color: #fbbf24;
  font-weight: 600;
}

/* 备件卡片 */
.spare-card {
  overflow: hidden;
}

.rfid-status {
  font-size: 18rpx;
  color: #94A3B8;
}

.spare-list {
  display: flex;
  flex-direction: column;
}

.spare-item {
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #E2E8F0;
}

.spare-item:last-child {
  border-bottom: none;
}

.spare-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.spare-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.spare-name {
  font-size: 22rpx;
  font-weight: 600;
  color: #1E293B;
}

.rfid-tag {
  font-size: 16rpx;
  color: #3b82f6;
  border: 1rpx solid rgba(56, 189, 248, 0.3);
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.spare-spec {
  font-size: 18rpx;
  color: #94A3B8;
}

.spare-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.spare-qty {
  font-size: 20rpx;
  font-weight: 700;
  color: #1E293B;
}

.spare-status {
  font-size: 16rpx;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  background-color: rgba(34, 197, 94, 0.15);
  color: #10b981;
  font-weight: 600;
}

.tool-check {
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: rgba(36, 45, 56, 0.3);
  border: 1rpx dashed rgba(34, 197, 94, 0.5);
}

.tool-check-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 20rpx;
}

.tool-icon {
  font-size: 32rpx;
  color: #10b981;
}

.tool-label {
  font-weight: 700;
  color: #1E293B;
}

.tool-status {
  color: #10b981;
  font-weight: 700;
}

.tool-sub {
  font-size: 16rpx;
  color: #94A3B8;
}

/* 底部操作*/
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(7, 10, 14, 0.95);
  border-top: 1rpx solid #E2E8F0;
  padding: 20rpx 20rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom, 0px));
  z-index: 50;
}

.bottom-bar-inner {
  display: flex;
  gap: 16rpx;
  max-width: 720rpx;
  margin: 0 auto;
}

.btn-secondary {
  width: 40%;
  height: 96rpx;
  border-radius: 6rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #1E293B;
}

.btn-secondary:active {
  background-color: #F8FAFC;
}

.btn-icon {
  font-size: 34rpx;
  color: #94A3B8;
}

.btn-primary {
  flex: 1;
  height: 96rpx;
  border-radius: 6rpx;
  background-color: #3b82f6;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-shadow: 0 0 20rpx rgba(56, 189, 248, 0.3);
}

.btn-primary:active {
  opacity: 0.9;
}

.btn-primary-text {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  line-height: 1.3;
}

.btn-primary-text text:first-child {
  font-size: 22rpx;
  font-weight: 700;
  color: #F5F7FA;
}

.btn-primary-sub {
  font-size: 16rpx;
  font-weight: 600;
  color: rgba(7, 10, 14, 0.85);
}

.btn-icon-primary {
  font-size: 38rpx;
  color: #F5F7FA;
}

.btn-loading {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.btn-loading-text {
  font-size: 20rpx;
  color: #F5F7FA;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

@keyframes ping {
  0% { transform: scale(1); opacity: 0.5; }
  100% { transform: scale(1.8); opacity: 0; }
}

.spinning {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.bottom-spacer {
  height: 200rpx;
}

/* 设备档案卡片 */
.device-card { margin-bottom: 24rpx; }