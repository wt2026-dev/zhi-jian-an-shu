/* pages/maintenancedetail/maintenancedetail.wxss · Solar-Punk Bright Game-HUD */
@import "../../common.wxss";

page {
  background: linear-gradient(180deg, #F8FBFF 0%, #F1F7FE 55%, #F7F4FF 100%);
  background-color: #F2F7FD;
  min-height: 100vh;
}

.page-body {
  padding-bottom: 200rpx;
}

/* 顶部导航 */
.nav-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
}
.back-chip {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid #DCE6F2;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.back-arrow { font-size: 34rpx; color: #1E293B; line-height: 1; }
.nav-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.nav-title-row { display: flex; align-items: center; gap: 10rpx; }
.nav-title { font-size: 27rpx; font-weight: 700; color: #0F172A; }
.nav-subtitle { font-size: 19rpx; color: #94A3B8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.order-no {
  font-size: 20rpx;
  font-family: "DIN Alternate", monospace;
  color: #B8761F;
  background: rgba(232, 163, 61, 0.1);
  border: 1rpx solid rgba(232, 163, 61, 0.32);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  flex-shrink: 0;
}

/* 加载 / 错误 */
.loading-state, .error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
}
.loading-ring {
  width: 56rpx; height: 56rpx;
  border: 6rpx solid rgba(232, 163, 61, 0.2);
  border-top-color: #E8A33D;
  border-radius: 50%;
  margin-bottom: 24rpx;
  animation: spin 0.9s linear infinite;
}
.loading-text, .error-text { font-size: 26rpx; color: #737373; }
.error-icon { font-size: 60rpx; margin-bottom: 20rpx; }
.error-text { color: #EF4444; }

/* 卡片 */
.hud-card {
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
}
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin: -8rpx -8rpx 16rpx;
  padding: 0 8rpx;
}
.card-header-left { display: flex; align-items: center; gap: 12rpx; min-width: 0; }
.header-icon { font-size: 30rpx; }
.header-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #0F172A;
  letter-spacing: 0.02em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.chip-sm { font-size: 19rpx; padding: 4rpx 14rpx; flex-shrink: 0; }
.chip-success {
  font-size: 19rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  color: #047857;
  background: rgba(16, 185, 129, 0.12);
  border: 1rpx solid rgba(16, 185, 129, 0.35);
}

/* 状态卡 */
.status-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.status-left-col { flex: 1; }
.status-label-row { display: flex; align-items: center; gap: 10rpx; font-size: 19rpx; color: #94A3B8; margin-bottom: 10rpx; }
.amber-pulse { position: relative; display: flex; align-items: center; justify-content: center; }
.amber-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #FBBF24; box-shadow: 0 0 0 6rpx rgba(251, 191, 36, 0.2); }
.status-live { color: #B45309; font-weight: 600; }
.status-main { font-size: 28rpx; font-weight: 700; color: #0F172A; display: flex; align-items: center; gap: 10rpx; }
.emergency-tag {
  display: flex; align-items: center; gap: 6rpx;
  padding: 6rpx 14rpx; border-radius: 999rpx;
  background: rgba(239, 68, 68, 0.1);
  border: 1rpx solid rgba(239, 68, 68, 0.4);
  color: #EF4444; font-size: 18rpx; font-weight: 700;
  flex-shrink: 0;
}
.red-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #EF4444; }
.status-divider { margin: 20rpx 0; border-top: 1rpx solid rgba(220, 230, 242, 0.9); }
.status-bottom { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; font-size: 20rpx; }
.bottom-item { display: flex; align-items: center; gap: 8rpx; }
.bottom-label { color: #94A3B8; }
.bottom-value-blue { color: #2563EB; font-weight: 600; }
.bottom-value-amber { color: #B45309; font-weight: 600; }

/* 设备参数 */
.param-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 14rpx 0; border-bottom: 1rpx solid rgba(220, 230, 242, 0.7); }
.param-row:last-of-type { border-bottom: none; }
.param-label { flex: 0 0 32%; font-size: 20rpx; color: #94A3B8; }
.param-value { flex: 1; text-align: right; font-weight: 600; color: #1E293B; font-size: 22rpx; }
.param-tag {
  font-weight: 700; color: #2563EB; font-size: 20rpx;
  background: rgba(37, 99, 235, 0.08);
  padding: 4rpx 14rpx; border-radius: 8rpx;
  border: 1rpx solid rgba(37, 99, 235, 0.25);
}
.param-text-muted { flex: 1; text-align: right; color: #64748B; font-size: 20rpx; }

/* 压力诊断 */
.pressure-section {
  margin-top: 16rpx; padding: 16rpx;
  border-radius: 14rpx;
  background: rgba(241, 247, 254, 0.8);
  border: 1rpx solid #DCE6F2;
}
.pressure-header { display: flex; align-items: center; justify-content: space-between; font-size: 19rpx; color: #94A3B8; margin-bottom: 12rpx; }
.pressure-verify { color: #10B981; }
.pressure-labels { display: flex; justify-content: space-between; font-size: 19rpx; color: #64748B; margin-bottom: 10rpx; }
.pressure-crit { color: #EF4444; font-weight: 700; }
.pressure-green { color: #10B981; font-weight: 700; }
.progress-bar { height: 14rpx; display: flex; border-radius: 8rpx; overflow: hidden; background: #EDF2F9; }
.progress-fill-red { height: 100%; background: linear-gradient(90deg, #F87171, #EF4444); }
.progress-fill-gray { height: 100%; background: #CBD5E1; }

/* 故障现象 */
.fault-section { margin-top: 16rpx; }
.fault-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 20rpx; border-radius: 12rpx;
  background: rgba(241, 247, 254, 0.8);
  border: 1rpx solid #DCE6F2;
  font-size: 21rpx; color: #475569; font-weight: 600;
}
.fault-toggle { font-size: 19rpx; color: #0EA5E9; }
.fault-content { padding: 16rpx 4rpx 0; }
.fault-desc { font-size: 22rpx; line-height: 1.6; color: #334155; }
.temp-highlight { color: #EA580C; font-weight: 600; }

/* 现场照片 */
.photo-section { margin-top: 18rpx; }
.photo-header { display: flex; align-items: center; justify-content: space-between; font-size: 19rpx; color: #94A3B8; margin-bottom: 12rpx; }
.photo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.photo-item {
  position: relative; border-radius: 14rpx; overflow: hidden;
  border: 1rpx solid #DCE6F2; background: #EDF2F9;
  aspect-ratio: 4/3;
}
.photo-img { width: 100%; height: 100%; }
.photo-label-top {
  position: absolute; top: 8rpx; left: 8rpx;
  background: rgba(15, 23, 42, 0.7);
  font-size: 16rpx; color: #fff;
  padding: 3rpx 10rpx; border-radius: 6rpx;
}
.photo-label-bottom {
  position: absolute; bottom: 8rpx; right: 8rpx;
  background: rgba(255, 255, 255, 0.92);
  font-size: 17rpx; color: #B8761F;
  padding: 3rpx 10rpx; border-radius: 6rpx;
}

/* 时间轴 */
.timeline { position: relative; padding-left: 40rpx; padding-top: 8rpx; display: flex; flex-direction: column; gap: 26rpx; }
.timeline-node { position: relative; display: flex; flex-direction: column; }
.node-dot {
  position: absolute; left: -38rpx; top: 6rpx;
  width: 18rpx; height: 18rpx; border-radius: 50%;
  border: 3rpx solid #FFFFFF; box-sizing: border-box;
}
.node-dot.green { background: #10B981; box-shadow: 0 0 0 1rpx #10B981; }
.node-dot.blue { background: #2563EB; box-shadow: 0 0 0 1rpx #2563EB; }
.node-dot.gray { background: #94A3B8; }
.node-dot-amber {
  position: absolute; left: -44rpx; top: 20rpx;
  width: 26rpx; height: 26rpx; border-radius: 50%;
  background: #FBBF24;
  box-shadow: 0 0 0 8rpx rgba(251, 191, 36, 0.2);
}
.node-top { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; }
.node-title { font-size: 23rpx; font-weight: 600; color: #1E293B; }
.node-title.dim { color: #94A3B8; font-weight: 500; }
.node-sub-badge { font-size: 18rpx; color: #94A3B8; }
.node-time { font-size: 18rpx; color: #94A3B8; font-family: "DIN Alternate", monospace; }
.node-desc { font-size: 20rpx; color: #64748B; margin-top: 4rpx; line-height: 1.5; }
.node-desc.dim { color: #94A3B8; }
.node-detail-row { margin-top: 6rpx; display: flex; align-items: center; gap: 10rpx; font-size: 20rpx; color: #64748B; flex-wrap: wrap; }

.current-card {
  padding: 18rpx; border-radius: 16rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(232, 163, 61, 0.5);
  box-shadow: 0 8rpx 24rpx -12rpx rgba(232, 163, 61, 0.4);
}
.current-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8rpx; }
.current-label-row { display: flex; align-items: center; gap: 10rpx; }
.current-title { font-size: 22rpx; font-weight: 700; color: #0F172A; }
.current-time { font-size: 19rpx; color: #B8761F; font-weight: 700; font-family: "DIN Alternate", monospace; }
.current-desc { font-size: 20rpx; line-height: 1.6; color: #334155; }
.current-footer { margin-top: 14rpx; padding-top: 14rpx; border-top: 1rpx solid #DCE6F2; display: flex; align-items: center; justify-content: space-between; font-size: 18rpx; color: #94A3B8; }
.current-footer-amber { color: #B45309; font-weight: 600; }

/* 备件 */
.rfid-status { font-size: 18rpx; color: #94A3B8; }
.spare-item { padding: 18rpx 0; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; border-bottom: 1rpx solid rgba(220, 230, 242, 0.7); }
.spare-item:last-of-type { border-bottom: none; }
.spare-info { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.spare-name-row { display: flex; align-items: center; gap: 10rpx; }
.spare-name { font-size: 22rpx; font-weight: 600; color: #1E293B; }
.spare-spec { font-size: 18rpx; color: #94A3B8; }
.spare-right { display: flex; flex-direction: column; align-items: flex-end; gap: 6rpx; }
.spare-qty { font-size: 20rpx; font-weight: 700; color: #0F172A; }
.tool-check {
  margin-top: 14rpx; padding: 16rpx 18rpx;
  display: flex; align-items: center; justify-content: space-between;
  background: rgba(16, 185, 129, 0.08);
  border: 1rpx dashed rgba(16, 185, 129, 0.5);
  border-radius: 14rpx;
}
.tool-check-left { display: flex; align-items: center; gap: 10rpx; font-size: 20rpx; }
.tool-icon { font-size: 28rpx; }
.tool-label { font-weight: 700; color: #1E293B; }
.tool-status { color: #047857; font-weight: 700; font-size: 20rpx; }

/* 底部操作栏 */
.bottom-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  border-top: 1rpx solid #DCE6F2;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom, 0px));
  z-index: 50;
}
.bottom-bar-inner { display: flex; gap: 16rpx; }
.btn-secondary {
  width: 38%; height: 92rpx; border-radius: 16rpx;
  background: #FFFFFF; border: 1rpx solid #DCE6F2;
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
  font-size: 22rpx; color: #475569;
}
.btn-icon { font-size: 30rpx; }
.btn-gold {
  flex: 1; height: 92rpx; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center; gap: 10rpx;
}
.btn-primary-text { display: flex; flex-direction: column; align-items: flex-start; line-height: 1.25; }
.btn-primary-text text:first-child { font-size: 22rpx; font-weight: 700; color: #FFFFFF; }
.btn-primary-sub { font-size: 16rpx; color: rgba(255,255,255,0.85); }
.btn-icon-primary { font-size: 34rpx; color: #FFFFFF; }
.spinning { animation: spin 1s linear infinite; }

@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
.bottom-spacer { height: 200rpx; }
