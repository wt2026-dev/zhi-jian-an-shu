.cockpit-page {
  padding: 24rpx;
  padding-bottom: 120rpx;
}
.page-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1E293B;
  margin-bottom: 24rpx;
}

.kpi-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.kpi-card {
  background: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.kpi-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}
.kpi-value {
  font-size: 44rpx;
  font-weight: 800;
  font-family: "DIN Alternate", monospace;
  color: #1E293B;
  line-height: 1.1;
}
.kpi-label {
  font-size: 22rpx;
  color: #64748B;
  margin-top: 4rpx;
}
.kpi-sub {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #94A3B8;
}

.section-card {
  background: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.more-link {
  font-size: 24rpx;
  color: #3b82f6;
  font-weight: 500;
}

.status-bar-visual {
  display: flex;
  height: 16rpx;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}
.status-segment {
  min-width: 8rpx;
  transition: flex 0.3s;
}
.status-legend {
  display: flex;
  gap: 24rpx;
  font-size: 22rpx;
  color: #64748B;
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
}

.order-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
}
.order-row:last-child {
  border-bottom: none;
}
.order-info {
  flex: 1;
  min-width: 0;
}
.order-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1E293B;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.order-status {
  font-size: 22rpx;
  font-weight: 600;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: 16rpx;
  margin-top: 8rpx;
}
.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #475569;
  font-weight: 500;
}
.quick-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}