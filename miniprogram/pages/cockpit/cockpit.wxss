/* cockpit.wxss - 数据驾驶舱 · Bright Game-HUD / Solar-Punk */

/* 顶部标题 HUD 卡 */
.hero-card {
  margin: 20rpx 24rpx 0;
  padding: 26rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.hero-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.hero-dot {
  width: 12rpx;
  height: 32rpx;
  border-radius: 6rpx;
  background: linear-gradient(180deg, #E8A33D 0%, #0EA5E9 100%);
  box-shadow: 0 2rpx 8rpx rgba(14, 165, 233, 0.4);
}
.hero-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #0F172A;
  letter-spacing: 1rpx;
}
.hero-live {
  font-size: 20rpx;
  flex-shrink: 0;
}

/* KPI 网格 */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin: 20rpx 24rpx 0;
}
.kpi-card {
  padding: 22rpx;
  display: flex;
  flex-direction: column;
}
.kpi-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.kpi-label {
  font-size: 22rpx;
  color: #64748B;
}
.kpi-num {
  font-size: 46rpx;
  font-weight: 800;
  color: #0F172A;
  font-family: "DIN Alternate", -apple-system, sans-serif;
  line-height: 1.1;
  margin-bottom: 10rpx;
}
.kpi-unit {
  font-size: 22rpx;
  font-weight: 600;
  color: #94A3B8;
  margin-left: 4rpx;
}
.kpi-sub {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  font-size: 20rpx;
  color: #64748B;
}

/* 区块 HUD 卡 */
.section-card {
  margin: 20rpx 24rpx 0;
  padding: 24rpx 28rpx;
}
.section-card-head {
  margin-bottom: 8rpx;
}
.section-title-more {
  margin-left: auto;
  font-size: 22rpx;
  color: #0EA5E9;
  font-weight: 600;
}

/* 设备状态分布条 */
.status-bar-visual {
  display: flex;
  height: 20rpx;
  border-radius: 10rpx;
  overflow: hidden;
  margin: 20rpx 0 16rpx;
  box-shadow: inset 0 1rpx 2rpx rgba(15, 23, 42, 0.12);
}
.status-segment {
  min-width: 8rpx;
  transition: flex 0.3s;
}
.status-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  font-size: 22rpx;
  color: #64748B;
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
}

/* 最近工单行 */
.order-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(220, 230, 242, 0.7);
}
.order-row:last-of-type {
  border-bottom: none;
  padding-bottom: 4rpx;
}
.order-info {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}
.order-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1E293B;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.order-muted {
  font-size: 20rpx;
  color: #94A3B8;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.order-status {
  font-size: 20rpx;
  font-weight: 700;
  flex-shrink: 0;
  background: rgba(220, 230, 242, 0.35);
  border-radius: 20rpx;
  padding: 4rpx 14rpx;
}

/* 快捷入口 */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin: 20rpx 24rpx 0;
}
.quick-item {
  padding: 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  font-size: 23rpx;
  color: #1E293B;
  font-weight: 600;
}
.quick-item:active {
  transform: translateY(2rpx);
  opacity: 0.92;
}
.quick-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}

/* 加载 / 重试 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 48rpx;
}
.loading-ring {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid rgba(232, 163, 61, 0.2);
  border-top-color: #E8A33D;
  border-radius: 50%;
  margin-bottom: 24rpx;
  animation: spin 0.9s linear infinite;
}
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.empty-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}
.retry-btn {
  margin-top: 24rpx;
  padding: 14rpx 44rpx;
  background: linear-gradient(135deg, #F6D08A 0%, #E8A33D 48%, #D98F2B 100%);
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx -6rpx rgba(232, 163, 61, 0.55);
}
