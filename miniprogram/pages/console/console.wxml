<!-- 工业智能终端控制台 · Solar-Punk 明亮游戏化 HUD -->
<page-meta root-font-size="16" page-style="{{pageStyle}}" />
<view class="fx-bg">
  <view class="fx-hex"></view>
  <view class="fx-particles"></view>
  <view class="fx-bloom"></view>
</view>

<view class="page-body">
  <!-- 顶部仪器状态条与导航 -->
  <view class="cs-header">
    <view class="cs-header-top">
      <view class="cs-header-left">
        <text class="cs-mono">v{{version}}</text>
        <text class="cs-divider">|</text>
        <text class="cs-status">5G·IND-RTK</text>
        <text class="cs-divider">|</text>
        <text class="cs-status">延迟 3.8ms</text>
      </view>
      <view class="cs-header-right">
        <text id="live-clock" class="cs-clock">{{currentTime}}</text>
        <view class="chip-cyan cs-utc">UTC+8</view>
      </view>
    </view>

    <view class="cs-main-row">
      <view class="cs-title-group">
        <view class="cs-icon-box">📱</view>
        <view>
          <view class="cs-title-row">
            <text class="cs-title">现场作业控制台</text>
            <view class="chip-titanium cs-ver">v{{version}}</view>
          </view>
          <text class="cs-sub">热轧第二分厂 · 核心机组作业区</text>
        </view>
      </view>
      <view class="cs-actions">
        <view class="cs-bell" bindtap="goNotifications">
          <text>🔔</text>
          <view class="cs-bell-dot"></view>
        </view>
        <view class="cs-avatar" bindtap="goProfile">{{userInfo.avatarChar}}</view>
      </view>
    </view>
  </view>

  <main class="cs-content">
    <view class="content-inner">

      <!-- 身份与终端标定卡 -->
      <view class="hud-card cs-identity">
        <view class="hud-accent-top"></view>
        <view class="cs-identity-top">
          <view class="flex items-center gap-compact">
            <view class="cs-emp">
              <text class="cs-emp-label">工号</text>
              <text class="cs-emp-id">{{userInfo.employeeId}}</text>
            </view>
            <view>
              <view class="flex items-center gap-compact">
                <text class="cs-name">{{userInfo.name}}</text>
                <view class="chip-cyan">{{userInfo.role}}</view>
              </view>
              <text class="cs-meta">工位 {{userInfo.station}} / {{userInfo.area}}</text>
            </view>
          </view>
          <view class="cs-identity-right">
            <view class="chip-green-solid">在岗执勤</view>
            <text class="cs-cert">证书: {{userInfo.certificate}}</text>
          </view>
        </view>

        <view class="cs-param-grid">
          <view class="cs-param-cell">
            <text class="cs-param-label">离线基准库</text>
            <text class="cs-param-sync">
              <view class="cs-param-dot-sync"></view>
              100% 已同步
            </text>
          </view>
          <view class="cs-param-cell">
            <text class="cs-param-label">安全等级</text>
            <text class="text-gold-deep font-bold">{{userInfo.safetyLevel}}</text>
          </view>
        </view>
      </view>

      <!-- 预警栏 -->
      <view class="hud-card cs-warning">
        <view class="flex items-center justify-between">
          <view class="flex items-center gap-compact">
            <view class="chip-gold">{{warning.id}}</view>
            <text class="cs-warning-title">{{warning.title}}</text>
          </view>
          <text class="cs-mono cs-time">{{warning.time}}</text>
        </view>
        <text class="cs-warning-desc">
          1#高压水泵站出口压力波动处于监测排查状态。进入精轧区前，<text class="text-gold-deep font-bold">强制执行双人机械联锁核验</text>。
        </text>
        <view class="flex items-center justify-between cs-warning-foot">
          <text class="cs-meta">责任人: {{warning.responsible}}</text>
          <text class="cs-meta">回执状态: <text class="text-gold-deep font-bold">{{warning.status}}</text></text>
        </view>
      </view>

      <!-- 核心生产指标 -->
      <view class="hud-card cs-metrics">
        <view class="flex items-center justify-between">
          <view class="flex items-center gap-compact">
            <view class="cs-metrics-dot"></view>
            <text class="cs-metrics-title">本班考核指标</text>
          </view>
          <view class="cs-progress-group">
            <view class="cs-progress-bar">
              <view class="cs-progress-fill" style="width: {{shiftProgress}}%"></view>
            </view>
            <text class="cs-mono cs-progress-text">{{shiftProgress}}%</text>
          </view>
        </view>

        <view class="cs-metrics-grid">
          <view class="cs-metric-cell">
            <text class="cs-metric-label">01.巡检点</text>
            <view class="flex items-baseline gap-nano">
              <text class="cs-metric-num text-sky">{{metrics.patrolPoints}}</text>
              <text class="cs-metric-unit">点</text>
            </view>
            <text class="cs-metric-foot">待执行</text>
          </view>
          <view class="cs-metric-cell cs-metric-warn">
            <text class="cs-metric-label">02.维修项</text>
            <view class="flex items-baseline gap-nano">
              <text class="cs-metric-num text-gold-deep">{{metrics.repairItems}}</text>
              <text class="cs-metric-unit">项</text>
            </view>
            <view class="cs-metric-foot-row">
              <text>处理中</text>
              <view class="pulse-dot"></view>
            </view>
          </view>
          <view class="cs-metric-cell">
            <text class="cs-metric-label">03.待验签</text>
            <view class="flex items-baseline gap-nano">
              <text class="cs-metric-num">{{metrics.pendingAcceptance}}</text>
              <text class="cs-metric-unit">单</text>
            </view>
            <text class="cs-metric-foot">待签字</text>
          </view>
          <view class="cs-metric-cell">
            <text class="cs-metric-label">04.已闭环</text>
            <view class="flex items-baseline gap-nano">
              <text class="cs-metric-num text-success">{{metrics.completed}}</text>
              <text class="cs-metric-unit">闭环</text>
            </view>
            <text class="cs-metric-foot cs-metric-foot-ok">100% 合规</text>
          </view>
        </view>
      </view>

      <!-- 金刚区 -->
      <view class="section-title-row">
        <view class="section-title-dot"></view>
        <view class="section-title-text">核心现场操作</view>
        <view class="section-title-sub">防误触大按键 · IP67 防护</view>
      </view>
      <view class="cs-actions-grid">
        <button class="glass-card cs-action" bindtap="scanInspection">
          <view class="cs-action-top">
            <view class="cs-action-icon cs-icon-cyan">📷</view>
          </view>
          <text class="cs-action-mode">射频/光学扫描</text>
          <text class="cs-action-title">扫码巡检</text>
          <text class="cs-action-desc">离线测点匹配</text>
        </button>

        <button class="glass-card cs-action" bindtap="goMyOrders">
          <view class="cs-action-top">
            <view class="cs-action-icon">✅</view>
            <view class="chip-gold cs-action-badge">{{myOrdersCount}} 待办</view>
          </view>
          <text class="cs-action-mode">工单队列</text>
          <text class="cs-action-title">我的工单</text>
          <text class="cs-action-desc">检修消缺闭环</text>
        </button>

        <button class="glass-card cs-action cs-action-hot" bindtap="reportAnomaly">
          <view class="cs-action-top">
            <view class="cs-action-icon cs-icon-gold">⚠️</view>
            <view class="chip-gold cs-action-badge">极速上报</view>
          </view>
          <text class="cs-action-mode text-gold-deep">紧急处置</text>
          <text class="cs-action-title text-gold-deep">异常上报</text>
          <text class="cs-action-desc">测振/测温/泄漏</text>
        </button>

        <button class="glass-card cs-action" bindtap="goKnowledge">
          <view class="cs-action-top">
            <view class="cs-action-icon">📖</view>
          </view>
          <text class="cs-action-mode">标准化作业指导书</text>
          <text class="cs-action-title">规程知识库</text>
          <text class="cs-action-desc">数字规程与预案</text>
        </button>

        <button class="glass-card cs-action" bindtap="goEquipment">
          <view class="cs-action-top">
            <view class="cs-action-icon">⚙️</view>
          </view>
          <text class="cs-action-mode">数字化设备台账</text>
          <text class="cs-action-title">设备台账</text>
          <text class="cs-action-desc">履历/图纸/参数</text>
        </button>

        <button class="glass-card cs-action" bindtap="goSafetyTicket">
          <view class="cs-action-top">
            <view class="cs-action-icon">🛡️</view>
          </view>
          <text class="cs-action-mode">高危作业许可证</text>
          <text class="cs-action-title">安全工作票</text>
          <text class="cs-action-desc">动火/受限空间</text>
        </button>
      </view>

      <!-- 就近测点推荐 -->
      <view class="hud-card cs-points">
        <view class="flex items-center justify-between">
          <view class="flex items-center gap-compact">
            <text class="text-sky">📍</text>
            <text class="cs-points-title">附近测点 // 就近感知</text>
          </view>
          <view class="chip-cyan cs-distance">
            <view class="cs-distance-dot"></view>
            <text>18.4米</text>
          </view>
        </view>
        <view class="flex items-center justify-between cs-points-row">
          <view class="flex items-center gap-compact">
            <view class="cs-point-id">
              <text class="cs-point-id-label">测点</text>
              <text class="cs-point-id-value">#03</text>
            </view>
            <view>
              <view class="flex items-center gap-compact">
                <text class="cs-point-name">2#精轧减速机测温振点</text>
                <text class="cs-mono cs-point-code">F2-M04</text>
              </view>
              <view class="flex items-center gap-compact cs-point-meta">
                <text class="flex items-center gap-nano"><view class="cs-cycle-dot"></view>周期 2.0 小时</text>
                <text>红外/测振探头</text>
              </view>
            </view>
          </view>
          <button class="btn-gold cs-checkin" bindtap="checkinPoint">
            <text>测点签到</text>
            <text>→</text>
          </button>
        </view>
      </view>

      <view class="safe-bottom"></view>
    </view>
  </main>
</view>
