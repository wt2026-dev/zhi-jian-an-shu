/* console.wxss - 工业智能终端控制台 · Solar-Punk（fx-bg/page-body/hud-card/chip-* 来自全局） */

/* 本页间距/布局工具 */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-1 { flex: 1; }
.items-center { align-items: center; }
.items-baseline { align-items: baseline; }
.justify-between { justify-content: space-between; }
.justify-center { justify-content: center; }
.min-w-0 { min-width: 0; }
.gap-compact { gap: 12rpx; }
.gap-nano { gap: 4rpx; }

.cs-mono { font-family: "DIN Alternate", monospace; }
.cs-meta { font-size: 20rpx; color: #94A3B8; }

/* 顶部 */
.cs-header {
  padding: 16rpx 24rpx 8rpx;
}
.cs-header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.cs-header-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.cs-divider { color: #CBD5E1; }
.cs-status { font-size: 19rpx; color: #64748B; }
.cs-header-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.cs-clock {
  font-size: 22rpx;
  font-weight: 700;
  color: #0F172A;
  font-family: "DIN Alternate", monospace;
}
.cs-utc { font-size: 18rpx; padding: 3rpx 12rpx; }

.cs-main-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.cs-title-group {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.cs-icon-box {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #F6D08A, #E8A33D);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  box-shadow: 0 6rpx 16rpx -6rpx rgba(232, 163, 61, 0.5);
}
.cs-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.cs-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #0F172A;
}
.cs-ver { font-size: 17rpx; padding: 3rpx 10rpx; }
.cs-sub {
  display: block;
  font-size: 20rpx;
  color: #94A3B8;
  margin-top: 3rpx;
}
.cs-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.cs-bell {
  position: relative;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid #DCE6F2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}
.cs-bell-dot {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #E8A33D;
  box-shadow: 0 0 0 3rpx rgba(232, 163, 61, 0.25);
}
.cs-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #67E8F9, #06B6D4);
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 内容 */
.cs-content { padding: 0 0 24rpx; }
.content-inner {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 8rpx 24rpx 0;
}

/* 身份卡 */
.cs-identity { padding: 22rpx 24rpx; }
.cs-identity-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}
.cs-emp {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  background: rgba(232, 163, 61, 0.12);
  border: 1rpx solid rgba(232, 163, 61, 0.35);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.cs-emp-label { font-size: 18rpx; color: #94A3B8; }
.cs-emp-id {
  font-size: 22rpx;
  font-weight: 800;
  color: #B8761F;
  font-family: "DIN Alternate", monospace;
}
.cs-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #0F172A;
}
.cs-identity-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}
.chip-green-solid {
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #34D399, #10B981);
}
.cs-cert { font-size: 18rpx; color: #94A3B8; }

.cs-param-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(220, 230, 242, 0.8);
}
.cs-param-cell {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.cs-param-label { font-size: 19rpx; color: #94A3B8; }
.cs-param-sync {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #0B5E7A;
}
.cs-param-dot-sync {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #06B6D4;
}

/* 预警卡 */
.cs-warning { padding: 22rpx 24rpx; }
.cs-warning-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #0F172A;
}
.cs-time { font-size: 19rpx; color: #94A3B8; }
.cs-warning-desc {
  display: block;
  font-size: 22rpx;
  color: #64748B;
  line-height: 1.6;
  margin: 14rpx 0;
}
.cs-warning-foot { margin-top: 4rpx; }

/* 指标卡 */
.cs-metrics { padding: 22rpx 24rpx; }
.cs-metrics-dot {
  width: 10rpx;
  height: 24rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #E8A33D, #0EA5E9);
}
.cs-metrics-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #0F172A;
}
.cs-progress-group {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  max-width: 220rpx;
}
.cs-progress-bar {
  flex: 1;
  height: 10rpx;
  border-radius: 6rpx;
  background: #E8EEF6;
  overflow: hidden;
}
.cs-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #F6D08A, #E8A33D);
}
.cs-progress-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #B8761F;
}

.cs-metrics-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-top: 18rpx;
}
.cs-metric-cell {
  background: rgba(248, 251, 255, 0.8);
  border: 1rpx solid #DCE6F2;
  border-radius: 16rpx;
  padding: 16rpx;
}
.cs-metric-warn {
  background: rgba(254, 243, 214, 0.6);
  border-color: rgba(232, 163, 61, 0.35);
}
.cs-metric-label { font-size: 19rpx; color: #94A3B8; }
.cs-metric-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #0F172A;
  font-family: "DIN Alternate", monospace;
  line-height: 1.1;
}
.cs-metric-unit { font-size: 19rpx; color: #94A3B8; }
.cs-metric-foot { font-size: 19rpx; color: #94A3B8; margin-top: 6rpx; }
.cs-metric-foot-ok { color: #10B981; }
.cs-metric-foot-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 19rpx;
  color: #B8761F;
  margin-top: 6rpx;
}
.pulse-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #E8A33D;
  animation: ping 1.2s infinite;
}

/* 金刚区 */
.cs-actions-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}
.cs-action {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6rpx;
  padding: 20rpx;
  text-align: left;
  border-radius: 20rpx;
  line-height: 1.4;
}
.cs-action::after { border: none; }
.cs-action-top {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}
.cs-action-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: rgba(220, 230, 242, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}
.cs-icon-cyan { background: rgba(6, 182, 212, 0.12); }
.cs-icon-gold { background: rgba(232, 163, 61, 0.14); }
.cs-action-hot {
  border-color: rgba(232, 163, 61, 0.45);
  box-shadow: 0 0 0 1rpx rgba(232, 163, 61, 0.35), 0 10rpx 26rpx -14rpx rgba(232, 163, 61, 0.5);
}
.cs-action-badge {
  font-size: 17rpx;
  padding: 3rpx 12rpx;
}
.cs-action-mode { font-size: 18rpx; color: #94A3B8; }
.cs-action-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #0F172A;
}
.cs-action-desc { font-size: 18rpx; color: #94A3B8; }

/* 测点卡 */
.cs-points { padding: 22rpx 24rpx; }
.cs-points-title { font-size: 24rpx; font-weight: 700; color: #0F172A; }
.cs-distance {
  font-size: 18rpx;
  padding: 4rpx 14rpx;
}
.cs-distance-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #06B6D4;
}
.cs-points-row {
  margin-top: 18rpx;
  gap: 14rpx;
}
.cs-point-id {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: rgba(6, 182, 212, 0.1);
  border: 1rpx solid rgba(6, 182, 212, 0.3);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.cs-point-id-label { font-size: 16rpx; color: #94A3B8; }
.cs-point-id-value {
  font-size: 24rpx;
  font-weight: 800;
  color: #0B5E7A;
  font-family: "DIN Alternate", monospace;
}
.cs-point-name {
  font-size: 23rpx;
  font-weight: 700;
  color: #0F172A;
}
.cs-point-code { font-size: 18rpx; color: #0EA5E9; }
.cs-point-meta { margin-top: 6rpx; font-size: 18rpx; color: #94A3B8; }
.cs-cycle-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #E8A33D;
}
.cs-checkin {
  padding: 0 24rpx;
  height: 64rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}

@keyframes ping {
  75%, 100% { transform: scale(2); opacity: 0; }
}
