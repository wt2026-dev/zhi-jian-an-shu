<view class="page">
  <view class="header">
    <view class="back-btn" bindtap="goBack"><text>←</text></view>
    <view class="header-info">
      <text class="header-label">审批留痕 // 安全合规审计</text>
      <text class="header-title">历史审批与签章</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-box">
    <text class="loading-text">加载中...</text>
  </view>

  <view wx:elif="{{loadError}}" class="error-box">
    <text class="error-text">{{loadError}}</text>
    <view class="retry-btn" bindtap="retry"><text>重试</text></view>
  </view>

  <view wx:elif="{{records.length === 0}}" class="empty-box">
    <text class="empty-icon">📝</text>
    <text class="empty-text">暂无审批记录</text>
  </view>

  <view wx:else class="list">
    <view class="card" wx:for="{{records}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="card-header">
        <text class="permit-no">{{item.permitNo}}</text>
        <view class="badge {{item.signed ? 'badge-signed' : 'badge-unsigned'}}">
          {{item.signed ? '已签章' : '未签署'}}
        </view>
      </view>
      <text class="card-title">{{item.title}}</text>
      <view class="info-row">
        <text class="info-label">审批节点</text>
        <text class="info-value">{{item.node}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">审批人</text>
        <text class="info-value">{{item.approver}} {{item.role ? '(' + item.role + ')' : ''}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">审批时间</text>
        <text class="info-value">{{item.signedAt || '--'}}</text>
      </view>
      <view class="comment-box" wx:if="{{item.comment}}">
        <text class="comment-text">审批意见：{{item.comment}}</text>
      </view>
    </view>
  </view>
</view>
