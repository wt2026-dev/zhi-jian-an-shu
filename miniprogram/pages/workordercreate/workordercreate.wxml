<!-- 作业票创建（作业流程版）· Solar-Punk Bright Game-HUD -->
<view class="fx-bg">
  <view class="fx-hex"></view>
  <view class="fx-particles"></view>
  <view class="fx-bloom"></view>
</view>

<view class="page-body">
  <!-- 顶部操作栏 -->
  <view class="top-bar safe-top">
    <view class="back-chip" bindtap="goBack">
      <text class="back-arrow">←</text>
      <text>返回</text>
    </view>
    <view class="chip-gold compliance-chip">⚖️ GB 30871-2021 合规</view>
  </view>

  <!-- 步骤指示器 -->
  <view class="hud-card stepper-card">
    <view class="stepper-row">
      <view class="step-item step-done">
        <view class="step-circle">1</view>
        <text class="step-label step-label-active">基础信息</text>
      </view>
      <view class="step-line"></view>
      <view class="step-item step-todo">
        <view class="step-circle">2</view>
        <text class="step-label">安全隔离</text>
      </view>
      <view class="step-line"></view>
      <view class="step-item step-todo">
        <view class="step-circle">3</view>
        <text class="step-label">气体联锁</text>
      </view>
      <view class="step-line"></view>
      <view class="step-item step-todo">
        <view class="step-circle">4</view>
        <text class="step-label">审批流</text>
      </view>
    </view>
    <view class="progress-track">
      <view class="progress-bar" style="width: {{progress}}%;"></view>
    </view>
  </view>

  <!-- 模块1：关联检修任务工单 -->
  <view class="hud-card module-card">
    <view class="hud-accent-top"></view>
    <view class="module-head">
      <view class="module-title">
        <text class="module-icon">🔗</text>
        <text>关联检修任务工单</text>
      </view>
      <view class="chip-cyan">状态 · 已核发</view>
    </view>

    <view class="info-strip">
      <view class="info-strip-left">
        <text class="info-strip-label">关联检修工单号</text>
        <text class="order-no">{{workOrder.id}}</text>
      </view>
      <text class="info-strip-title">{{workOrder.title}}</text>
    </view>

    <view class="perm-sub-label">作业类型双重许可 · 已自动匹配安全规程</view>
    <view class="perm-grid">
      <view class="perm-card perm-orange">
        <view class="perm-card-top">
          <text class="perm-icon">🚪</text>
          <text class="perm-check">✓</text>
        </view>
        <text class="perm-name">有限空间作业</text>
        <text class="perm-tag">特级高危许可</text>
      </view>
      <view class="perm-card perm-amber">
        <view class="perm-card-top">
          <text class="perm-icon">🔥</text>
          <text class="perm-check">✓</text>
        </view>
        <text class="perm-name">动火作业</text>
        <text class="perm-tag">一级动火许可</text>
      </view>
    </view>

    <view class="warn-banner">
      <text class="warn-icon">⚠️</text>
      <text>已激活【有限空间 + 动火】联合管控，作业必须配置防爆双向对讲与连续气体监测联动。</text>
    </view>
  </view>

  <!-- 模块2：现场作业核心参数 -->
  <view class="glass-card module-card">
    <view class="module-head">
      <view class="module-title">
        <text class="module-icon">📍</text>
        <text>现场作业核心参数</text>
      </view>
    </view>

    <view class="info-row">
      <text class="info-row-label">作业位置与容器编号</text>
      <view class="info-row-value">
        <text class="info-row-main">{{workArea.location}}</text>
        <view class="chip-cyan chip-sm">{{workArea.partition}}</view>
      </view>
    </view>

    <view class="info-row">
      <view class="info-row-value">
        <text class="info-row-label">作业窗口计划时段</text>
        <text class="info-row-main">📅 {{workArea.startTime}} 至 {{workArea.endTime}}</text>
      </view>
      <text class="duration-tag">额定 {{workArea.duration}}h</text>
    </view>

    <view class="personnel-grid">
      <view class="info-row person-cell">
        <text class="info-row-label">作业负责人（特种持证）</text>
        <text class="person-name">{{personnel.leader.name}}</text>
        <text class="person-sub">{{personnel.leader.title}} · 工号 {{personnel.leader.id}}</text>
      </view>
      <view class="info-row person-cell">
        <text class="info-row-label">专职监护人（全程旁站）</text>
        <text class="person-name">{{personnel.guardian.name}} <text class="chip-cyan chip-inline">已授权</text></text>
        <text class="person-sub">监护证 {{personnel.guardian.license}}</text>
      </view>
    </view>

    <view class="info-row headcount-row">
      <view class="info-row-value">
        <text class="info-row-main">👥 受限空间入内作业人数</text>
        <text class="info-row-sub">标配：正压式呼吸器 + 防爆对讲</text>
      </view>
      <text class="headcount-num">{{workArea.headcount}}<text class="headcount-unit">人</text></text>
    </view>
  </view>

  <!-- 模块3：安全防护措施确认预审 -->
  <view class="glass-card module-card">
    <view class="module-head">
      <view class="module-title">
        <text class="module-icon">✅</text>
        <text>安全防护措施确认预审</text>
      </view>
      <view class="chip-gold chip-sm">{{completedChecks}}/4 项就绪</view>
    </view>

    <view class="check-item" wx:for="{{safetyChecks}}" wx:key="id">
      <text class="check-box">☑️</text>
      <view class="check-body">
        <text class="check-name">{{item.name}}</text>
        <text class="check-code">{{item.code}}</text>
      </view>
      <view class="chip-titanium chip-sm">{{item.status}}</view>
    </view>
  </view>

  <!-- 模块4：审批与流转预案 -->
  <view class="glass-card module-card">
    <view class="module-head">
      <view class="module-title">
        <text class="module-icon">🌳</text>
        <text>审批与流转预案</text>
      </view>
      <text class="module-sub">4 级联合审批链</text>
    </view>

    <view class="approval-flow">
      <view class="flow-node-row flow-current">
        <view class="flow-circle flow-circle-active">1</view>
        <view class="flow-body">
          <text class="flow-title">发起申请（作业票填写）</text>
          <text class="flow-person">{{approvalFlow.node1.person}} · {{approvalFlow.node1.role}}</text>
        </view>
        <view class="chip-gold chip-sm">当前环节</view>
      </view>
      <view class="flow-connector"></view>
      <view class="flow-node-row">
        <view class="flow-circle">2</view>
        <view class="flow-body">
          <text class="flow-title flow-title-dim">现场安全条件双人确认</text>
          <text class="flow-person">{{approvalFlow.node2.person}} · {{approvalFlow.node2.role}}</text>
        </view>
        <text class="flow-todo">待前置完成</text>
      </view>
      <view class="flow-connector"></view>
      <view class="flow-node-row">
        <view class="flow-circle">3</view>
        <view class="flow-body">
          <text class="flow-title flow-title-dim">工艺及设备初审</text>
          <text class="flow-person">{{approvalFlow.node3.person}} · {{approvalFlow.node3.role}}</text>
        </view>
        <text class="flow-todo">待前置完成</text>
      </view>
      <view class="flow-connector"></view>
      <view class="flow-node-row">
        <view class="flow-circle">4</view>
        <view class="flow-body">
          <text class="flow-title flow-title-dim">高危动火与受限空间终审签发</text>
          <text class="flow-person">{{approvalFlow.node4.person}} · {{approvalFlow.node4.role}}</text>
        </view>
        <text class="flow-todo">终审许可</text>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-action-bar">
    <view class="action-bar-inner">
      <button class="btn-glass" bindtap="saveAsTemplate">🔖 存预案模板</button>
      <button class="btn-gold btn-next" bindtap="goNextStep">下一步：危险辨识与隔离配置 →</button>
    </view>
  </view>
  <view class="safe-bottom"></view>
</view>
