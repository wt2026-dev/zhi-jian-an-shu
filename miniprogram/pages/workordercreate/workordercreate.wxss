/* pages/workordercreate/workordercreate.wxss */

@import '../../common.wxss';

/* 页面容器 */
.page-container {
  min-height: 100vh;
  background-color: var(--surface);
}

/* 导航*/
.nav-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background-color: var(--surface);
  border-bottom: 1rpx solid var(--industrial-border);
}

.nav-bar {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.nav-logo {
  width: 8rpx;
  height: 32rpx;
  background-color: var(--primary);
  border-radius: 4rpx;
}

.nav-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--on-surface);
  letter-spacing: -0.5rpx;
}

.nav-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 主内容区 */
.main-content {
  padding-bottom: 160rpx;
}

/* 图标文字 */
.icon-text {
  font-family: 'Material Symbols Outlined';
  font-weight: normal;
  font-style: normal;
  display: inline-block;
  line-height: 1;
}

/* 合规标签 */
.compliance-badge {
  background-color: var(--surface-container-high);
  border-radius: 9999rpx;
}

/* 步骤指示器卡*/
.stepper-card {
  background-color: var(--surface-container-low);
  border-radius: 24rpx;
}

.step-circle {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "DIN Alternate", "Menlo", monospace;
  font-size: 22rpx;
  font-weight: 700;
}

.step-active {
  background-color: var(--primary);
  color: var(--on-primary);
}

.step-inactive {
  background-color: var(--surface-container-highest);
  color: var(--tech-muted);
}

.step-line {
  width: 48rpx;
  height: 4rpx;
  background-color: var(--surface-container-highest);
  border-radius: 2rpx;
}

/* 进度*/
.progress-track {
  width: 100%;
  height: 8rpx;
  background-color: var(--surface-container-highest);
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background-color: var(--primary);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

/* 模块列表 */
.module-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 模块卡片 */
.module-card {
  background-color: var(--surface-container);
}

/* 信息*/
.info-strip {
  background-color: var(--surface-dim);
}

/* 信息*/
.info-row {
  background-color: var(--surface-dim);
}

/* 许可卡片 */
.permit-card {
  background-color: var(--surface-container-high);
}

/* 警告横幅 */
.warning-banner {
  background-color: var(--warning-surface);
}

/* 绿色徽章 */
.badge-green {
  background-color: var(--surface-container-high);
  border-radius: 8rpx;
}

/* 蓝色徽章 */
.badge-blue {
  background-color: var(--surface-container);
  border-radius: 8rpx;
}

/* 最高级徽章 */
.badge-highest {
  background-color: var(--surface-container-highest);
  border-radius: 8rpx;
}

/* 主色徽章 */
.badge-primary {
  background-color: var(--surface-container);
  border-radius: 8rpx;
}

/* 检查项 */
.check-item {
  background-color: var(--surface-dim);
}

/* 审批流程 */
.approval-flow {
  background-color: var(--surface-dim);
}

.flow-node {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "DIN Alternate", "Menlo", monospace;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.flow-node-active {
  background-color: var(--primary);
  color: var(--on-primary);
}

.flow-node-inactive {
  background-color: var(--surface-container-highest);
  color: var(--tech-muted);
}

.flow-connector {
  width: 4rpx;
  height: 24rpx;
  background-color: var(--surface-container-highest);
  margin-left: 22rpx;
}

/* 底部操作*/
.bottom-action-bar {
  padding-bottom: env(safe-area-inset-bottom, 24rpx);
}

.action-bar-inner {
  background-color: var(--surface-container-high);
}

/* 按钮覆盖样式 */
.btn-ghost {
  background: var(--surface-container);
  border: 1rpx solid var(--industrial-border);
  color: var(--on-surface-variant);
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.btn-ghost::after {
  border: none;
}

.btn-primary {
  background: var(--primary);
  color: var(--on-primary);
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.btn-primary::after {
  border: none;
}

/* 阴影工具*/
.shadow-md {
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25);
}

/* 透明*/
.opacity-60 {
  opacity: 0.6;
}

/* 收缩禁止 */
.shrink-0 {
  flex-shrink: 0;
}

/* 最小宽 */
.min-w-0 {
  min-width: 0;
}

/* 文字不换*/
.whitespace-nowrap {
  white-space: nowrap;
}

/* 顶部导航栏 */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--surface-container-low);
}