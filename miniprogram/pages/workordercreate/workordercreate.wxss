/* pages/workordercreate/workordercreate.wxss · Solar-Punk Bright Game-HUD */
@import '../../common.wxss';

page {
  background: linear-gradient(180deg, #F8FBFF 0%, #F1F7FE 55%, #F7F4FF 100%);
  background-color: #F2F7FD;
  min-height: 100vh;
}

.page-body {
  padding-bottom: 200rpx;
}

/* 顶部操作栏 */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
}
.back-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 26rpx;
  color: #1E293B;
  padding: 10rpx 22rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid #DCE6F2;
  border-radius: 999rpx;
}
.back-arrow { font-size: 30rpx; line-height: 1; }
.compliance-chip { font-size: 20rpx; padding: 6rpx 18rpx; }

/* 步骤指示器 */
.stepper-card {
  margin: 4rpx 24rpx 20rpx;
  padding: 24rpx 28rpx;
}
.stepper-row {
  display: flex;
  align-items: flex-start;
}
.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}
.step-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "DIN Alternate", monospace;
  font-size: 24rpx;
  font-weight: 700;
  background: #EDF2F9;
  color: #94A3B8;
  border: 1rpx solid #DCE6F2;
}
.step-done .step-circle {
  background: linear-gradient(135deg, #F6D08A 0%, #E8A33D 100%);
  color: #FFFFFF;
  border: none;
  box-shadow: 0 4rpx 12rpx -4rpx rgba(232, 163, 61, 0.5);
}
.step-label { font-size: 20rpx; color: #94A3B8; }
.step-label-active { color: #B8761F; font-weight: 700; }
.step-line {
  flex: 1;
  height: 2rpx;
  background: #DCE6F2;
  margin: 24rpx 10rpx 0;
}
.progress-track {
  margin-top: 20rpx;
  height: 10rpx;
  border-radius: 5rpx;
  background: #EDF2F9;
  overflow: hidden;
}
.progress-bar {
  height: 100%;
  border-radius: 5rpx;
  background: linear-gradient(90deg, #E8A33D 0%, #06B6D4 100%);
  transition: width 0.3s ease;
}

/* 模块卡片 */
.module-card {
  margin: 0 24rpx 20rpx;
  padding: 24rpx 28rpx;
}
.module-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.module-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: #0F172A;
}
.module-icon { font-size: 26rpx; }
.module-sub { font-size: 20rpx; color: #94A3B8; }
.chip-sm { font-size: 19rpx; padding: 4rpx 14rpx; }
.chip-inline { display: inline-block; padding: 0 10rpx; font-size: 18rpx; }

/* 工单信息条 */
.info-strip {
  background: rgba(241, 247, 254, 0.8);
  border: 1rpx solid #DCE6F2;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.info-strip-left { display: flex; flex-direction: column; gap: 4rpx; }
.info-strip-label { font-size: 19rpx; color: #94A3B8; }
.order-no {
  font-size: 26rpx;
  font-family: "DIN Alternate", monospace;
  font-weight: 700;
  color: #B8761F;
}
.info-strip-title { font-size: 24rpx; color: #1E293B; font-weight: 600; }

/* 双重许可 */
.perm-sub-label {
  font-size: 20rpx;
  color: #94A3B8;
  margin: 18rpx 0 12rpx;
}
.perm-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.perm-card {
  border-radius: 16rpx;
  padding: 18rpx;
  border: 1rpx solid;
}
.perm-orange {
  background: rgba(245, 158, 11, 0.1);
  border-color: rgba(245, 158, 11, 0.35);
}
.perm-amber {
  background: rgba(239, 68, 68, 0.08);
  border-color: rgba(239, 68, 68, 0.3);
}
.perm-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.perm-icon { font-size: 28rpx; }
.perm-check { font-size: 24rpx; font-weight: 700; color: #10B981; }
.perm-name { display: block; font-size: 24rpx; font-weight: 700; color: #1E293B; margin-bottom: 6rpx; }
.perm-tag { font-size: 18rpx; color: #B45309; }
.perm-amber .perm-tag { color: #DC2626; }

/* 警告横幅 */
.warn-banner {
  margin-top: 16rpx;
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  background: rgba(245, 158, 11, 0.12);
  border: 1rpx solid rgba(245, 158, 11, 0.4);
  border-radius: 14rpx;
  padding: 16rpx 18rpx;
  font-size: 21rpx;
  color: #92400E;
  line-height: 1.5;
}
.warn-icon { flex-shrink: 0; }

/* 信息行 */
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(220, 230, 242, 0.7);
}
.info-row:last-child { border-bottom: none; }
.info-row-label { font-size: 20rpx; color: #94A3B8; }
.info-row-value { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.info-row-main { font-size: 24rpx; font-weight: 600; color: #1E293B; }
.info-row-sub { font-size: 19rpx; color: #94A3B8; }
.duration-tag {
  font-size: 20rpx;
  font-family: "DIN Alternate", monospace;
  color: #B45309;
  background: rgba(245, 158, 11, 0.12);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.personnel-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.person-cell { flex-direction: column; align-items: flex-start; gap: 4rpx; }
.person-name { font-size: 24rpx; font-weight: 700; color: #0F172A; }
.person-sub { font-size: 19rpx; color: #94A3B8; }
.headcount-row { align-items: center; }
.headcount-num {
  font-size: 44rpx;
  font-weight: 800;
  font-family: "DIN Alternate", monospace;
  color: #2563EB;
  line-height: 1;
}
.headcount-unit { font-size: 22rpx; color: #94A3B8; font-weight: 400; margin-left: 4rpx; }

/* 检查项 */
.check-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(220, 230, 242, 0.7);
}
.check-item:last-child { border-bottom: none; }
.check-box { font-size: 26rpx; flex-shrink: 0; }
.check-body { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.check-name { font-size: 23rpx; color: #1E293B; font-weight: 500; }
.check-code { font-size: 19rpx; color: #94A3B8; }

/* 审批流 */
.approval-flow { padding-top: 4rpx; }
.flow-node-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.flow-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "DIN Alternate", monospace;
  font-size: 22rpx;
  font-weight: 700;
  background: #EDF2F9;
  color: #94A3B8;
  border: 1rpx solid #DCE6F2;
  flex-shrink: 0;
}
.flow-circle-active {
  background: linear-gradient(135deg, #F6D08A 0%, #E8A33D 100%);
  color: #FFFFFF;
  border: none;
  box-shadow: 0 4rpx 12rpx -4rpx rgba(232, 163, 61, 0.5);
}
.flow-body { flex: 1; min-width: 0; }
.flow-title { font-size: 23rpx; font-weight: 700; color: #1E293B; display: block; }
.flow-title-dim { color: #64748B; font-weight: 500; }
.flow-person { font-size: 19rpx; color: #94A3B8; }
.flow-todo { font-size: 19rpx; color: #94A3B8; flex-shrink: 0; }
.flow-connector {
  width: 2rpx;
  height: 24rpx;
  background: #DCE6F2;
  margin-left: 23rpx;
}

/* 底部操作栏 */
.bottom-action-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 16rpx 24rpx calc(20rpx + env(safe-area-inset-bottom, 0px));
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  border-top: 1rpx solid #DCE6F2;
  z-index: 50;
}
.action-bar-inner { display: flex; gap: 14rpx; }
.btn-glass {
  flex-shrink: 0;
  height: 88rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #DCE6F2;
  color: #475569;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-glass::after { border: none; }
.btn-next { flex: 1; height: 88rpx; border-radius: 16rpx; font-size: 26rpx; }
