/* pages/emergency/emergency.wxss - 紧急警报与气体超标 */

@import '../../common.wxss';

page {
  background-color: var(--surface);
  min-height: 100vh;
}

/* 背景光效 */
.bg-error-container-25 {
  background-color: rgba(147, 0, 10, 0.25);
}

.left-50pct {
  left: 50%;
}

.translate-x-minus-50 {
  transform: translateX(-50%);
}

.w-72 {
  width: 576rpx;
}

.h-44 {
  height: 352rpx;
}

.blur-3xl {
  filter: blur(48rpx);
}

/* 警报*/
.bg-on-error-container-30 {
  background-color: rgba(255, 218, 214, 0.3);
}

.w-1-5 {
  width: 12rpx;
}

.h-1-5 {
  height: 12rpx;
}

/* 间距 */
.px-3-5 {
  padding-left: 28rpx;
  padding-right: 28rpx;
}

.pt-3-5 {
  padding-top: 28rpx;
}

.pb-2 {
  padding-bottom: 16rpx;
}

.py-0-5 {
  padding-top: 4rpx;
  padding-bottom: 4rpx;
}

.py-1 {
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.gap-0-5 {
  gap: 4rpx;
}

.gap-1 {
  gap: 8rpx;
}

.gap-2 {
  gap: 16rpx;
}

.gap-3 {
  gap: 24rpx;
}

.mt-0-5 {
  margin-top: 4rpx;
}

/* 阴影 */
.shadow-inner {
  box-shadow: inset 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

/* 状态色 */
.bg-status-green-60 {
  background-color: rgba(34, 197, 94, 0.6);
}

.bg-hazard-amber-70 {
  background-color: rgba(251, 191, 36, 0.7);
}

.bg-white-20 {
  background-color: rgba(255, 255, 255, 0.2);
}

.bg-on-error-80 {
  background-color: rgba(105, 0, 5, 0.8);
}

.text-on-error-80 {
  color: rgba(255, 218, 214, 0.8);
}

/* 宽度百分*/
.w-35pct {
  width: 35%;
}

.w-25pct {
  width: 25%;
}

.w-40pct {
  width: 40%;
}

/* 网格间距 */
.grid-gap-2 {
  grid-gap: 16rpx;
}

/* 文本大小 */
.text-18px {
  font-size: 36rpx;
}

.text-14px {
  font-size: 28rpx;
}

.text-16px {
  font-size: 32rpx;
}

.text-13px {
  font-size: 26rpx;
}

.text-20px {
  font-size: 40rpx;
}

.text-22px {
  font-size: 44rpx;
}

.text-12px {
  font-size: 24rpx;
}

.text-10px {
  font-size: 20rpx;
}

.text-9px {
  font-size: 18rpx;
}

.text-telemetry-xl {
  font-family: "DIN Alternate", "Menlo", monospace;
  font-weight: 800;
  font-size: 68rpx;
  line-height: 1;
}

/* 按钮 */
.min-h-120 {
  min-height: 120rpx;
}

.min-w-0 {
  min-width: 0;
}

.flex-1-4 {
  flex: 1.4;
}

.select-none {
  user-select: none;
}

/* 背景模糊 */
.backdrop-blur-xl {
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
}

/* 动画 */
.animate-pulse {
  animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.animate-ping {
  animation: ping 1s cubic-bezier(0, 0, 0.2, 1) infinite;
}

@keyframes ping {
  75%, 100% {
    transform: scale(2);
    opacity: 0;
  }
}

.animate-bounce {
  animation: bounce 1s infinite;
}

@keyframes bounce {
  0%, 100% {
    transform: translateY(-5%);
    animation-timing-function: cubic-bezier(0.8, 0, 1, 1);
  }
  50% {
    transform: translateY(0);
    animation-timing-function: cubic-bezier(0, 0, 0.2, 1);
  }
}

/* 禁止选择 */
.select-none {
  -webkit-user-select: none;
  user-select: none;
}

/* 安全区域 */
.pb-safe {
  padding-bottom: env(safe-area-inset-bottom, 20rpx);
}

.pt-safe {
  padding-top: env(safe-area-inset-top, 0);
}
