<!-- 应急管理 · 高危气体超标告警 · Solar-Punk Bright Game-HUD -->
<view class="fx-bg">
  <view class="fx-hex"></view>
  <view class="fx-particles"></view>
  <view class="fx-bloom"></view>
</view>

<view class="page-body safe-top">
  <!-- 顶部高危警报条 -->
  <view class="alarm-topbar">
    <view class="alarm-topbar-left">
      <text class="alarm-emoji">🚨</text>
      <text class="alarm-topbar-text">高危警报 // 硬件安全联锁已触发</text>
    </view>
    <view class="force-stop">
      <view class="force-dot"></view>
      <text>强制停工</text>
    </view>
  </view>

  <!-- 主告警卡 -->
  <view class="hud-card alarm-card">
    <view class="alarm-headline-row">
      <text class="alarm-headline">作业立即中止 · 全员撤离</text>
      <text class="alarm-std">GB 30871-2021</text>
    </view>
    <text class="alarm-sub">受限空间剧毒有害气体超过国家极限允许浓度，触发防爆硬件一票否决强关机制。</text>

    <!-- H2S 主危险气体 -->
    <view class="gas-main">
      <view class="gas-main-head">
        <view class="gas-name-row">
          <view class="gas-badge">剧毒高危气体</view>
          <text class="gas-name">硫化氢 (H₂S)</text>
        </view>
        <view class="gas-over">📈 超标 +102.8%</view>
      </view>

      <view class="gas-readings">
        <view class="gas-value-row">
          <text class="gas-value">{{h2sReading.value}}</text>
          <text class="gas-unit">ppm</text>
        </view>
        <view class="gas-limit">
          <text class="gas-limit-label">法定安全阈值限值</text>
          <text class="gas-limit-val">≤ 7.0 <text class="gas-limit-sub">ppm</text></text>
        </view>
      </view>

      <view class="gas-bar">
        <view class="gas-bar-seg seg-green"></view>
        <view class="gas-bar-seg seg-amber"></view>
        <view class="gas-bar-seg seg-red"></view>
      </view>
      <view class="gas-bar-scale">
        <text>0.0 安全</text>
        <text class="scale-amber">7.0 极限红线</text>
        <text class="scale-red">14.2 致死临界</text>
      </view>

      <view class="danger-tip">
        <text>⚠️</text>
        <text>危险状态：立即威胁生命与健康（极度危险响应）</text>
      </view>
    </view>

    <!-- 关联监测点 -->
    <view class="sensor-section">
      <view class="sensor-head">
        <text class="sensor-title">关联监测点阵数据</text>
        <text class="sensor-grid">网格传感器组 #04</text>
      </view>
      <view class="sensor-grid-cards">
        <view class="sensor-card">
          <view class="sensor-card-head">
            <text class="sensor-name">可燃气 LEL</text>
            <view class="sensor-dot dot-amber"></view>
          </view>
          <view class="sensor-value-row">
            <text class="sensor-value val-amber">{{lelReading}}</text>
            <text class="sensor-unit">%</text>
          </view>
          <text class="sensor-limit">限值 ≤1.0%</text>
        </view>
        <view class="sensor-card">
          <view class="sensor-card-head">
            <text class="sensor-name">氧气 O₂</text>
            <view class="sensor-dot dot-red"></view>
          </view>
          <view class="sensor-value-row">
            <text class="sensor-value val-red">{{o2Reading}}</text>
            <text class="sensor-unit">%VOL</text>
          </view>
          <text class="sensor-limit val-red">严重缺氧</text>
        </view>
        <view class="sensor-card">
          <view class="sensor-card-head">
            <text class="sensor-name">一氧化碳 CO</text>
            <view class="sensor-dot dot-amber"></view>
          </view>
          <view class="sensor-value-row">
            <text class="sensor-value val-amber">{{coReading}}</text>
            <text class="sensor-unit">ppm</text>
          </view>
          <text class="sensor-limit">限值 ≤20ppm</text>
        </view>
      </view>
    </view>

    <!-- 硬件联锁存证 -->
    <view class="interlock-section">
      <view class="interlock-head">
        <text class="interlock-title">🔒 硬件联锁自动执行存证</text>
        <view class="chip-success chip-sm">3/3 序列已闭环</view>
      </view>

      <view class="interlock-item">
        <text class="interlock-icon">🚫</text>
        <view class="interlock-body">
          <view class="interlock-row">
            <text class="interlock-name">作业票熔断 · 门禁闭锁</text>
            <text class="interlock-state state-red">已强锁</text>
          </view>
          <text class="interlock-desc">PTW-20241018-0089 状态变更为【红牌中止】，现场防爆门禁锁死防进。</text>
        </view>
      </view>

      <view class="interlock-item">
        <text class="interlock-icon">💨</text>
        <view class="interlock-body">
          <view class="interlock-row">
            <text class="interlock-name">防爆离心风机全速强排</text>
            <text class="interlock-state state-green">已强开</text>
          </view>
          <text class="interlock-desc">罐体动力强排单元输出提升至最高档（4500 m³/h 稀释气体）。</text>
        </view>
      </view>

      <view class="interlock-item">
        <text class="interlock-icon">🔔</text>
        <view class="interlock-body">
          <view class="interlock-row">
            <text class="interlock-name">全域声光直报安环总控</text>
            <text class="interlock-state state-green">已联动</text>
          </view>
          <text class="interlock-desc">声光报警器全频响彻，高危事故信令直达主控大屏与应急值班台。</text>
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="alarm-actions">
      <button class="btn-call" bindtap="callDispatch">
        <text class="btn-call-icon">📞</text>
        <view class="btn-call-text">
          <text class="btn-call-main">直拨安环调度</text>
          <text class="btn-call-sub">分机号：8088</text>
        </view>
      </button>
      <button class="btn-evac" bindtap="confirmEvacuation">
        <text class="btn-evac-icon">🏃</text>
        <view class="btn-evac-text">
          <text class="btn-evac-main">全员撤离响应</text>
          <text class="btn-evac-sub">立即确认全员撤离</text>
        </view>
      </button>
    </view>
  </view>

  <!-- 底部系统信息 -->
  <view class="sys-footer">
    <text>PLC-NODE: A4-RACK-09</text>
    <text>防伪凭证: SHA256-BLK-9821</text>
    <text class="sys-ok">校验正常</text>
  </view>
  <view class="safe-bottom"></view>
</view>
