/* pages/safety/detail.wxss · Solar-Punk Bright Game-HUD */
page {
  background: linear-gradient(180deg, #F8FBFF 0%, #F1F7FE 55%, #F7F4FF 100%);
  background-color: #F2F7FD;
  min-height: 100vh;
}

.page-body { padding: 20rpx 0 40rpx; }
.sp { flex: 1; }

/* 加载 */
.loading-state { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.loading-ring {
  width: 56rpx; height: 56rpx;
  border: 6rpx solid rgba(139, 92, 246, 0.2);
  border-top-color: #8B5CF6;
  border-radius: 50%; margin-bottom: 24rpx;
  animation: spin 0.9s linear infinite;
}
.loading-text { font-size: 26rpx; color: #737373; }

/* 主卡 */
.main-card { margin: 0 24rpx 20rpx; padding: 26rpx; }
.permit-head { display: flex; align-items: center; }
.permit-no { font-size: 21rpx; color: #6D28D9; font-family: "DIN Alternate", monospace; font-weight: 700; }
.chip { font-size: 19rpx; padding: 4rpx 14rpx; border-radius: 999rpx; font-weight: 600; }
.permit-title { font-size: 32rpx; font-weight: 800; color: #0F172A; margin: 18rpx 0 8rpx; line-height: 1.35; }
.permit-sub { font-size: 21rpx; color: #64748B; margin-bottom: 16rpx; }

.kv-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  border-top: 1rpx solid rgba(220, 230, 242, 0.6);
}
.kv-label { color: #94A3B8; }
.kv-value { color: #1E293B; font-weight: 500; }
.loto-no { color: #6D28D9; font-family: "DIN Alternate", monospace; font-weight: 700; }
.mono { font-family: "DIN Alternate", monospace; }

/* 分节卡 */
.section-card { margin: 0 24rpx 20rpx; padding: 24rpx 26rpx; }
.section-title { font-size: 26rpx; font-weight: 800; color: #0F172A; margin-bottom: 14rpx; }
.precaution-item { font-size: 22rpx; color: #475569; line-height: 1.7; padding: 6rpx 0; }

/* 表单 */
.form-label { font-size: 22rpx; color: #475569; margin: 10rpx 0 10rpx; font-weight: 600; }
.glass-textarea {
  width: 100%;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid #DCE6F2;
  border-radius: 14rpx;
  padding: 16rpx 18rpx;
  font-size: 23rpx;
  color: #0F172A;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

/* 按钮 */
.btn {
  width: 100%;
  height: 84rpx;
  border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 25rpx; font-weight: 700;
  margin-bottom: 14rpx;
}
.btn::after { border: none; }
.btn-approve {
  background: linear-gradient(135deg, #34D399, #10B981);
  color: #FFFFFF;
  box-shadow: 0 6rpx 16rpx -6rpx rgba(16, 185, 129, 0.6);
}
.btn-reject {
  background: #FFFFFF;
  border: 1rpx solid #FECACA;
  color: #DC2626;
}

@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
