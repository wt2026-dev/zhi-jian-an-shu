<!-- 作业票 / LOTO 看板 · Solar-Punk Bright Game-HUD -->
<view class="fx-bg">
  <view class="fx-hex"></view>
  <view class="fx-particles"></view>
  <view class="fx-bloom"></view>
</view>

<view class="page-body">
  <!-- LOTO 能量隔离联锁看板 -->
  <view class="hud-card loto-banner">
    <view class="hud-accent-top"></view>
    <view class="loto-title">🔐 LOTO 能量隔离联锁看板</view>
    <view wx:if="{{locks.length === 0}}" class="loto-empty">加载中或无锁具数据</view>
    <view wx:for="{{locks}}" wx:key="id" class="lockrow">
      <view class="lock-badge {{item.status === 'locked' ? 'lk-on' : 'lk-off'}}">{{item.status === 'locked' ? '🔒' : '🔓'}}</view>
      <view class="lock-col">
        <view class="lock-no">{{item.lockNo}}</view>
        <view class="lock-sub">{{item.pointName}} · {{item.lockedBy}}</view>
      </view>
      <view class="chip" style="{{item.badgeStyle}}">{{item.statusText}}</view>
    </view>
  </view>

  <!-- 状态 tabs -->
  <scroll-view class="tab-bar" scroll-x enable-flex>
    <view class="tab-item {{cur === item.k ? 'tab-active' : ''}}" wx:for="{{tabs}}" wx:key="k" bindtap="onTab" data-k="{{item.k}}">{{item.t}}</view>
  </scroll-view>

  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-ring"></view>
    <text class="loading-text">加载中...</text>
  </view>
  <view class="empty-state" wx:elif="{{list.length === 0}}">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无作业票</text>
  </view>

  <view class="glass-card permit-card" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
    <view class="permit-head">
      <view class="permit-no">{{item.permitNo}}</view>
      <view class="sp"></view>
      <view class="chip" style="{{item.sStyle}}">{{item.sText}}</view>
    </view>
    <view class="permit-title">{{item.title}}</view>
    <view class="permit-meta">{{item.permitType}} · {{item.riskLevel}} · {{item.workshop}}</view>
  </view>
  <view class="safe-bottom"></view>
</view>
