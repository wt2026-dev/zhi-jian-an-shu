<view class="searchbar"><input class="input" style="margin-bottom:0" placeholder="搜索设备名称 / 编码" value="{{kw}}" bindinput="onKw" /></view>
<view wx:if="{{loading}}" class="empty">加载中...</view>
<view wx:elif="{{view.length === 0}}" class="empty">未找到匹配设备</view>
<view class="card" wx:for="{{view}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
  <view class="row">
    <view class="title">{{item.name}}</view>
    <view class="sp"></view>
    <view class="badge" style="{{item.sStyle}}">{{item.sText}}</view>
  </view>
  <view class="muted mono" style="margin:8rpx 0">{{item.code}} · {{item.model}}</view>
  <view class="row">
    <view class="muted">{{item.workshop}}</view>
    <view class="sp"></view>
    <view class="mono" style="color:{{item.hColor}};font-size:32rpx;font-weight:800">{{item.healthScore}}分</view>
  </view>
</view>
<view class="safe-bottom"></view>