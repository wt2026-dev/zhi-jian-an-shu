/* equip/detail.wxss - 设备详情 · Solar-Punk */
@import '../../common.wxss';

page {
  background: linear-gradient(180deg, #F8FBFF 0%, #F1F7FE 55%, #F7F4FF 100%);
  background-color: #F2F7FD;
  min-height: 100vh;
}

/* 加载中 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 48rpx;
}
.loading-ring {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid rgba(232, 163, 61, 0.2);
  border-top-color: #E8A33D;
  border-radius: 50%;
  margin-bottom: 24rpx;
  animation: spin 0.9s linear infinite;
}
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.loading-text {
  font-size: 26rpx;
  color: #94A3B8;
}

/* 一、主档案卡 */
.eq-hero {
  position: relative;
  margin: 20rpx 24rpx;
  padding: 28rpx;
}
.eq-hero-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.eq-hero-name {
  flex: 1;
  min-width: 0;
  font-size: 36rpx;
  font-weight: 800;
  color: #0F172A;
  line-height: 1.3;
  padding-right: 16rpx;
}
.status-capsule {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  line-height: 1.3;
}
.eq-hero-code {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  font-size: 22rpx;
  color: #64748B;
  margin-bottom: 10rpx;
}
.eq-code {
  font-family: "DIN Alternate", monospace;
  font-weight: 700;
  color: #B8761F;
  background: rgba(232, 163, 61, 0.1);
  border: 1rpx solid rgba(232, 163, 61, 0.3);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}
.eq-dot { color: #CBD5E1; }
.eq-hero-loc {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #64748B;
}
.eq-loc-icon { font-size: 20rpx; }
.eq-hero-health {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed rgba(220, 230, 242, 0.9);
}
.eq-health-chip {
  display: inline-flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 10rpx 22rpx;
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid rgba(220, 230, 242, 0.9);
  border-radius: 999rpx;
}
.eq-health-chip-label {
  font-size: 20rpx;
  color: #94A3B8;
}
.eq-health-chip-value {
  font-size: 34rpx;
  font-weight: 800;
  font-family: "DIN Alternate", monospace;
  line-height: 1;
}

/* 区域标题外边距 */
.page-body > .section-title-row {
  margin: 24rpx 24rpx 14rpx;
}

/* 二、遥测 2×2 玻璃格 */
.tele-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin: 0 24rpx 8rpx;
}
.tele-cell {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.tele-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  margin-bottom: 12rpx;
}
.tele-value {
  font-size: 38rpx;
  font-weight: 800;
  color: #0F172A;
  font-family: "DIN Alternate", monospace;
  line-height: 1.15;
}
.tele-unit {
  font-size: 20rpx;
  font-weight: 600;
  color: #94A3B8;
  margin-left: 4rpx;
}
.tele-label {
  font-size: 20rpx;
  color: #64748B;
  margin-top: 6rpx;
}

/* 三、技术参数 */
.spec-card {
  margin: 0 24rpx 8rpx;
  padding: 8rpx 24rpx;
}
.spec-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(220, 230, 242, 0.6);
  font-size: 24rpx;
}
.spec-row:last-child { border-bottom: none; }
.spec-k { color: #64748B; }
.spec-v {
  color: #1E293B;
  font-weight: 600;
  text-align: right;
}
.spec-empty {
  padding: 32rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #94A3B8;
}

/* 四、维修履历 */
.mh-card {
  margin: 0 24rpx 8rpx;
  padding: 12rpx 24rpx;
}
.mh-item {
  display: flex;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(220, 230, 242, 0.6);
}
.mh-item:last-child { border-bottom: none; }
.mh-left-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8A33D, #0EA5E9);
  margin: 8rpx 16rpx 0 0;
  flex-shrink: 0;
  box-shadow: 0 0 0 4rpx rgba(232, 163, 61, 0.15);
}
.mh-body { flex: 1; min-width: 0; }
.mh-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}
.mh-order {
  font-size: 22rpx;
  font-family: "DIN Alternate", monospace;
  font-weight: 700;
  color: #B8761F;
}
.mh-date {
  font-size: 20rpx;
  color: #94A3B8;
  font-family: "DIN Alternate", monospace;
}
.mh-summary {
  font-size: 24rpx;
  color: #1E293B;
  line-height: 1.5;
  margin-bottom: 6rpx;
}
.mh-cost {
  font-size: 20rpx;
  color: #64748B;
}
