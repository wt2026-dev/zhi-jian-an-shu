/* equip/list.wxss - 设备台账 · Solar-Punk */
@import '../../common.wxss';

page {
  background: linear-gradient(180deg, #F8FBFF 0%, #F1F7FE 55%, #F7F4FF 100%);
  background-color: #F2F7FD;
  min-height: 100vh;
}

.page-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 顶部搜索条（玻璃条） */
.search-shell {
  position: sticky;
  top: 0;
  z-index: 10;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  border-bottom: 1rpx solid rgba(220, 230, 242, 0.8);
  padding: 18rpx 24rpx;
}
.search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(220, 230, 242, 0.9);
  border-radius: 999rpx;
  padding: 14rpx 24rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}
.search-icon { font-size: 26rpx; }
.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1E293B;
}

.equip-scroll { flex: 1; }

/* 加载中 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}
.loading-ring {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid rgba(232, 163, 61, 0.2);
  border-top-color: #E8A33D;
  border-radius: 50%;
  margin-bottom: 24rpx;
  animation: spin 0.9s linear infinite;
}
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.loading-text {
  font-size: 26rpx;
  color: #94A3B8;
}

/* 设备卡片 */
.equip-card {
  margin: 20rpx 24rpx;
  padding: 24rpx 28rpx;
}
.equip-card:active {
  transform: translateY(2rpx);
  opacity: 0.92;
}
.equip-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.equip-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: #0F172A;
  line-height: 1.35;
  padding-right: 16rpx;
}
.status-capsule {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  line-height: 1.3;
}
.equip-code-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: #64748B;
}
.equip-code {
  font-family: "DIN Alternate", monospace;
  font-weight: 700;
  color: #B8761F;
  background: rgba(232, 163, 61, 0.1);
  border: 1rpx solid rgba(232, 163, 61, 0.3);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}
.equip-dot { color: #CBD5E1; }
.equip-model {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.equip-divider {
  height: 1rpx;
  background: rgba(220, 230, 242, 0.8);
  margin: 16rpx 0;
}
.equip-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.equip-workshop {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #64748B;
}
.equip-workshop-icon { font-size: 20rpx; }
.equip-health {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}
.equip-health-label {
  font-size: 20rpx;
  color: #94A3B8;
}
.equip-health-score {
  font-size: 34rpx;
  font-weight: 800;
  font-family: "DIN Alternate", monospace;
  line-height: 1;
}

.bottom-spacer { height: 40rpx; }
