/* spares/spares.wxss - 备件库存 · Solar-Punk */
@import '../../common.wxss';

page {
  background: linear-gradient(180deg, #F8FBFF 0%, #F1F7FE 55%, #F7F4FF 100%);
  background-color: #F2F7FD;
  min-height: 100vh;
}

.page-body > .section-title-row {
  margin: 24rpx 24rpx 14rpx;
}

/* 加载中 / 失败 */
.loading-state, .error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 140rpx 48rpx;
}
.loading-ring {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid rgba(232, 163, 61, 0.2);
  border-top-color: #E8A33D;
  border-radius: 50%;
  margin-bottom: 24rpx;
  animation: spin 0.9s linear infinite;
}
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.loading-text, .error-text {
  font-size: 26rpx;
  color: #94A3B8;
  text-align: center;
}
.error-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}
.retry-btn {
  margin-top: 24rpx;
  padding: 14rpx 44rpx;
  background: linear-gradient(135deg, #F6D08A 0%, #E8A33D 48%, #D98F2B 100%);
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.6), 0 8rpx 20rpx -8rpx rgba(232, 163, 61, 0.55);
}

/* 搜索与分类筛选 */
.filter-shell {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 0 24rpx;
  margin-bottom: 16rpx;
}
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(220, 230, 242, 0.9);
  border-radius: 999rpx;
  padding: 12rpx 22rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}
.search-icon { font-size: 24rpx; }
.search-input {
  flex: 1;
  font-size: 25rpx;
  color: #1E293B;
}
.cat-btn {
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(220, 230, 242, 0.9);
  border-radius: 999rpx;
  padding: 12rpx 22rpx;
  font-size: 24rpx;
  color: #B8761F;
  font-weight: 600;
  white-space: nowrap;
}

/* 低库存开关 + 计数 */
.filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
}
.low-stock-toggle {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid rgba(220, 230, 242, 0.9);
  font-size: 22rpx;
  color: #64748B;
}
.toggle-on {
  background: rgba(239, 68, 68, 0.1);
  border-color: rgba(239, 68, 68, 0.4);
  color: #EF4444;
  font-weight: 600;
}
.toggle-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #CBD5E1;
}
.toggle-on .toggle-dot {
  background: #EF4444;
  box-shadow: 0 0 0 4rpx rgba(239, 68, 68, 0.15);
}
.filter-count {
  font-size: 22rpx;
  color: #94A3B8;
}
.filter-count-num {
  font-family: "DIN Alternate", monospace;
  font-weight: 800;
  color: #B8761F;
}

/* 备件卡片 */
.part-card {
  margin: 0 24rpx 16rpx;
  padding: 24rpx 28rpx;
}
.part-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.part-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: #0F172A;
  padding-right: 16rpx;
}
.badge-ok-pill {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  background: rgba(16, 185, 129, 0.12);
  color: #10B981;
  border: 1rpx solid rgba(16, 185, 129, 0.35);
}
.badge-danger-pill {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  background: linear-gradient(135deg, rgba(239, 68, 68, 0.14), rgba(220, 38, 38, 0.14));
  color: #EF4444;
  border: 1rpx solid rgba(239, 68, 68, 0.4);
  box-shadow: 0 2rpx 10rpx -4rpx rgba(239, 68, 68, 0.4);
}
.part-code-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: #64748B;
}
.part-code {
  font-family: "DIN Alternate", monospace;
  font-weight: 700;
  color: #B8761F;
  background: rgba(232, 163, 61, 0.1);
  border: 1rpx solid rgba(232, 163, 61, 0.3);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}
.part-code-dot { color: #CBD5E1; }
.part-spec {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.part-divider {
  height: 1rpx;
  background: rgba(220, 230, 242, 0.8);
  margin: 16rpx 0;
}
.part-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.meta-item { width: calc(50% - 8rpx); }
.meta-label {
  font-size: 20rpx;
  color: #94A3B8;
  display: block;
  margin-bottom: 4rpx;
}
.meta-value {
  font-size: 26rpx;
  color: #1E293B;
  font-weight: 700;
  font-family: "DIN Alternate", monospace;
}
.meta-unit {
  font-size: 20rpx;
  font-weight: 500;
  color: #94A3B8;
  font-family: -apple-system, sans-serif;
}
.text-danger {
  color: #EF4444;
}
