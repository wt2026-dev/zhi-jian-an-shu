.spares-page {
  padding: 24rpx;
  padding-bottom: 120rpx;
}
.page-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1E293B;
  margin-bottom: 24rpx;
}

.filter-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.search-input {
  flex: 1;
  background: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #1E293B;
}
.cat-btn {
  background: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  color: #475569;
  white-space: nowrap;
}

.filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.low-stock-toggle {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: #F1F5F9;
  font-size: 22rpx;
  color: #94A3B8;
  transition: all 0.2s;
}
.toggle-on {
  background: #FEF2F2;
  color: #EF4444;
}
.toggle-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #CBD5E1;
}
.toggle-on .toggle-dot {
  background: #EF4444;
}

.part-card {
  background: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.part-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.part-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
}
.badge {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
}
.badge-success {
  background: rgba(16,185,129,0.1);
  color: #10b981;
}
.badge-danger {
  background: rgba(239,68,68,0.1);
  color: #EF4444;
}
.part-code {
  font-size: 22rpx;
  margin-bottom: 16rpx;
}
.part-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.meta-item {
  width: calc(50% - 8rpx);
}
.meta-label {
  font-size: 20rpx;
  color: #94A3B8;
  display: block;
}
.meta-value {
  font-size: 24rpx;
  color: #1E293B;
  font-weight: 500;
}
.text-danger {
  color: #EF4444;
  font-weight: 700;
}
