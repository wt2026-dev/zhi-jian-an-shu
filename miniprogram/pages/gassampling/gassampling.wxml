<!-- 气体采样检测录入 · Solar-Punk 明亮游戏化 HUD -->
<page-meta root-font-size="16" />
<view class="fx-bg">
  <view class="fx-hex"></view>
  <view class="fx-particles"></view>
  <view class="fx-bloom"></view>
</view>

<!-- 顶部导航与设备同步栏 -->
<view class="gs-topbar">
  <view class="gs-topbar-inner">
    <view class="flex items-center gap-element">
      <view class="gs-back" bindtap="goBack">
        <text class="gs-back-icon">‹</text>
      </view>
      <view>
        <view class="flex items-center gap-compact">
          <text class="gs-title">气体采样检测录入</text>
          <view class="chip-cyan gs-gb-badge">GB 30871-2021</view>
        </view>
        <text class="gs-sub">受限空间气体采样化验</text>
      </view>
    </view>
    <view class="flex flex-col items-end">
      <view class="gs-device">
        <view class="gs-device-dot"></view>
        <text class="gs-device-name">RAE-Guard 四合一检测仪</text>
      </view>
      <view class="flex items-center gap-micro mt-nano">
        <text class="gs-green">📡</text>
        <text class="gs-faint">直连·电量 {{deviceInfo.battery}}%</text>
      </view>
    </view>
  </view>
</view>

<view class="page-body">

  <!-- 加载/失败 -->
  <view wx:if="{{loading}}" class="empty-state">
    <view class="loading-ring"></view>
    <text class="empty-text">加载中...</text>
  </view>
  <view wx:elif="{{loadError}}" class="empty-state">
    <text class="empty-icon">⚠️</text>
    <text class="empty-text">{{loadError}}</text>
  </view>

  <block wx:else>
    <!-- 作业票信息 -->
    <view class="hud-card gs-ticket">
      <view class="ticket-header">
        <view class="flex items-center gap-compact min-w-0">
          <text class="text-gold-deep">📦</text>
          <text class="text-gold-deep font-bold gs-mono">作业票: {{ticketInfo.id}}</text>
        </view>
        <view class="chip-gold">{{ticketInfo.type}}</view>
      </view>
      <view class="flex items-start justify-between gap-element">
        <view class="min-w-0 flex-1">
          <text class="gs-faint">作业靶向受限区域</text>
          <text class="gs-area">{{ticketInfo.area}}</text>
          <view class="flex items-center gap-compact mt-micro">
            <text class="gs-partition">作业分区: {{ticketInfo.partition}}</text>
            <text class="gs-faint">容积 {{ticketInfo.volume}} · 深度 {{ticketInfo.depth}}</text>
          </view>
        </view>
        <view class="gs-countdown-box">
          <text class="gs-faint block">采样有效倒计时</text>
          <text class="gs-countdown-num">{{countdown}}</text>
          <text class="gs-faint block">30分钟内强制准入</text>
        </view>
      </view>
    </view>

    <!-- 三层采样分段选择器 -->
    <view class="hud-card gs-section">
      <view class="section-title-row">
        <view class="section-title-dot"></view>
        <view class="section-title-text">垂直三层采样分段</view>
      </view>
      <text class="gs-hint">规范要求: 顶/中/底全测</text>
      <view class="depth-grid">
        <view class="depth-btn {{currentDepth === 0 ? 'depth-btn-active' : 'depth-btn-done'}}" bindtap="selectDepth" data-depth="0">
          <text class="gs-faint">上部 (0.8m)</text>
          <text class="depth-name">罐顶部</text>
          <view class="flex items-center gap-micro mt-compact">
            <text class="{{samplingStatus[0] ? 'gs-green' : 'gs-faint'}}">{{samplingStatus[0] ? '✓' : '○'}}</text>
            <text class="{{samplingStatus[0] ? 'gs-green' : 'gs-faint'}}">{{samplingStatus[0] ? '已录入' : '待采样'}}</text>
          </view>
        </view>
        <view class="depth-btn {{currentDepth === 1 ? 'depth-btn-active' : 'depth-btn-done'}}" bindtap="selectDepth" data-depth="1">
          <text class="gs-faint">中部 (2.5m)</text>
          <text class="depth-name">罐中部</text>
          <view class="flex items-center gap-micro mt-compact">
            <text class="{{samplingStatus[1] ? 'gs-green' : 'gs-faint'}}">{{samplingStatus[1] ? '✓' : '○'}}</text>
            <text class="{{samplingStatus[1] ? 'gs-green' : 'gs-faint'}}">{{samplingStatus[1] ? '已录入' : '待采样'}}</text>
          </view>
        </view>
        <view class="depth-btn depth-btn-current" bindtap="selectDepth" data-depth="2">
          <view class="current-indicator"></view>
          <text class="gs-gold">下部 (4.5m)</text>
          <text class="depth-name depth-name-current">罐底部</text>
          <view class="flex items-center gap-micro mt-compact">
            <view class="pulse-dot"></view>
            <text class="gs-gold">当前测点</text>
          </view>
        </view>
      </view>
      <view class="depth-info-bar">
        <view class="flex items-center gap-compact min-w-0">
          <text class="gs-warn">ℹ️</text>
          <text class="gs-info-text">重点: 重质毒气 (H₂S/CO) 易沉积于底部</text>
        </view>
        <text class="chip-gold gs-progress-tag">进度 {{completedDepth}}/3</text>
      </view>
    </view>

    <!-- 四合一气体实时检测数据 -->
    <view class="hud-card gs-section">
      <view class="section-title-row">
        <view class="section-title-dot"></view>
        <view class="section-title-text">四合一气体实时检测数据</view>
      </view>
      <view class="chip-cyan gs-live">实时直传</view>

      <view class="gas-grid">
        <!-- O2 -->
        <view class="gas-card">
          <view class="flex items-center justify-between">
            <text class="gas-name">O₂ 氧气</text>
            <view class="chip-green">合格 达标</view>
          </view>
          <view class="flex items-baseline gap-compact mt-micro">
            <text class="gas-value gas-value-sky">{{gasReadings.o2.value}}</text>
            <text class="gas-unit">% VOL</text>
          </view>
          <view class="mt-element">
            <view class="progress-bar">
              <view class="progress-dim" style="width: 15%"></view>
              <view class="progress-green" style="width: 70%"></view>
              <view class="progress-amber" style="width: 15%"></view>
            </view>
            <view class="flex items-center justify-between mt-micro">
              <text class="gs-faint">基准: 19.5%~23.5%</text>
              <view class="flex items-center gap-nano">
                <view class="adjust-btn" bindtap="adjustValue" data-gas="o2" data-delta="-0.1"><text>−</text></view>
                <view class="adjust-btn" bindtap="adjustValue" data-gas="o2" data-delta="0.1"><text>+</text></view>
              </view>
            </view>
          </view>
        </view>

        <!-- LEL -->
        <view class="gas-card">
          <view class="flex items-center justify-between">
            <text class="gas-name">LEL 可燃气</text>
            <view class="chip-green">合格 安全</view>
          </view>
          <view class="flex items-baseline gap-compact mt-micro">
            <text class="gas-value gas-value-gold">{{gasReadings.lel.value}}</text>
            <text class="gas-unit">% LEL</text>
          </view>
          <view class="mt-element">
            <view class="progress-bar">
              <view class="progress-green" style="width: 10%"></view>
              <view class="progress-dim" style="width: 90%"></view>
            </view>
            <view class="flex items-center justify-between mt-micro">
              <text class="gs-faint">阈值: &lt;1.0% (爆炸下限)</text>
              <view class="flex items-center gap-nano">
                <view class="adjust-btn" bindtap="adjustValue" data-gas="lel" data-delta="-1"><text>−</text></view>
                <view class="adjust-btn" bindtap="adjustValue" data-gas="lel" data-delta="1"><text>+</text></view>
              </view>
            </view>
          </view>
        </view>

        <!-- CO -->
        <view class="gas-card">
          <view class="flex items-center justify-between">
            <text class="gas-name">CO 一氧化碳</text>
            <view class="chip-green">合格 达标</view>
          </view>
          <view class="flex items-baseline gap-compact mt-micro">
            <text class="gas-value gas-value-danger">{{gasReadings.co.value}}</text>
            <text class="gas-unit">ppm</text>
          </view>
          <view class="mt-element">
            <view class="progress-bar">
              <view class="progress-green" style="width: 20%"></view>
              <view class="progress-dim" style="width: 80%"></view>
            </view>
            <view class="flex items-center justify-between mt-micro">
              <text class="gs-faint">阈值: &lt;20 ppm (30mg/m³)</text>
              <view class="flex items-center gap-nano">
                <view class="adjust-btn" bindtap="adjustValue" data-gas="co" data-delta="-1"><text>−</text></view>
                <view class="adjust-btn" bindtap="adjustValue" data-gas="co" data-delta="1"><text>+</text></view>
              </view>
            </view>
          </view>
        </view>

        <!-- H2S -->
        <view class="gas-card">
          <view class="flex items-center justify-between">
            <text class="gas-name">H₂S 硫化氢</text>
            <view class="chip-green">合格 达标</view>
          </view>
          <view class="flex items-baseline gap-compact mt-micro">
            <text class="gas-value gas-value-danger">{{gasReadings.h2s.value}}</text>
            <text class="gas-unit">ppm</text>
          </view>
          <view class="mt-element">
            <view class="progress-bar">
              <view class="progress-green" style="width: 0%"></view>
              <view class="progress-dim" style="width: 100%"></view>
            </view>
            <view class="flex items-center justify-between mt-micro">
              <text class="gs-faint">阈值: &lt;7 ppm (10mg/m³)</text>
              <view class="flex items-center gap-nano">
                <view class="adjust-btn" bindtap="adjustValue" data-gas="h2s" data-delta="-0.1"><text>−</text></view>
                <view class="adjust-btn" bindtap="adjustValue" data-gas="h2s" data-delta="0.1"><text>+</text></view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="flex items-center justify-between mt-compact">
        <text class="gs-faint">探头: {{deviceInfo.probeId}} ({{deviceInfo.probeType}}) · 校准剩余 {{deviceInfo.calibrationDays}} 天</text>
        <text class="gs-gold shrink-0 ml-compact">已同步 {{deviceInfo.lastSync}}</text>
      </view>
    </view>

    <!-- 取样人资质与现场仪表存证 -->
    <view class="hud-card gs-section">
      <view class="section-title-row">
        <view class="section-title-dot"></view>
        <view class="section-title-text">取样人资质与现场仪表存证</view>
      </view>
      <view class="chip-green gs-face">已人脸验证</view>

      <!-- 化验员信息 -->
      <view class="assayer-strip">
        <view class="flex items-center gap-compact">
          <view class="avatar-circle">
            <text class="text-gold-deep font-bold">{{assayer.initial}}</text>
          </view>
          <view>
            <view class="flex items-center gap-compact">
              <text class="assayer-name">{{assayer.name}}</text>
              <view class="chip-cyan">{{assayer.role}}</view>
            </view>
            <text class="gs-faint mt-nano gs-mono">工号: {{assayer.employeeId}} · 证书{{assayer.certNo}}</text>
          </view>
        </view>
        <text class="gs-green">🛡️</text>
      </view>

      <!-- 拍照存证 -->
      <view class="photo-grid">
        <view wx:if="{{photoList.length > 0}}" class="photo-card photo-filled">
          <image class="photo-img" src="{{photoList[0].path}}" mode="aspectFill" />
          <view class="photo-overlay">
            <view class="flex items-center justify-between">
              <text class="gs-green">✅ 现场屏幕已核验</text>
              <text class="gs-faint">元数据合规</text>
            </view>
            <text class="gs-faint gs-mono mt-nano">{{photoList[0].time}}</text>
          </view>
        </view>
        <view wx:else class="photo-card photo-empty" bindtap="choosePhoto">
          <text class="gs-gold">📷</text>
          <text class="gs-faint mt-nano">补充采样环境照片</text>
          <text class="gs-dim">(选填 · 进风口盲板)</text>
        </view>
        <view class="photo-card photo-empty" bindtap="choosePhoto">
          <text class="gs-gold">📷</text>
          <text class="gs-faint mt-nano">补充采样环境照片</text>
          <text class="gs-dim">(选填 · 进风口盲板)</text>
        </view>
      </view>

      <!-- 环境参数 -->
      <view class="env-grid">
        <view class="flex items-center gap-compact">
          <text class="gs-faint">🌬️</text>
          <view>
            <text class="gs-faint">强制通风时长</text>
            <text class="gs-env-num">45 <text class="gs-faint">分钟 (合规)</text></text>
          </view>
        </view>
        <view class="flex items-center gap-compact">
          <text class="gs-faint">🌡️</text>
          <view>
            <text class="gs-faint">空间内部温度/湿度</text>
            <text class="gs-env-num">24.6 <text class="gs-faint">℃ / 58%</text></text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 底部操作栏 -->
  <view class="bottom-dock safe-bottom">
    <view class="flex items-center gap-element max-w-lg mx-auto">
      <view class="dock-btn-secondary" bindtap="triggerResync">
        <text class="gs-faint">🔄</text>
        <text class="dock-secondary-text">重测/校准</text>
      </view>
      <view class="btn-gold dock-btn-primary {{submitting ? 'dock-btn-loading' : ''}}" bindtap="submitReport">
        <text wx:if="{{submitting}}">⏳</text>
        <text class="dock-primary-text">{{submitting ? '报告数字加密存证中...' : '签署提交采样分析报告'}}</text>
        <text wx:if="{{!submitting}}">→</text>
      </view>
    </view>
  </view>

</view>
