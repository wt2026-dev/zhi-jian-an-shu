.login { padding: 120rpx 48rpx; }
.brand { text-align: center; margin-bottom: 80rpx; }
.logo {
  width: 140rpx; height: 140rpx; margin: 0 auto 32rpx;
  background: linear-gradient(135deg, #0891B2, #2563EB);
  border-radius: 36rpx; color: #fff; font-size: 72rpx; font-weight: 800;
  line-height: 140rpx;
}
.bt { font-size: 36rpx; font-weight: 700; color: #1E293B; }
.bs { font-size: 24rpx; color: #94A3B8; margin-top: 12rpx; }
.rt { color: #94A3B8; font-size: 22rpx; margin: 48rpx 0 8rpx; }
.chips { display: flex; flex-wrap: wrap; }
.foot { text-align: center; color: #94A3B8; font-size: 20rpx; margin-top: 100rpx; }
.ph { color: #94A3B8; }
.error-msg { color: #EF4444; font-size: 24rpx; text-align: center; padding: 8rpx 0 16rpx; }
.chip {
  padding: 8rpx 20rpx; margin: 0 12rpx 12rpx 0;
  background: rgba(56, 189, 248, 0.1); border: 1rpx solid rgba(56, 189, 248, 0.3);
  border-radius: 8rpx; font-size: 22rpx; color: #38bdf8;
}
.chip:active { opacity: 0.7; }