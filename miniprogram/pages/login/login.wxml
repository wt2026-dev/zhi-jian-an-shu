<view class="login">
  <view class="brand">
    <view class="logo">检</view>
    <view class="bt">工业设备智能检修与作业协同系统</view>
    <view class="bs">移动端 · 现场作业入口</view>
  </view>
  <view class="card">
    <input class="input" placeholder="账号" placeholder-class="ph" value="{{username}}" bindinput="onUser" />
    <input class="input" password placeholder="密码" placeholder-class="ph" value="{{password}}" bindinput="onPwd" />
    <view class="error-msg" wx:if="{{errorMsg}}">{{errorMsg}}</view>
    <button class="btn btn-primary {{loading ? 'btn-disabled' : ''}}" bindtap="doLogin">{{loading ? '登录中...' : '登 录'}}</button>
    <view class="divider"></view>
    <button class="btn btn-primary" style="background:#07C160" bindtap="wxLogin" disabled="{{wxLoading}}">
      {{wxLoading ? '微信登录中...' : '微信一键登录'}}
    </button>
  </view>
  <view class="rt">演示账号（各角色独立强密码）</view>
  <view class="chips">
    <view class="chip" bindtap="fill" data-u="admin">admin</view>
    <view class="chip" bindtap="fill" data-u="manager">manager</view>
    <view class="chip" bindtap="fill" data-u="operator">operator</view>
  </view>
  <view class="foot">JWT 认证 · RBAC 权限 · 数据来自后端真实接口</view>
</view>
