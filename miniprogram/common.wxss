/**
 * common.wxss - 微信小程序基础样式
 * 基于HTML原型颜色定义转换
 */

/* ==================== 颜色变量 ==================== */
page {
  /* 表面色系 - 明亮白灰色 */
  --surface: #F8FAFC;
  --surface-container-lowest: #FFFFFF;
  --surface-container-low: #FFFFFF;
  --surface-container: #F8FAFC;
  --surface-container-high: #E2E8F0;
  --surface-container-highest: #CBD5E1;
  --surface-bright: #94A3B8;
  --surface-dim: #F5F7FA;
  
  /* 文本色系 */
  --on-surface: #1E293B;
  --on-surface-variant: #64748B;
  
  /* 边框色系 */
  --outline: #94A3B8;
  --outline-variant: #E2E8F0;
  --industrial-border: #E2E8F0;
  --industrial-subtle: #F1F5F9;
  
  /* 主题色 - 蓝色 */
  --primary: #3b82f6;
  --primary-container: #EFF6FF;
  --on-primary: #FFFFFF;
  --on-primary-container: #1D4ED8;
  
  /* 状态色 */
  --status-green: #10b981;
  --hazard-amber: #f59e0b;
  --safety-orange: #f97316;
  
  /* 错误色 */
  --error: #ef4444;
  --error-container: #FEF2F2;
  --on-error: #FFFFFF;
  
  /* 辅助色 */
  --tech-muted: #94A3B8;
  --tech-dim: #CBD5E1;
  
  /* 基础样式 */
  background-color: var(--surface);
  color: var(--on-surface);
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  -webkit-tap-highlight-color: transparent;
}

/* ==================== 基础布局 ==================== */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-row { flex-direction: row; }
.flex-1 { flex: 1; }
.items-center { align-items: center; }
.items-start { align-items: flex-start; }
.items-end { align-items: flex-end; }
.items-baseline { align-items: baseline; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.justify-end { justify-content: flex-end; }
.flex-wrap { flex-wrap: wrap; }
.flex-shrink-0 { flex-shrink: 0; }
.flex-shrink { flex-shrink: 1; }

/* 行内布局 */
.inline-flex { display: inline-flex; }
.inline-block { display: inline-block; }

/* 网格列跨*/
.col-span-1 { grid-column: span 1 / span 1; }
.col-span-2 { grid-column: span 2 / span 2; }
.col-span-3 { grid-column: span 3 / span 3; }

/* 指针事件 */
.pointer-events-none { pointer-events: none; }
.pointer-events-auto { pointer-events: auto; }

/* 阴影 */
.shadow-inner { box-shadow: inset 0 2px 4px rgba(0,0,0,0.15); }

/* ==================== 透明==================== */
.opacity-0 { opacity: 0; }
.opacity-25 { opacity: 0.25; }
.opacity-50 { opacity: 0.5; }
.opacity-60 { opacity: 0.6; }
.opacity-75 { opacity: 0.75; }
.opacity-100 { opacity: 1; }

/* 显示隐藏 */
.hidden { display: none; }
.block { display: block; }

