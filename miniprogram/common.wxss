/* ==================== 圆角 ==================== */
.rounded-none { border-radius: 0; }
.rounded-sm { border-radius: 8rpx; }
.rounded { border-radius: 12rpx; }
.rounded-md { border-radius: 16rpx; }
.rounded-lg { border-radius: 20rpx; }
.rounded-xl { border-radius: 24rpx; }
.rounded-2xl { border-radius: 32rpx; }
.rounded-3xl { border-radius: 48rpx; }
.rounded-full { border-radius: 9999rpx; }

/* ==================== 阴影 ==================== */
.shadow-none { box-shadow: none; }
.shadow-sm { box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15); }
.shadow { box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2); }
.shadow-md { box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25); }
.shadow-lg { box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.3); }
.shadow-xl { box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.35); }
.shadow-2xl { box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.4); }

/* ==================== 尺寸 ==================== */
.w-full { width: 100%; }
.h-full { height: 100%; }
.min-h-screen { min-height: 100vh; }

/* ==================== 定位 ==================== */
.relative { position: relative; }
.absolute { position: absolute; }
.fixed { position: fixed; }
.sticky { position: sticky; }
.inset-0 { top: 0; right: 0; bottom: 0; left: 0; }
.inset-x-0 { left: 0; right: 0; }
.top-0 { top: 0; }
.top-1 { top: 8rpx; }
.top-1-5 { top: 12rpx; }
.right-0 { right: 0; }
.right-1 { right: 8rpx; }
.right-1-5 { right: 12rpx; }
.bottom-0 { bottom: 0; }
.left-0 { left: 0; }
.-bottom-1 { bottom: -8rpx; }
.-right-1 { right: -8rpx; }
.z-0 { z-index: 0; }
.z-10 { z-index: 10; }
.z-20 { z-index: 20; }
.z-30 { z-index: 30; }
.z-40 { z-index: 40; }
.z-50 { z-index: 50; }

/* ==================== 溢出 ==================== */
.overflow-hidden { overflow: hidden; }
.overflow-auto { overflow: auto; }
.overflow-scroll { overflow: scroll; }

/* ==================== 间距空间 ==================== */
.space-y-1 > view + view { margin-top: 8rpx; }
.space-y-2 > view + view { margin-top: 16rpx; }
.space-y-3 > view + view { margin-top: 24rpx; }
.space-y-4 > view + view { margin-top: 32rpx; }
.space-x-1 > view + view { margin-left: 8rpx; }
.space-x-2 > view + view { margin-left: 16rpx; }
.space-x-3 > view + view { margin-left: 24rpx; }
.space-x-4 > view + view { margin-left: 32rpx; }
.gap-1 { gap: 8rpx; }
.gap-1-5 { gap: 12rpx; }
.gap-2 { gap: 16rpx; }
.gap-2-5 { gap: 20rpx; }
.gap-3 { gap: 24rpx; }
.gap-4 { gap: 32rpx; }

/* ==================== 卡片组件 ==================== */
.card {
  background: var(--surface-container-low);
  border-radius: 24rpx;
  border: 1rpx solid var(--industrial-border);
  padding: 24rpx;
}

.card-sm {
  background: var(--surface-container);
  border-radius: 16rpx;
  border: 1rpx solid var(--industrial-subtle);
  padding: 20rpx;
}

.card-lg {
  background: var(--surface-container-low);
  border-radius: 28rpx;
  border: 1rpx solid var(--industrial-border);
  padding: 32rpx;
}

.card-highlight {
  background: var(--surface-container-high);
  border-radius: 20rpx;
  border: 1rpx solid var(--primary-container);
  padding: 24rpx;
}

/* ==================== 按钮组件 ==================== */
.btn {
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 22rpx 0;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.btn::after { border: none; }

.btn-primary {
  background: var(--primary-container);
  color: var(--on-primary-container);
}

.btn-green {
  background: var(--status-green);
  color: #0a0a0a;
}

.btn-amber {
  background: var(--hazard-amber);
  color: #0a0a0a;
}

.btn-orange {
  background: var(--safety-orange);
  color: #0a0a0a;
}

.btn-rose {
  background: var(--error);
  color: var(--on-error);
}

.btn-ghost {
  background: var(--surface-container-high);
  border: 1rpx solid var(--industrial-border);
  color: var(--on-surface);
}

.btn-outline {
  background: transparent;
  border: 1rpx solid var(--industrial-border);
  color: var(--on-surface);
}

.btn-disabled {
  opacity: 0.45;
  pointer-events: none;
}

/* ==================== 徽章组件 ==================== */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  border: 1rpx solid;
}

.badge-green {
  background: rgba(34, 197, 94, 0.15);
  border-color: rgba(34, 197, 94, 0.3);
  color: var(--status-green);
}

.badge-amber {
  background: rgba(251, 191, 36, 0.15);
  border-color: rgba(251, 191, 36, 0.3);
  color: var(--hazard-amber);
}

.badge-orange {
  background: rgba(249, 115, 22, 0.15);
  border-color: rgba(249, 115, 22, 0.4);
  color: var(--safety-orange);
}

.badge-primary {
  background: var(--primary-container);
  color: var(--on-primary-container);
}

.badge-error {
  background: rgba(255, 180, 171, 0.15);
  border-color: rgba(255, 180, 171, 0.3);
  color: var(--error);
}

.badge-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

/* ==================== 输入框组==================== */
.input {
  background: var(--surface-container-lowest);
  border: 1rpx solid var(--industrial-border);
  border-radius: 16rpx;
  padding: 20rpx;
  color: var(--on-surface);
  font-size: 28rpx;
}

.textarea {
  background: var(--surface-container-lowest);
  border: 1rpx solid var(--industrial-border);
  border-radius: 16rpx;
  padding: 20rpx;
  color: var(--on-surface);
  font-size: 26rpx;
  min-height: 140rpx;
}

/* ==================== 标签组件 ==================== */
.label {
  color: var(--tech-muted);
  font-size: 24rpx;
  margin: 16rpx 0 8rpx;
}

/* ==================== 分割==================== */
.divider {
  height: 1rpx;
  background: var(--industrial-border);
  margin: 20rpx 0;
}

.divider-subtle {
  height: 1rpx;
  background: var(--industrial-subtle);
  margin: 16rpx 0;
}

/* ==================== 空状==================== */
.empty {
  text-align: center;
  color: var(--tech-dim);
  padding: 100rpx 40rpx;
  font-size: 26rpx;
}

/* ==================== 标签==================== */
.tabs {
  display: flex;
  white-space: nowrap;
  padding: 16rpx 24rpx 0;
}

.tab {
  padding: 12rpx 28rpx;
  color: var(--tech-muted);
  font-size: 26rpx;
  display: inline-block;
}

.tab.on {
  color: var(--primary);
  border-bottom: 4rpx solid var(--primary);
  font-weight: 700;
}

/* ==================== 芯片组件 ==================== */
.chip {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin: 8rpx 12rpx 8rpx 0;
  background: var(--surface-container);
  border: 1rpx solid var(--industrial-border);
  border-radius: 32rpx;
  color: var(--tech-muted);
  font-size: 24rpx;
}

/* ==================== 区域标题 ==================== */
.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--on-surface);
  margin: 28rpx 24rpx 8rpx;
}

/* ==================== KPI数字 ==================== */
.kpi-num {
  font-size: 52rpx;
  font-weight: 800;
  font-family: "DIN Alternate", monospace;
}

/* ==================== 安全区域 ==================== */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom, 20rpx);
}

.safe-top {
  padding-top: env(safe-area-inset-top, 0);
}

/* ==================== 渐变背景 ==================== */
.gradient-green {
  background: linear-gradient(135deg, rgba(34, 197, 94, 0.2), rgba(34, 197, 94, 0.05));
}

.gradient-amber {
  background: linear-gradient(135deg, rgba(251, 191, 36, 0.2), rgba(251, 191, 36, 0.05));
}

.gradient-orange {
  background: linear-gradient(135deg, rgba(249, 115, 22, 0.2), rgba(249, 115, 22, 0.05));
}

.gradient-primary {
  background: linear-gradient(135deg, rgba(56, 189, 248, 0.2), rgba(56, 189, 248, 0.05));
}

/* ==================== 动画 ==================== */
.animate-pulse {
  animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.animate-spin {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.animate-fade-in {
  animation: fadeIn 0.3s ease-in-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ==================== 网格布局 ==================== */
.grid {
  display: grid;
}

.grid-cols-2 {
  grid-template-columns: repeat(2, 1fr);
}

.grid-cols-3 {
  grid-template-columns: repeat(3, 1fr);
}

.grid-cols-4 {
  grid-template-columns: repeat(4, 1fr);
}

.grid-gap-2 { grid-gap: 16rpx; }
.grid-gap-3 { grid-gap: 24rpx; }
.grid-gap-4 { grid-gap: 32rpx; }

/* ==================== 常用组合样式 ==================== */
/* 工业风格卡片 */
.industrial-card {
  background: var(--surface-container-low);
  border: 1rpx solid var(--industrial-border);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

/* 状态指示器 */
.status-indicator {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.status-online {
  background: rgba(34, 197, 94, 0.15);
  border: 1rpx solid rgba(34, 197, 94, 0.3);
  color: var(--status-green);
}

.status-warning {
  background: rgba(251, 191, 36, 0.15);
  border: 1rpx solid rgba(251, 191, 36, 0.3);
  color: var(--hazard-amber);
}

.status-danger {
  background: rgba(255, 180, 171, 0.15);
  border: 1rpx solid rgba(255, 180, 171, 0.3);
  color: var(--error);
}

/* 时间*/
.timeline {
  position: relative;
  padding-left: 48rpx;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 20rpx;
  top: 16rpx;
  bottom: 16rpx;
  width: 3rpx;
  background: var(--industrial-border);
}

.timeline-item {
  position: relative;
  margin-bottom: 32rpx;
}

.timeline-dot {
  position: absolute;
  left: -48rpx;
  top: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.timeline-dot-done {
  background: var(--surface-container-highest);
  border: 2rpx solid var(--status-green);
  color: var(--status-green);
}

.timeline-dot-active {
  background: var(--primary-container);
  border: 2rpx solid var(--surface-container);
  color: var(--on-primary-container);
  animation: pulse 2s infinite;
}

.timeline-dot-pending {
  background: var(--surface-container-highest);
  border: 2rpx solid var(--industrial-border);
  color: var(--tech-muted);
}

/* 气体读数卡片 */
.gas-card {
  background: var(--surface-container);
  border: 1rpx solid var(--industrial-border);
  border-radius: 16rpx;
  padding: 24rpx;
  position: relative;
  overflow: hidden;
}

.gas-value {
  font-family: "DIN Alternate", monospace;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -1rpx;
}

.gas-unit {
  font-family: "DIN Alternate", monospace;
  font-size: 22rpx;
  color: var(--tech-muted);
}

.gas-progress {
  width: 100%;
  height: 4rpx;
  background: var(--surface-container-highest);
  border-radius: 2rpx;
  margin: 16rpx 0;
}

/* 模态框 */
.modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.75);
  z-index: 100;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 24rpx;
  padding-bottom: env(safe-area-inset-bottom, 24rpx);
}

.modal-content {
  background: var(--surface-container-high);
  border: 1rpx solid var(--industrial-border);
  border-radius: 24rpx;
  padding: 32rpx;
  max-height: 80vh;
  overflow-y: auto;
}

/* 底部操作*/
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--surface-container-lowest);
  border-top: 1rpx solid var(--industrial-border);
  padding: 24rpx;
  padding-bottom: env(safe-area-inset-bottom, 24rpx);
  z-index: 40;
}

