/**
 * 全局统一设计 Tokens（两端一致）
 * PRIMARY: #3B82F6 (小面积强调：按钮、激活态、进度条、图标)
 * DEEP:    #2563EB (仅用于 hover、文字链接、重点数值，禁止大面积深蓝背景)
 * LIGHT:   #EFF6FF (卡片底、分区底、图标底)
 */
page {
  background: #F5F7FA;
  color: #1E293B;
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}
.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 1rpx solid #E2E8F0;
  padding: 24rpx;
  margin: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.06);
}
.row { display: flex; align-items: center; }
.col { display: flex; flex-direction: column; }
.sp { flex: 1; }
.muted { color: #94A3B8; font-size: 24rpx; }
.mono { font-family: "DIN Alternate", "Menlo", monospace; }
.title { font-size: 32rpx; font-weight: 700; color: #1E293B; }
.h1 { font-size: 36rpx; font-weight: 700; color: #1E293B; margin: 24rpx; }
.badge {
  display: inline-flex; align-items: center;
  padding: 4rpx 16rpx; border-radius: 8rpx;
  font-size: 20rpx; font-weight: 600;
  border: 1rpx solid;
}
.btn {
  border-radius: 16rpx; font-size: 28rpx; font-weight: 600;
  padding: 22rpx 0; text-align: center; margin-top: 20rpx;
}
.btn::after { border: none; }
.btn-primary { background: #3b82f6; color: #FFFFFF; }
.btn-amber { background: #FBBF24; color: #1E293B; }
.btn-rose { background: #FB7185; color: #FFFFFF; }
.btn-green { background: #10b981; color: #FFFFFF; }
.btn-ghost { background: #F1F5F9; color: #1E293B; border: 1rpx solid #E2E8F0; }
.btn-disabled { opacity: 0.45; }
.input {
  background: #FFFFFF; border: 1rpx solid #E2E8F0; border-radius: 16rpx;
  padding: 20rpx; color: #1E293B; font-size: 28rpx; margin-bottom: 20rpx;
}
.textarea {
  background: #FFFFFF; border: 1rpx solid #E2E8F0; border-radius: 16rpx;
  padding: 20rpx; color: #1E293B; font-size: 26rpx; width: auto; min-height: 140rpx;
}
.label { color: #94A3B8; font-size: 24rpx; margin: 16rpx 0 8rpx; }
.empty { text-align: center; color: #CBD5E1; padding: 100rpx 40rpx; font-size: 26rpx; }
.divider { height: 1rpx; background: #E2E8F0; margin: 20rpx 0; }
.kpi-num { font-size: 52rpx; font-weight: 800; font-family: "DIN Alternate", monospace; }
.badge-dot { width: 12rpx; height: 12rpx; border-radius: 50%; margin-right: 8rpx; }
.tabs { display: flex; white-space: nowrap; padding: 16rpx 24rpx 0; }
.tab { padding: 12rpx 28rpx; color: #94A3B8; font-size: 26rpx; display: inline-block; }
.tab.on { color: #3b82f6; border-bottom: 4rpx solid #3b82f6; font-weight: 700; }
.chip {
  display: inline-block; padding: 10rpx 24rpx; margin: 8rpx 12rpx 8rpx 0;
  background: #FFFFFF; border: 1rpx solid #E2E8F0; border-radius: 32rpx;
  color: #94A3B8; font-size: 24rpx;
}
.section-title { font-size: 28rpx; font-weight: 700; color: #1E293B; margin: 28rpx 24rpx 8rpx; }
.safe-bottom { padding-bottom: 60rpx; }
