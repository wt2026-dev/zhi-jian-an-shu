    <Box style={{ display: 'flex', flexWrap: 'wrap', gap: '10px' }}>
      {[
        { name: 'admin', role: '系统管理员', perms: '全部权限 (*)', color: '#06b6d4' },
        { name: 'manager', role: '车间主任', perms: '工单审批 · 作业票审批 · 报表', color: '#06b6d4' },
