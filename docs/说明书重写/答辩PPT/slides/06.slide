        { name: 'inspector', role: '巡检员', perms: '巡检 · 创建报修', color: '#10b981' },
        { name: 'operator', role: '操作工', perms: '报修 · 创建作业票', color: '#10b981' },
        { name: 'archivist', role: '知识管理员', perms: '知识 CRUD · RAG 检索', color: '#8b5cf6' },
