      <Box style={{ flex: '1', height: '1px', backgroundColor: '#1e293b', marginLeft: '20px' }} />
    </Box>

    <Text style={{
      fontSize: '32px', fontWeight: 'bold', color: '#e2e8f0', marginBottom: '8px',
    }}>
      三大<span style={{ color: '#f59e0b' }}>差异化</span>创新
    </Text>
    <Text style={{ fontSize: '14px', color: '#94a3b8', marginBottom: '24px' }}>
      不是更多功能，而是把每个细节做到生产可用
    </Text>

    <Box style={{ display: 'flex', gap: '16px', height: '420px' }}>
      <Box style={{
        flex: 1, padding: '24px', backgroundColor: '#0f172a', borderRadius: '8px',
