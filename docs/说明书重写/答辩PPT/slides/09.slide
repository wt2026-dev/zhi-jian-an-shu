<Slide style={{ width: '1280px', height: '720px', padding: '40px 56px', backgroundColor: '#0b1220' }}>
    <Box style={{ display: 'flex', alignItems: 'center', marginBottom: '24px' }}>
      <Text style={{ fontSize: '14px', color: '#06b6d4', letterSpacing: '3px' }}>AI · 24 CAPABILITIES · 4 LAYERS</Text>
      <Box style={{ flex: '1', height: '1px', backgroundColor: '#1e293b', marginLeft: '20px' }} />
    </Box>

    <Text style={{
      fontSize: '36px', fontWeight: 'bold', color: '#e2e8f0', marginBottom: '8px',
    }}>
      24 项 AI 能力 · <span style={{ color: '#06b6d4' }}>三层 + 多模态</span>
    </Text>
    <Text style={{ fontSize: '16px', color: '#94a3b8', marginBottom: '24px' }}>
      通过 OpenAI SDK 指向 DashScope 兼容端点 · 4 层降级机制（缓存 / 限流 / 备选模型 / 日预算）
    </Text>

    <Box style={{ display: 'flex', gap: '12px', height: '440px' }}>
      {[
        {
          layer: '基础层', count: 5, color: '#10b981',
          items: ['故障分类', '严重度评估', '关键词提取', '工单摘要', '设备状态解读'],
          path: '/api/v1/ai/chat',
        },
        {
          layer: '分析层', count: 10, color: '#06b6d4',
          items: ['根因分析', '维修方案推荐', '备件预测', '关联故障发现', '趋势预警', '知识匹配', '风险评估', '效率分析', '成本估算', '方案对比'],
          path: '/api/v1/ai/diagnose / rag-search',
        },
        {
          layer: '决策层', count: 5, color: '#f59e0b',
          items: ['维修决策树', '应急预案生成', '资源调度建议', '停机损失评估', '改进建议'],
          path: '/api/v1/ai/suggest-followups',
        },
        {
          layer: '多模态', count: 4, color: '#8b5cf6',
          items: ['视觉缺陷检测', '语音转文本', '视频分析', 'AI 流水线 (SSE)'],
          path: '/api/v1/ai/vision-defect-detect / pipeline',
        },
      ].map((l, i) => (
        <Box key={i} style={{
          flex: 1, padding: '18px', backgroundColor: '#0f172a', borderRadius: '8px',
          borderTop: `3px solid ${l.color}`,
          display: 'flex', flexDirection: 'column',
        }}>
          <Box style={{ display: 'flex', alignItems: 'baseline', marginBottom: '12px' }}>
            <Text style={{
              fontSize: '36px', fontWeight: 'bold', color: l.color, lineHeight: '1',
              marginRight: '8px',
            }}>
              {l.count}
            </Text>
            <Text style={{ fontSize: '13px', color: '#94a3b8' }}>项能力</Text>
          </Box>
          <Text style={{ fontSize: '16px', color: '#e2e8f0', fontWeight: 'bold', marginBottom: '4px' }}>
            {l.layer}
          </Text>
          <Text style={{ fontSize: '10px', color: '#64748b', fontFamily: 'monospace', marginBottom: '12px' }}>
            {l.path}
          </Text>
          <Box style={{ display: 'flex', flexDirection: 'column', gap: '4px' }}>
            {l.items.map((it, ii) => (
              <Text key={ii} style={{ fontSize: '12px', color: '#cbd5e1', lineHeight: '1.5' }}>
                · {it}
              </Text>
            ))}
          </Box>
        </Box>
      ))}
    </Box>

    <Box style={{ position: 'absolute', bottom: '20px', right: '56px' }}>
      <Text style={{ fontSize: '12px', color: '#475569' }}>09 / 12</Text>
    </Box>
  </Slide>