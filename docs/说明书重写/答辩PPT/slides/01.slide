<Slide style={{ width: '1280px', height: '720px', padding: '40px 56px', backgroundColor: '#0b1220', position: 'relative' }}>
    {/* A 标题区 — 队伍信息 */}
    <Box style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '24px' }}>
      <Text style={{ fontSize: '14px', color: '#64748b', letterSpacing: '2px' }}>
        工业设备智能检修一体化平台 · 答辩 PPT
      </Text>
      <Text style={{ fontSize: '14px', color: '#64748b' }}>2026.09</Text>
    </Box>

    {/* B 主体 — Hero 区 */}
    <Box style={{ display: 'flex', flexDirection: 'column', justifyContent: 'center', height: '440px' }}>
      <Text style={{ fontSize: '18px', color: '#06b6d4', letterSpacing: '4px', marginBottom: '24px' }}>
        INDUSTRIAL EQUIPMENT INTELLIGENT MAINTENANCE PLATFORM
      </Text>
      <Text style={{
        fontSize: '72px', fontWeight: 'bold', color: '#e2e8f0',
        lineHeight: '1.2', marginBottom: '32px',
      }}>
        <span style={{ color: '#06b6d4' }}>工业设备</span>智能检修
        <br />
        一体化平台
      </Text>
      <Text style={{ fontSize: '22px', color: '#94a3b8', lineHeight: '1.7', maxWidth: '900px' }}>
        从巡检发现 → 报修 → 调度 → 维修 → 验收 → 知识沉淀的全链路数字化解决方案
        <br />
        解决流程制造企业的<span style={{ color: '#f59e0b', fontWeight: 'bold' }}>信息孤岛 / 流程断裂 / 知识流失</span>三大痛点
      </Text>
    </Box>

    {/* C 关键数据 4 列 */}
    <Box style={{ display: 'flex', justifyContent: 'space-between', marginTop: '32px' }}>
      {[
        { num: '31', unit: '张业务表', color: '#06b6d4' },
        { num: '25', unit: '个幂等迁移', color: '#06b6d4' },
        { num: '24', unit: '项 AI 能力', color: '#f59e0b' },
        { num: '88', unit: '个测试文件', color: '#06b6d4' },
      ].map((item, i) => (
        <Box key={i} style={{
          flex: 1, padding: '18px', marginRight: i < 3 ? '16px' : '0',
          backgroundColor: '#0f172a', borderRadius: '8px',
          borderLeft: `3px solid ${item.color}`,
        }}>
          <Text style={{ fontSize: '44px', fontWeight: 'bold', color: item.color, lineHeight: '1' }}>
            {item.num}
          </Text>
          <Text style={{ fontSize: '13px', color: '#94a3b8', marginTop: '6px' }}>
            {item.unit}
          </Text>
        </Box>
      ))}
    </Box>

    {/* 页脚 */}
    <Box style={{ position: 'absolute', bottom: '20px', right: '56px', display: 'flex', alignItems: 'center' }}>
      <Text style={{ fontSize: '12px', color: '#475569' }}>01 / 12</Text>
    </Box>
  </Slide>