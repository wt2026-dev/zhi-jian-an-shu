<Slide style={{ width: '1280px', height: '720px', padding: '40px 56px', backgroundColor: '#0b1220' }}>
    <Box style={{ display: 'flex', alignItems: 'center', marginBottom: '24px' }}>
      <Text style={{ fontSize: '14px', color: '#06b6d4', letterSpacing: '3px' }}>SOLUTION ARCHITECTURE</Text>
      <Box style={{ flex: 1, height: '1px', backgroundColor: '#1e293b', marginLeft: '20px' }} />
    </Box>

    <Text style={{
      fontSize: '36px', fontWeight: 'bold', color: '#e2e8f0', marginBottom: '8px',
    }}>
      解决方案 · <span style={{ color: '#06b6d4' }}>单进程双形态</span>
    </Text>
    <Text style={{ fontSize: '16px', color: '#94a3b8', marginBottom: '32px' }}>
      开发用 PGlite + npm run dev；生产用 PostgreSQL + Docker，一条命令切换
    </Text>

    <Box style={{ display: 'flex', flexDirection: 'column', gap: '12px', height: '440px' }}>
      {/* 第一层：浏览器 */}
      <Box style={{
        padding: '20px', backgroundColor: '#0f172a', borderRadius: '6px',
        borderLeft: '3px solid #06b6d4',
      }}>
        <Text style={{ fontSize: '13px', color: '#06b6d4', letterSpacing: '1px', marginBottom: '8px' }}>
          LAYER 1 · BROWSER
        </Text>
        <Box style={{ display: 'flex', gap: '12px' }}>
          {['React 19 + Vite 6', 'Tailwind 4 + motion 12', 'three.js 0.186 + VRM 3.5', 'Godot 4.7 Web 导出（3 套独立工程）'].map((t, i) => (
            <Box key={i} style={{ flex: 1, padding: '10px', backgroundColor: '#1e293b', borderRadius: '4px' }}>
              <Text style={{ fontSize: '13px', color: '#e2e8f0' }}>{t}</Text>
            </Box>
          ))}
        </Box>
      </Box>

      {/* 箭头 */}
      <Text style={{ fontSize: '14px', color: '#06b6d4', textAlign: 'center' }}>↓ HTTP / SSE / WebSocket</Text>

      {/* 第二层：Express */}
      <Box style={{
        padding: '20px', backgroundColor: '#0f172a', borderRadius: '6px',
        borderLeft: '3px solid #06b6d4',
      }}>
        <Text style={{ fontSize: '13px', color: '#06b6d4', letterSpacing: '1px', marginBottom: '8px' }}>
          LAYER 2 · EXPRESS API（src/server/index.ts）
        </Text>
        <Box style={{ display: 'flex', gap: '12px' }}>
          {['Helmet CSP + CORS + CSRF', 'globalAuthGuard + JWT', '20 个路由模块', 'AI 服务层（OpenAI SDK → DashScope 兼容端点）', 'SSE 流式输出'].map((t, i) => (
            <Box key={i} style={{ flex: 1, padding: '10px', backgroundColor: '#1e293b', borderRadius: '4px' }}>
              <Text style={{ fontSize: '13px', color: '#e2e8f0' }}>{t}</Text>
            </Box>
          ))}
        </Box>
      </Box>

      <Text style={{ fontSize: '14px', color: '#06b6d4', textAlign: 'center' }}>↓ SQL（DatabaseAdapter 双模式）</Text>

      {/* 第三层：数据库 */}
      <Box style={{
        padding: '20px', backgroundColor: '#0f172a', borderRadius: '6px',
        borderLeft: '3px solid #f59e0b',
      }}>
        <Text style={{ fontSize: '13px', color: '#f59e0b', letterSpacing: '1px', marginBottom: '8px' }}>
          LAYER 3 · DATABASE（src/db/db.ts 通过 DB_TYPE 切换）
        </Text>
        <Box style={{ display: 'flex', gap: '12px' }}>
          <Box style={{ flex: 1, padding: '10px', backgroundColor: '#1e293b', borderRadius: '4px' }}>
            <Text style={{ fontSize: '13px', color: '#06b6d4' }}>PGlite 0.5</Text>
            <Text style={{ fontSize: '11px', color: '#94a3b8', marginTop: '2px' }}>开发 / 测试 · WASM 内嵌</Text>
          </Box>
          <Box style={{ flex: 1, padding: '10px', backgroundColor: '#1e293b', borderRadius: '4px' }}>
            <Text style={{ fontSize: '13px', color: '#f59e0b' }}>PostgreSQL 15 + pgvector</Text>
            <Text style={{ fontSize: '11px', color: '#94a3b8', marginTop: '2px' }}>生产 · 25 个幂等迁移</Text>
          </Box>
        </Box>
      </Box>
    </Box>

    <Box style={{ position: 'absolute', bottom: '20px', right: '56px' }}>
      <Text style={{ fontSize: '12px', color: '#475569' }}>04 / 12</Text>
    </Box>
  </Slide>