<Slide style={{ width: '1280px', height: '720px', padding: '40px 56px', backgroundColor: '#0b1220' }}>
    <Box style={{ display: 'flex', alignItems: 'center', marginBottom: '20px' }}>
      <Text style={{ fontSize: '14px', color: '#06b6d4', letterSpacing: '3px' }}>DATABASE · 31 TABLES · 25 MIGRATIONS</Text>
      <Box style={{ flex: '1', height: '1px', backgroundColor: '#1e293b', marginLeft: '20px' }} />
    </Box>

    <Text style={{
      fontSize: '32px', fontWeight: 'bold', color: '#e2e8f0', marginBottom: '20px',
    }}>
      数据层 · <span style={{ color: '#06b6d4' }}>PGlite / PostgreSQL 双适配</span>
    </Text>

    <Box style={{ display: 'flex', gap: '12px' }}>
      <Box style={{
        flex: 1, padding: '24px', backgroundColor: '#0f172a', borderRadius: '8px',
        borderTop: '3px solid #06b6d4',
      }}>
        <Text style={{ fontSize: '64px', fontWeight: 'bold', color: '#06b6d4', lineHeight: '1' }}>
          31
        </Text>
        <Text style={{ fontSize: '14px', color: '#94a3b8', marginTop: '6px' }}>张业务表</Text>
        <Text style={{ fontSize: '11px', color: '#64748b', marginTop: '8px', lineHeight: '1.5' }}>
          10 张 AI/知识 · 9 张核心业务 · 5 张存储 · 7 张运营支撑
        </Text>
      </Box>
      <Box style={{
        flex: 1, padding: '24px', backgroundColor: '#0f172a', borderRadius: '8px',
        borderTop: '3px solid #f59e0b',
      }}>
        <Text style={{ fontSize: '64px', fontWeight: 'bold', color: '#f59e0b', lineHeight: '1' }}>
          25
        </Text>
        <Text style={{ fontSize: '14px', color: '#94a3b8', marginTop: '6px' }}>个幂等迁移</Text>
        <Text style={{ fontSize: '11px', color: '#64748b', marginTop: '8px', lineHeight: '1.5' }}>
          src/db/migrations/001-025.sql · 吞 already exists · 无 schema_migrations 表
        </Text>
      </Box>
      <Box style={{
        flex: 1, padding: '24px', backgroundColor: '#0f172a', borderRadius: '8px',
        borderTop: '3px solid #10b981',
      }}>
        <Text style={{ fontSize: '64px', fontWeight: 'bold', color: '#10b981', lineHeight: '1' }}>
          6
        </Text>
        <Text style={{ fontSize: '14px', color: '#94a3b8', marginTop: '6px' }}>个遥测维度</Text>
        <Text style={{ fontSize: '11px', color: '#64748b', marginTop: '8px', lineHeight: '1.5' }}>
          温度 / 压力 / 振动 / 电流 / 流量 / 转速
        </Text>
      </Box>
      <Box style={{
        flex: 1, padding: '24px', backgroundColor: '#0f172a', borderRadius: '8px',
        borderTop: '3px solid #8b5cf6',
      }}>
        <Text style={{ fontSize: '64px', fontWeight: 'bold', color: '#8b5cf6', lineHeight: '1' }}>
          1024
        </Text>
        <Text style={{ fontSize: '14px', color: '#94a3b8', marginTop: '6px' }}>维向量</Text>
        <Text style={{ fontSize: '11px', color: '#64748b', marginTop: '8px', lineHeight: '1.5' }}>
          text-embedding-v3 · pgvector 可选 · HNSW 索引
        </Text>
      </Box>
    </Box>

    <Box style={{ display: 'flex', gap: '12px', marginTop: '20px' }}>
      <Box style={{ flex: 1, padding: '16px', backgroundColor: '#0f172a', borderRadius: '6px' }}>
        <Text style={{ fontSize: '13px', color: '#06b6d4', marginBottom: '6px' }}>JSONB 关键字段</Text>
        <Text style={{ fontSize: '11px', color: '#cbd5e1', lineHeight: '1.6', fontFamily: 'monospace' }}>
          work_orders.safety_requirements / repair_log / acceptance
          {'\n'}safety_permits.guardian_approval / supervisor_approval
        </Text>
      </Box>
      <Box style={{ flex: 1, padding: '16px', backgroundColor: '#0f172a', borderRadius: '6px' }}>
        <Text style={{ fontSize: '13px', color: '#f59e0b', marginBottom: '6px' }}>乐观锁</Text>
        <Text style={{ fontSize: '11px', color: '#cbd5e1', lineHeight: '1.6', fontFamily: 'monospace' }}>
          work_orders.version INTEGER DEFAULT 1
          {'\n'}UPDATE … WHERE id=? AND version=? → 0 行返 409
        </Text>
      </Box>
      <Box style={{ flex: 1, padding: '16px', backgroundColor: '#0f172a', borderRadius: '6px' }}>
        <Text style={{ fontSize: '13px', color: '#10b981', marginBottom: '6px' }}>PGlite 自愈</Text>
        <Text style={{ fontSize: '11px', color: '#cbd5e1', lineHeight: '1.6', fontFamily: 'monospace' }}>
          openPgliteWithFallback() → 损坏自动回退到 data.bak-*
          {'\n'}最近 3 个备份保留 · .pglite-active.json 仲裁
        </Text>
      </Box>
    </Box>

    <Box style={{ position: 'absolute', bottom: '20px', right: '56px' }}>
      <Text style={{ fontSize: '12px', color: '#475569' }}>10 / 12</Text>
    </Box>
  </Slide>