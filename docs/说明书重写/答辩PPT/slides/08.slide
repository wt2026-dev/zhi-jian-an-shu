<Slide style={{ width: '1280px', height: '720px', padding: '40px 56px', backgroundColor: '#0b1220' }}>
    <Box style={{ display: 'flex', alignItems: 'center', marginBottom: '24px' }}>
      <Text style={{ fontSize: '14px', color: '#06b6d4', letterSpacing: '3px' }}>3D SCENE · FIRST-PERSON WALKTHROUGH</Text>
      <Box style={{ flex: '1', height: '1px', backgroundColor: '#1e293b', marginLeft: '20px' }} />
    </Box>

    <Text style={{
      fontSize: '36px', fontWeight: 'bold', color: '#e2e8f0', marginBottom: '8px',
    }}>
      3D 车间可视化 · <span style={{ color: '#06b6d4' }}>第一人称漫游</span>
    </Text>
    <Text style={{ fontSize: '16px', color: '#94a3b8', marginBottom: '24px' }}>
      src/components/equipment3d/ · three.js 0.186 · 5 种彩层可独立开关 · 设备单台特征化
    </Text>

    <Box style={{ display: 'flex', gap: '16px', height: '420px' }}>
      {/* 左侧主视觉占位 — 描述框代替截图 */}
      <Box style={{
        flex: '1.5', padding: '24px', backgroundColor: '#0f172a', borderRadius: '8px',
        display: 'flex', flexDirection: 'column', justifyContent: 'center', alignItems: 'center',
      }}>
        <Box style={{
          width: '100%', height: '300px', backgroundColor: '#1e293b', borderRadius: '6px',
          display: 'flex', alignItems: 'center', justifyContent: 'center',
          border: '2px dashed #334155',
        }}>
          <Text style={{ fontSize: '16px', color: '#64748b' }}>
            〔第一人称漫游画面占位 · 演示时切换至实操〕
          </Text>
        </Box>
        <Text style={{ fontSize: '14px', color: '#94a3b8', marginTop: '16px' }}>
          WASD 移动 · 鼠标视角 · 点击设备查详情
        </Text>
      </Box>

      {/* 右侧 5 层彩层图例 */}
      <Box style={{ flex: '1', display: 'flex', flexDirection: 'column', gap: '10px' }}>
        <Text style={{ fontSize: '14px', color: '#06b6d4', letterSpacing: '1px', marginBottom: '4px' }}>
          5 种彩层 · 顶部图例可独立开关
        </Text>
        {[
          { name: '故障环', desc: '玫红脉冲 · 故障设备高亮', color: '#f43f5e', en: 'Fault Ring' },
          { name: '技师轨迹', desc: '青色虚线 · 在岗技师轨迹', color: '#06b6d4', en: 'Tech Track' },
          { name: '引导虚线', desc: '琥珀 · 视线引导', color: '#f59e0b', en: 'Guide Line' },
          { name: '介质粒子', desc: '绿色粒子 · 流体可视化', color: '#10b981', en: 'Medium Particles' },
          { name: '安全边界', desc: '紫色多边形 · 危险区', color: '#8b5cf6', en: 'Safety Boundary' },
        ].map((l, i) => (
          <Box key={i} style={{
            padding: '10px 14px', backgroundColor: '#0f172a', borderRadius: '4px',
            borderLeft: `3px solid ${l.color}`,
          }}>
            <Box style={{ display: 'flex', alignItems: 'center', marginBottom: '2px' }}>
              <Box style={{
                width: '12px', height: '12px', borderRadius: '50%',
                backgroundColor: l.color, marginRight: '8px',
              }} />
              <Text style={{ fontSize: '14px', color: '#e2e8f0', fontWeight: 'bold' }}>{l.name}</Text>
              <Text style={{ fontSize: '11px', color: '#64748b', marginLeft: '8px' }}>{l.en}</Text>
            </Box>
            <Text style={{ fontSize: '12px', color: '#94a3b8' }}>{l.desc}</Text>
          </Box>
        ))}
      </Box>
    </Box>

    <Box style={{ position: 'absolute', bottom: '20px', right: '56px' }}>
      <Text style={{ fontSize: '12px', color: '#475569' }}>08 / 12</Text>
    </Box>
  </Slide>