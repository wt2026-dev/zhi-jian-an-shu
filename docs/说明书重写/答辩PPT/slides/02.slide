<Slide style={{ width: '1280px', height: '720px', padding: '40px 56px', backgroundColor: '#0b1220' }}>
    <Box style={{ display: 'flex', alignItems: 'center', marginBottom: '40px' }}>
      <Text style={{ fontSize: '14px', color: '#06b6d4', letterSpacing: '3px' }}>CONTENTS</Text>
      <Box style={{ flex: 1, height: '1px', backgroundColor: '#1e293b', marginLeft: '20px' }} />
    </Box>

    <Text style={{
      fontSize: '48px', fontWeight: 'bold', color: '#e2e8f0',
      marginBottom: '48px',
    }}>
      <span style={{ color: '#06b6d4' }}>目录</span>
    </Text>

    <Box style={{ display: 'flex', flexWrap: 'wrap', gap: '20px', height: '440px' }}>
      {[
        { num: '01', title: '背景与痛点', sub: '传统维修的三大痛点', color: '#06b6d4' },
        { num: '02', title: '方案与架构', sub: '单进程双形态 + AI + RBAC', color: '#06b6d4' },
        { num: '03', title: '现场演示', sub: '报修 → 作业票 → AI → 数字人 → 闯关', color: '#f59e0b' },
        { num: '04', title: '差异化创新', sub: '跨 iframe 拖拽 / 单台特征化', color: '#f59e0b' },
        { num: '05', title: '总结与展望', sub: '关键数据 + 后续工作', color: '#06b6d4' },
      ].map((item, i) => (
        <Box key={i} style={{
          width: 'calc((100% - 60px) / 4)', padding: '28px',
          backgroundColor: '#0f172a', borderRadius: '8px',
          borderLeft: `3px solid ${item.color}`, minHeight: '180px',
        }}>
          <Text style={{ fontSize: '14px', color: item.color, letterSpacing: '2px', marginBottom: '12px' }}>
            {item.num}
          </Text>
          <Text style={{ fontSize: '26px', fontWeight: 'bold', color: '#e2e8f0', lineHeight: '1.3', marginBottom: '12px' }}>
            {item.title}
          </Text>
          <Text style={{ fontSize: '14px', color: '#94a3b8', lineHeight: '1.6' }}>
            {item.sub}
          </Text>
        </Box>
      ))}
    </Box>

    <Box style={{ position: 'absolute', bottom: '20px', right: '56px' }}>
      <Text style={{ fontSize: '12px', color: '#475569' }}>02 / 12</Text>
    </Box>
  </Slide>