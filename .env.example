# ==============================================================================
# 工业设备智能检修与作业协同系统 (Industrial Ops Maintenance System)
# 环境变量配置模版文件 (.env.example)
# 复制本文件为 .env 并填入实际敏感凭据：cp .env.example .env
# ==============================================================================

# 服务端口与运行环境
PORT=3000
NODE_ENV=development

# 认证与 JWT 密钥 (生产环境请务必修改为强随机字符串)
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# CORS 允许跨域源 (多个域名用英文逗号分隔)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://servicewechat.com

# 数据库连接 (默认使用嵌入式 PostgreSQL PGlite，亦可指定远程 Postgres 实例)
DATABASE_URL=pglite://./data/industrial_ops_pg

# 阿里云百炼 (DashScope) 大模型配置 (OpenAI 兼容模式，可选：未配置时 AI 功能友好降级)
DASHSCOPE_API_KEY=your_aliyun_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_VISION_MODEL=qwen-vl-max
# 知识库向量 RAG 使用的 embedding 模型（1024 维）；未配置 Key 时检索自动降级为关键词路径
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# ==================== AI 预算控制 (默认关闭，演示/测试环境行为零变化) ====================
# AI_BUDGET_ENABLED=true 时启用每日 token 预算限制；AI_DAILY_BUDGET 为每日上限（prompt+completion 合计）
AI_BUDGET_ENABLED=false
AI_DAILY_BUDGET=100000

# 日志输出级别 (trace | debug | info | warn | error | fatal | silent)
LOG_LEVEL=info

# ==================== 数据库类型切换 (P0-1) ====================
# pglite   开发/演示环境（嵌入式，零依赖，默认）
# postgres 生产环境（独立 PostgreSQL 服务，支持连接池）
DB_TYPE=pglite
# DB_TYPE=postgres 时以下配置生效（也可直接用 DATABASE_URL 指定完整连接串）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=industrial_maintenance
DB_USER=postgres
DB_PASSWORD=your_password_here
# 连接池上限（仅 postgres 模式）
DB_POOL_MAX=10

# ==================== 魔珐星云 3D 数字人配置 (服务端专用，严禁暴露前端) ====================
# 配置后自动启用 3D 渲染与对话语音驱动；缺失或加载失败自动优雅降级为 2D 仿真数字人
XINGYUN_APP_ID=
XINGYUN_APP_SECRET=

# ==================== 微信小程序配置 (服务端专用，严禁暴露前端) ====================
# 配置后用于生成设备专属小程序太阳码 (getwxacodeunlimit) 与小程序登录凭证 (code2session)；未配置时自动降级为 H5 扫码报修页
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ==================== 演示环境安全策略配置 ====================
# 首次登录强制改密开关（true 时登录成功将返回 forcePasswordChange 标记并弹出改密引导，默认 false）
DEMO_FORCE_PASSWORD_CHANGE=false




# ==================== 高德地图（就近调度大屏，前端 JS API 2.0） ====================
# Web端(JS API) Key：申请路径 lbs.amap.com → 控制台 → 应用管理 → 创建应用 → 添加 Key → 服务平台选 Web端(JS API)
# 域名白名单留空（不限域名，localhost 可直接使用）；留空时调度大屏自动降级为平面示意图（不白屏）
VITE_AMAP_KEY=

# ==================== Agnes AI 视频生成防护配置 ====================
# 功能总开关（默认关闭，演示/生产按需开启）
# AGNES_ENABLED=false
# 同时在途最大视频生成任务数（默认 1 = 严格串行）
# 别调大：实测两条并发时，后提交的约 4 分钟跑完、先提交的一直卡到 40 分钟窗口耗尽
# （远端 perf_infer_s=0，即推理一秒没跑，是被新任务挤掉了调度）。调大只会让先提交的更容易失败。
# AGNES_MAX_CONCURRENT=1
# 单段轮询窗口（分钟，默认 40）：慢段跑满这么久才判超时
# AGNES_SEGMENT_WINDOW_MIN=40
# 段间强制等待（秒，默认 65）：Agnes 生成限频约 1 次/分钟
# AGNES_SEGMENT_GAP_SEC=65
# 全局超时下限（分钟，默认 240）。实际生效值 = max(此值, 段数 × 单段窗口 + 段间等待)，
# 所以 8 段规程会自动放宽到约 330 分钟，不会出现"单段还没到自己的上限、整个任务先超时"。
# AGNES_TOTAL_TIMEOUT_MIN=240
# 产物大小上限（MiB，默认 9）：工作区会静默删除 ≥10MiB 的文件，分段与成片都会自动压到这个值以下
# AGNES_ARTIFACT_MAX_MB=9
# 视频下载域名单词白名单（逗号分隔，留空则仅做协议+内网校验）
# AGNES_DOWNLOAD_HOST_WHITELIST=
# 上传/产物根目录（绝对路径）。默认 <项目>/public/uploads。
# 想彻底躲开工作区的大文件清理，可指向工作区外的目录，例如 D:/agnes-artifacts/uploads
# UPLOADS_DIR=
# 中文标题/字幕烧录字体（留空则按平台常见路径自动探测，如 Windows 微软雅黑 msyhbd.ttc）
# Agnes 无法渲染可读中文，标题与字幕统一由 FFmpeg 烧录；探测不到字体时仅跳过烧录，不会使任务失败
# AGNES_TITLE_FONT=C:/Windows/Fonts/msyhbd.ttc
# ==================== 中文配音（TTS） ====================
# Agnes 只会输出工业环境音、**不会**合成中文语音（prompt 写明 Chinese male voiceover 也没用，
# 频谱上无语音共振峰）。口播需用 edge-tts 另外合成再混入，故默认关闭，开启需本机 Python 装好 edge-tts：
#   pip install edge-tts
# 开启后成片 = 环境音床(压低) + 中文男声口播；合成失败只会让成片没有配音，不会让任务失败
# AGNES_TTS_ENABLED=1
# 音色（默认 zh-CN-YunxiNeural 云希·男声）
# AGNES_TTS_VOICE=zh-CN-YunxiNeural
# Python 解释器（需已装 edge-tts）。留空则按 托管 venv → PATH 顺序探测
# AGNES_TTS_PYTHON=C:/Users/26783/.workbuddy-ai/binaries/python/envs/default/Scripts/python.exe
# 人声响度目标（LUFS）。edge-tts 干声仅约 -25.9 LUFS，比环境音还低，必须按感知响度归一
# AGNES_TTS_LUFS=-16
# 环境音床音量（默认 0.30）
# AGNES_AMBIENT_VOL=0.30
