# ==============================================================================
# 工业设备智能检修与作业协同系统 (Industrial Ops Maintenance System)
# 环境变量配置模版文件 (.env.example)
# 复制本文件为 .env 并填入实际敏感凭据：cp .env.example .env
# ==============================================================================

# 服务端口与运行环境
PORT=3000
NODE_ENV=development

# 认证与 JWT 密钥 (生产环境请务必修改为强随机字符串)
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# CORS 允许跨域源 (多个域名用英文逗号分隔)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# 数据库连接 (默认使用嵌入式 PostgreSQL PGlite，亦可指定远程 Postgres 实例)
DATABASE_URL=pglite://./data/industrial_ops_pg

# 阿里云百炼 (DashScope) 大模型配置 (OpenAI 兼容模式，可选：未配置时 AI 功能友好降级)
DASHSCOPE_API_KEY=your_aliyun_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_VISION_MODEL=qwen-vl-max
# 知识库向量 RAG 使用的 embedding 模型（1024 维）；未配置 Key 时检索自动降级为关键词路径
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# ==================== AI 预算控制 (默认关闭，演示/测试环境行为零变化) ====================
# AI_BUDGET_ENABLED=true 时启用每日 token 预算限制；AI_DAILY_BUDGET 为每日上限（prompt+completion 合计）
AI_BUDGET_ENABLED=false
AI_DAILY_BUDGET=100000

# 日志输出级别 (trace | debug | info | warn | error | fatal | silent)
LOG_LEVEL=info

# ==================== 数据库类型切换 (P0-1) ====================
# pglite   开发/演示环境（嵌入式，零依赖，默认）
# postgres 生产环境（独立 PostgreSQL 服务，支持连接池）
DB_TYPE=pglite
# DB_TYPE=postgres 时以下配置生效（也可直接用 DATABASE_URL 指定完整连接串）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=industrial_maintenance
DB_USER=postgres
DB_PASSWORD=your_password_here
# 连接池上限（仅 postgres 模式）
DB_POOL_MAX=10

# ==================== 魔珐星云 3D 数字人配置 (服务端专用，严禁暴露前端) ====================
# 配置后自动启用 3D 渲染与对话语音驱动；缺失或加载失败自动优雅降级为 2D 仿真数字人
XINGYUN_APP_ID=
XINGYUN_APP_SECRET=

# ==================== 微信小程序配置 (服务端专用，严禁暴露前端) ====================
# 配置后用于生成设备专属小程序太阳码 (getwxacodeunlimit) 与小程序登录凭证 (code2session)；未配置时自动降级为 H5 扫码报修页
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ==================== 演示环境安全策略配置 ====================
# 首次登录强制改密开关（true 时登录成功将返回 forcePasswordChange 标记并弹出改密引导，默认 false）
DEMO_FORCE_PASSWORD_CHANGE=false




# ==================== 高德地图（就近调度大屏，前端 JS API 2.0） ====================
# Web端(JS API) Key：申请路径 lbs.amap.com → 控制台 → 应用管理 → 创建应用 → 添加 Key → 服务平台选 Web端(JS API)
# 域名白名单留空（不限域名，localhost 可直接使用）；留空时调度大屏自动降级为平面示意图（不白屏）
VITE_AMAP_KEY=

# ==================== Agnes AI 视频生成防护配置 ====================
# 功能总开关（默认关闭，演示/生产按需开启）
# AGNES_ENABLED=false
# 同时在途最大视频生成任务数（默认 2）
# AGNES_MAX_CONCURRENT=2
# 全局超时（分钟），超时终止任务（默认 60）
# AGNES_TOTAL_TIMEOUT_MIN=60
# 视频下载域名单词白名单（逗号分隔，留空则仅做协议+内网校验）
# AGNES_DOWNLOAD_HOST_WHITELIST=
